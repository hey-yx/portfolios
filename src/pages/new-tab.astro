---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  ArrowUpRight,
  Check,
  ChevronDown,
  ChevronUp,
  Dices,
  EllipsisVertical,
  GripVertical,
  Image as ImageIcon,
  Info,
  Layers,
  LayoutGrid,
  PencilLine,
  Plus,
  Spline,
  Search,
  Settings,
  Trash2,
  X,
} from "lucide-astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  newTabConfig,
  newTabSearchEngines,
  newTabShortcutGroups,
} from "../data/new-tab-shortcuts";

const defaultNewTabPayload = {
  config: newTabConfig,
  searchEngines: newTabSearchEngines,
  shortcutGroups: newTabShortcutGroups,
};

const serializedDefaultNewTabPayload = JSON.stringify(defaultNewTabPayload).replace(/</g, "\\u003c");
---

<BaseLayout
  title={newTabConfig.title}
  description={newTabConfig.description}
  includeSidebar={false}
  showHeader={false}
  showFooter={false}
  showFloatingThemeToggle={false}
>
  {/* 标签栏双语：服务端只能输出一份中文，客户端按浏览器语言覆盖 <title> 与 description，
      页面正文不翻译。ClientRouter 换页会重写 head，所以换页后再执行一次。 */}
  <script
    is:inline
    define:vars={{ tabTitleEn: newTabConfig.titleEn, tabDescriptionEn: newTabConfig.descriptionEn }}
  >
    (() => {
      const applyTabLanguage = () => {
        let language = "";
        try {
          language = (navigator.languages?.[0] || navigator.language || "").toLowerCase();
        } catch {
          language = "";
        }

        // 读不到语言，或者中文环境：保留服务端那份，不往英文猜
        if (!language || language.startsWith("zh")) {
          return;
        }

        const setMetaContent = (selector, value) => {
          document.querySelectorAll(selector).forEach((node) => node.setAttribute("content", value));
        };

        document.title = tabTitleEn;
        setMetaContent('meta[name="title"]', tabTitleEn);
        setMetaContent('meta[property="og:title"]', tabTitleEn);
        setMetaContent('meta[name="description"]', tabDescriptionEn);
        setMetaContent('meta[property="og:description"]', tabDescriptionEn);
      };

      applyTabLanguage();
      document.addEventListener("astro:after-swap", applyTabLanguage);
    })();
  </script>

  {/* 布局与页面尺寸存在 localStorage、服务端不知道：入场动画要不要为弧形档降级、
      页面宽度与字号缩放取几成，都必须在 shell 首次渲染前定下来，所以这里内联读一次，
      把判据挂到 html 上（CSS 见样式块）。 */}
  <script
    is:inline
    set:html={`(() => {
  try {
    const stored = JSON.parse(window.localStorage.getItem(${JSON.stringify(newTabConfig.storageKey)}) ?? "null");
    const root = document.documentElement;
    const storedLayout = stored?.shortcutLayout;
    if (storedLayout) {
      root.dataset.newTabLayout = storedLayout;
    }
    const storedWidth = Number(stored?.pageWidth);
    if (Number.isFinite(storedWidth) && storedWidth >= 896 && storedWidth <= 1920) {
      root.style.setProperty("--ntab-page-width", Math.round(storedWidth) + "px");
    }
    const storedScale = Number(stored?.uiScale);
    if (Number.isFinite(storedScale) && storedScale >= 85 && storedScale <= 130) {
      root.style.setProperty("--ntab-ui-scale", String(storedScale / 100));
    }
    const storedFont = stored?.fontFamily;
    if (typeof storedFont === "string" && ["default", "serif", "kai", "rounded", "mono"].includes(storedFont) && storedFont !== "default") {
      root.dataset.newTabFont = storedFont;
    }
    const storedBlur = stored?.itemBlur;
    if (typeof storedBlur === "string" && ["off", "soft", "medium", "strong", "dynamic"].includes(storedBlur)) {
      root.dataset.newTabBlur = storedBlur;
    }
  } catch {
    // 读不到就按默认网格与默认尺寸处理
  }
})();`}
  />

  {/* 背景层挂 shell 外：shell 入场要整体缩放，fixed 元素留在里面会被拽进包含块。
      外面这层 isolate 容器兜住负 z-index，否则会被 body 的不透明背景色盖住。 */}
  <div class="pointer-events-none fixed inset-0 isolate z-0" aria-hidden="true" data-new-tab-background-host>
    <div
      class="pointer-events-none absolute inset-0 z-[-20] hidden bg-base-100"
      aria-hidden="true"
      data-new-tab-background-base
    ></div>
    <div
      class="pointer-events-none absolute inset-0 -z-10 hidden bg-center bg-cover bg-no-repeat opacity-0 transition-opacity duration-200"
      aria-hidden="true"
      data-new-tab-background-layer
    ></div>
  </div>

  <section
    class="new-tab-shell relative isolate z-10 mx-auto"
    aria-labelledby="new-tab-title"
    data-new-tab-page
    data-booting="true"
  >
    <h1 id="new-tab-title" class="sr-only">{newTabConfig.heading}</h1>

    <header class="new-tab-masthead">
      <div class="new-tab-greeting-block">
        <p
          class="new-tab-greeting m-0"
          data-new-tab-greeting
          data-new-tab-color-target="navigation"
        ></p>
        <p
          class="new-tab-date m-0"
          data-new-tab-date
          data-new-tab-color-target="navigation"
        ></p>
      </div>

      <details class="new-tab-tools" data-tools-menu>
        <summary
          class="new-tab-btn new-tab-btn--ghost new-tab-tools__trigger"
          aria-label="更多工具"
          title="更多工具"
          data-new-tab-color-target="navigation"
        >
          <EllipsisVertical aria-hidden="true" />
          <span class="new-tab-tools__label">更多</span>
        </summary>
        <div class="new-tab-tools__panel">
          <div class="new-tab-actions">
        <ThemeToggle
          mobile={false}
          triggerClass="new-tab-btn"
          colorTarget="navigation"
        />

        <div class="new-tab-submenu-group" data-wallpaper-group>
          <button
            class="new-tab-btn new-tab-btn--ghost"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            data-wallpaper-trigger
            data-new-tab-color-target="navigation"
          >
            <ImageIcon aria-hidden="true" />
            <span>壁纸</span>
            <ChevronDown class="new-tab-submenu__chevron" aria-hidden="true" />
          </button>
          <div class="new-tab-submenu" data-wallpaper-menu hidden role="menu" aria-label="壁纸">
            <button class="new-tab-submenu__item" type="button" role="menuitemradio" aria-checked="false" data-wallpaper-source="bing">
              <span class="new-tab-submenu__dot" aria-hidden="true"></span>
              <span>必应每日</span>
            </button>
            <button class="new-tab-submenu__item" type="button" role="menuitemradio" aria-checked="false" data-wallpaper-source="custom">
              <span class="new-tab-submenu__dot" aria-hidden="true"></span>
              <span>自定义图片</span>
            </button>
            <button class="new-tab-submenu__item new-tab-submenu__item--action" type="button" data-wallpaper-shuffle-menu hidden>
              <span class="new-tab-submenu__dot new-tab-submenu__dot--none" aria-hidden="true"></span>
              <span>换一张</span>
            </button>
          </div>
        </div>

        <button
          class="new-tab-btn new-tab-btn--ghost"
          type="button"
          data-shortcut-add
          data-new-tab-color-target="navigation"
        >
          <Plus aria-hidden="true" />
          <span>{newTabConfig.settings.addShortcutLabel}</span>
        </button>

        <button
          class="new-tab-btn new-tab-btn--outline"
          type="button"
          data-config-open
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="new-tab-config-panel"
          data-new-tab-color-target="navigation"
        >
          <Settings aria-hidden="true" />
          <span>{newTabConfig.settings.openLabel}</span>
        </button>

          </div>
        </div>
      </details>
    </header>

    <div class="new-tab-search-row">
      <form
        class="new-tab-search"
        role="search"
        data-new-tab-search
      >
        <label class="sr-only" for="new-tab-query">搜索关键词</label>
        <span class="new-tab-search__icon" aria-hidden="true">
          <Search />
        </span>
        <input
          id="new-tab-query"
          class="new-tab-search__input"
          type="search"
          name="q"
          autocomplete="off"
          placeholder={newTabConfig.search.placeholder}
          data-search-query
        />
        <button
          class="new-tab-search__submit"
          type="submit"
          aria-label={newTabConfig.search.submitLabel}
          title={newTabConfig.search.submitLabel}
        >
          <span class="new-tab-search__submit-label">{newTabConfig.search.submitLabel}</span>
        </button>
      </form>
      <p class="new-tab-search-hint">
        按 Enter 搜索 · <span data-search-engine-label>Google</span>
      </p>
    </div>

    <section class="new-tab-board" aria-label="快捷网站">
      <div class="shortcut-stack" aria-label="快捷网站" data-shortcut-stack></div>
      <button
        class="new-tab-group-add"
        type="button"
        data-group-add
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <Plus aria-hidden="true" />
        <span>{newTabConfig.settings.addGroupLabel}</span>
      </button>
    </section>
  </section>

  {/* 恢复按钮同样移出 shell：它是 fixed，留在里面会被 shell 的入场缩放当成包含块。 */}
  <button
    class="new-tab-restore btn btn-square btn-sm fixed right-4 top-4 z-[70] h-8 min-h-8 w-8 border border-base-content/15 bg-base-100/85 p-0 text-ink-2 shadow-[0_6px_20px_rgba(0,0,0,0.10)] backdrop-blur hover:text-base-content [&_svg]:h-4 [&_svg]:w-4"
    type="button"
    aria-label="展开问候与搜索"
    title="展开问候与搜索（按 / 唤回搜索）"
    data-header-restore
  >
    <ChevronUp aria-hidden="true" />
  </button>

  <div class="new-tab-toast" role="status" aria-live="polite" data-new-tab-toast hidden></div>

  {/* 两个抽屉共用一套开合规则：data-open 是唯一开关。
      进出都走同一条 transition——进场 translate-x-full → 0，出场 0 → translate-x-full，
      allow-discrete 让 hidden 也能参与过渡，JS 不再需要 setTimeout 兜底延迟隐藏。 */}
  <div id="new-tab-config-panel" class="new-tab-config fixed inset-0 z-[80] hidden opacity-0 transition-opacity duration-200 [transition-behavior:allow-discrete] [&:not([data-open])]:pointer-events-none" data-config-drawer>
    <button class="new-tab-config__backdrop absolute inset-0 border-0 bg-base-content/20 opacity-0 transition-opacity duration-200" type="button" aria-label={newTabConfig.settings.closeLabel} data-config-close></button>
    <aside class="new-tab-config__sheet absolute right-0 top-0 grid h-dvh w-[min(100vw,31rem)] max-sm:w-[min(100vw,24rem)] rounded-l-2xl border-l border-base-content/10 bg-base-100/95 shadow-[-1px_0_2px_-1px_rgba(15,23,42,0.08),-8px_0_16px_-8px_rgba(15,23,42,0.10),-20px_0_40px_-20px_rgba(15,23,42,0.14)] grid-rows-[auto_minmax(0,1fr)_auto] backdrop-blur-sm translate-x-full transition-transform duration-[280ms] ease-[cubic-bezier(0.22,1,0.36,1)]" aria-label={newTabConfig.settings.panelTitle} aria-modal="true" role="dialog">
      <div class="new-tab-config__header flex items-center justify-between gap-3 border-b border-base-content/10 p-4">
        <div class="min-w-0">
          <h2 class="m-0 text-[0.95rem] font-bold leading-tight">{newTabConfig.settings.panelTitle}</h2>
          <p class="mt-1 text-xs leading-snug text-ink-2" data-config-status>{newTabConfig.settings.statusReady}</p>
        </div>
        <button class="btn btn-square btn-ghost btn-sm" type="button" aria-label={newTabConfig.settings.closeLabel} data-config-close>
          <X class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <div class="new-tab-config__body grid content-start gap-4 overflow-y-auto p-4">
        <section class="new-tab-config__section grid gap-3">
          <div class="new-tab-config__section-title text-xs font-semibold tracking-[0.12em] text-ink-2">{newTabConfig.settings.generalLabel}</div>
          <div class="new-tab-config__grid grid grid-cols-2 gap-3 max-sm:grid-cols-1">
            <label class="form-control grid min-w-0 gap-1.5">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.nameLabel}</span>
              </span>
              <input class="input input-bordered input-sm" type="text" autocomplete="off" data-config-name />
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.shortcutOpenModeLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-shortcut-open-mode>
                <option value="current">{newTabConfig.settings.shortcutOpenModeCurrentLabel}</option>
                <option value="newTab">{newTabConfig.settings.shortcutOpenModeNewTabLabel}</option>
              </select>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.searchEngineLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-search-engine></select>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.pageWidthLabel}</span>
                <span class="label-text-alt" data-config-page-width-value></span>
              </span>
              <input
                class="range range-xs"
                type="range"
                min="896"
                max="1920"
                step="16"
                data-config-page-width
              />
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.uiScaleLabel}</span>
                <span class="label-text-alt" data-config-ui-scale-value></span>
              </span>
              <input
                class="range range-xs"
                type="range"
                min="85"
                max="130"
                step="5"
                data-config-ui-scale
              />
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.fontFamilyLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-font-family>
                <option value="default">{newTabConfig.settings.fontFamilyDefaultLabel}</option>
                <option value="serif">{newTabConfig.settings.fontFamilySerifLabel}</option>
                <option value="kai">{newTabConfig.settings.fontFamilyKaiLabel}</option>
                <option value="rounded">{newTabConfig.settings.fontFamilyRoundedLabel}</option>
                <option value="mono">{newTabConfig.settings.fontFamilyMonoLabel}</option>
              </select>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.blurLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-blur>
                <option value="off">{newTabConfig.settings.blurOffLabel}</option>
                <option value="soft">{newTabConfig.settings.blurSoftLabel}</option>
                <option value="medium">{newTabConfig.settings.blurMediumLabel}</option>
                <option value="strong">{newTabConfig.settings.blurStrongLabel}</option>
                <option value="dynamic">{newTabConfig.settings.blurDynamicLabel}</option>
              </select>
            </label>
          </div>
        </section>

        <section class="new-tab-config__section grid gap-3">
          <div class="new-tab-config__section-title text-xs font-semibold tracking-[0.12em] text-ink-2">壁纸</div>
          <div class="new-tab-config__grid grid grid-cols-2 gap-3 max-sm:grid-cols-1">
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">每行显示几个</span>
              </span>
              <select class="select select-bordered select-sm" data-config-group-columns>
                <option value="2">2 个</option>
                <option value="3">3 个</option>
                <option value="4">4 个</option>
              </select>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">壁纸来源</span>
              </span>
              <div class="flex min-w-0 items-center gap-2">
                <select class="select select-bordered select-sm flex-1" data-config-background-source>
                  <option value="custom">自定义图片</option>
                  <option value="bing">必应每日壁纸</option>
                </select>
                <button class="btn btn-outline btn-sm" type="button" data-wallpaper-shuffle>换一张</button>
              </div>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full" data-wallpaper-custom>
              <span class="label">
                <span class="label-text">{newTabConfig.settings.backgroundUrlLabel}</span>
              </span>
              <input
                class="input input-bordered input-sm"
                type="url"
                placeholder={newTabConfig.settings.backgroundPlaceholder}
                data-config-background
              />
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full" data-wallpaper-custom>
              <span class="label">
                <span class="label-text">{newTabConfig.settings.backgroundFileLabel}</span>
              </span>
              <div class="new-tab-config-upload flex min-w-0 items-center gap-2">
                <input hidden type="file" accept="image/*" data-config-background-file />
                <button class="btn btn-outline btn-sm" type="button" data-config-background-file-trigger>
                  {newTabConfig.settings.backgroundFileLabel}
                </button>
                <span class="truncate text-[0.78rem] leading-snug text-ink-2" data-config-background-status>{newTabConfig.settings.backgroundEmptyLabel}</span>
              </div>
            </label>
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.backgroundOpacityLabel}</span>
                <span class="label-text-alt" data-config-background-opacity-value></span>
              </span>
              <input
                class="range range-xs"
                type="range"
                min="0"
                max="100"
                step="1"
                data-config-background-opacity
              />
            </label>
          </div>
        </section>

        <section class="new-tab-config__section grid gap-3">
          <div class="new-tab-config__section-title text-xs font-semibold tracking-[0.12em] text-ink-2">
            {newTabConfig.settings.textColorLabel}
          </div>
          <div class="new-tab-config__grid grid grid-cols-2 gap-3 max-sm:grid-cols-1">
            <label class="form-control grid min-w-0 gap-1.5 col-span-full">
              <span class="label">
                <span class="label-text">{newTabConfig.settings.textColorModeLabel}</span>
              </span>
              <select class="select select-bordered select-sm" data-config-text-color-mode>
                <option value="default">{newTabConfig.settings.textColorDefaultLabel}</option>
                <option value="light">{newTabConfig.settings.textColorLightLabel}</option>
                <option value="dark">{newTabConfig.settings.textColorDarkLabel}</option>
              </select>
            </label>
          </div>
        </section>

      </div>

      <div class="new-tab-config__footer flex flex-wrap items-center justify-start gap-3 border-t border-base-content/10 p-4">
        <input
          hidden
          type="file"
          accept="application/json,.json"
          aria-label={newTabConfig.settings.fileLabel}
          data-config-file
        />
        <button class="btn btn-sm btn-outline" type="button" data-config-import>
          {newTabConfig.settings.importLabel}
        </button>
        <button class="btn btn-sm btn-outline" type="button" data-config-export>
          {newTabConfig.settings.exportLabel}
        </button>
        <button class="btn btn-sm btn-ghost" type="button" data-config-clear-background>
          {newTabConfig.settings.clearBackgroundLabel}
        </button>
        <button class="btn btn-sm btn-ghost" type="button" data-config-reset>
          {newTabConfig.settings.resetLabel}
        </button>
        <button
          class="new-tab-config__notes-link"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-notes-open
        >
          {newTabConfig.settings.notesLabel}
        </button>
      </div>
    </aside>
  </div>

  {/* 图标与数据说明抽屉：讲清数据存在哪、图标怎么来、缓存怎么清——都是用户遇到
     「图标不出来/数据丢了」时真正需要的那几句话，顺带把清理指令写成能直接粘贴的。 */}
  <div class="new-tab-notes fixed inset-0 z-[85] hidden opacity-0 transition-opacity duration-200 [transition-behavior:allow-discrete] [&:not([data-open])]:pointer-events-none" data-notes-panel>
    <button class="new-tab-notes__backdrop absolute inset-0 border-0 bg-base-content/20 opacity-0 transition-opacity duration-200" type="button" aria-label={newTabConfig.settings.notesPanelTitle} data-notes-close></button>
    <aside class="new-tab-notes__sheet absolute right-0 top-0 grid h-dvh w-[min(100vw,31rem)] max-sm:w-[min(100vw,24rem)] rounded-l-2xl border-l border-base-content/10 bg-base-100/95 shadow-[-1px_0_2px_-1px_rgba(15,23,42,0.08),-8px_0_16px_-8px_rgba(15,23,42,0.10),-20px_0_40px_-20px_rgba(15,23,42,0.14)] grid-rows-[auto_minmax(0,1fr)_auto] backdrop-blur-sm transition-transform duration-[280ms] ease-[cubic-bezier(0.22,1,0.36,1)]" role="dialog" aria-modal="true" aria-label={newTabConfig.settings.notesPanelTitle}>
      <div class="new-tab-notes__header flex items-center justify-between gap-3 border-b border-base-content/10 p-4">
        <div class="flex min-w-0 items-center gap-2.5">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-base-content/[0.06] text-ink-3 [&_svg]:h-4 [&_svg]:w-4">
            <Info aria-hidden="true" />
          </span>
          <h2 class="m-0 text-[0.95rem] font-bold leading-tight">{newTabConfig.settings.notesPanelTitle}</h2>
        </div>
        <button class="btn btn-square btn-ghost btn-sm" type="button" aria-label={newTabConfig.settings.closeLabel} data-notes-close>
          <X class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>

      <div class="new-tab-notes__body grid content-start gap-5 overflow-y-auto p-4 text-[0.8rem] leading-relaxed text-ink-2">
        <section class="grid gap-1.5">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesLocalTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesLocalBody}</p>
        </section>

        <section class="grid gap-1.5">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesLogoTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesLogoBody}</p>
        </section>

        <section class="grid gap-1.5">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesLogoCacheTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesLogoCacheBody}</p>
        </section>

        <section class="grid gap-2">
          <h3 class="m-0 text-[0.82rem] font-semibold text-base-content">{newTabConfig.settings.notesRecoveryTitle}</h3>
          <p class="m-0">{newTabConfig.settings.notesRecoveryBody}</p>
          <p class="m-0 text-[0.72rem] leading-snug text-ink-2">{newTabConfig.settings.notesCommandLabel}</p>
          <pre class="new-tab-notes__code m-0 overflow-x-auto rounded-lg border border-base-content/10 bg-base-200/40 p-3 text-[0.72rem] leading-relaxed" data-notes-command></pre>
        </section>
      </div>
    </aside>
  </div>

  <template data-new-tab-icon="check">
    <Check class="h-3.5 w-3.5" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="close">
    <X class="h-3.5 w-3.5" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="drag">
    <GripVertical class="h-3.5 w-3.5" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="more">
    <EllipsisVertical class="h-4 w-4" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="edit">
    <PencilLine class="h-4 w-4" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="plus">
    <Plus class="h-4 w-4" aria-hidden="true" />
  </template>
  <template data-new-tab-icon="trash">
    <Trash2 class="h-3.5 w-3.5" aria-hidden="true" />
  </template>

  <script is:inline type="application/json" id="new-tab-defaults" set:html={serializedDefaultNewTabPayload} />

  <style is:inline>
    /* Hallmark · macrostructure: Index-First (launcher surface) · tone: quiet utilitarian · anchor hue: Tencent Blue
       UISpecs 基准规范：TDesign。取值记录见 docs/设计取值记录.md，缺口见 docs/设计缺口.md。 */

    /* new-tab 是单屏工具页，不走 BaseLayout 的阅读宽度：main 的 max-w-5xl 会把 shell
       自己的 70rem 卡回 928px，lg:px-12 又会再吃掉左右各 48px。 */
    main:has([data-new-tab-page]) {
      padding: 0;
      max-width: 100%;
    }

    /* 尺寸与动效 token 放 :root：配置/说明抽屉在 shell 之外，也要拿到同一套值。
       只有颜色类 token 跟随 shell 的文本颜色模式。 */
    :root {
      --ntab-radius-control: 0.375rem;
      --ntab-radius-card: 8px;
      --ntab-radius-panel: var(--radius-panel);
      --ntab-duration-fast: 200ms;
      --ntab-duration-base: 240ms;
      --ntab-duration-slow: 280ms;
      --ntab-ease-standard: cubic-bezier(0.38, 0, 0.24, 1);
      --ntab-ease-enter: cubic-bezier(0, 0, 0.15, 1);
      --ntab-ease-exit: cubic-bezier(0.82, 0, 1, 0.9);
      /* 页面宽度与字号缩放：配置抽屉里可调，首帧由内联脚本先落一次，避免刷新闪动。 */
      --ntab-page-width: 992px;
      --ntab-ui-scale: 1;
    }

    /* 字体档：只在本页（html 上的 data-new-tab-font）覆盖两个字体变量，
       正文与问候语一起换，避免出现标题和正文各用一套字体的割裂感。 */
    html[data-new-tab-font="serif"] {
      --font-sans: "Songti SC", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", "SimSun", Georgia, serif;
      --font-reading: "Songti SC", "Noto Serif SC", "Noto Serif CJK SC", "Source Han Serif SC", "STSong", "SimSun", Georgia, serif;
    }

    html[data-new-tab-font="kai"] {
      --font-sans: "Kaiti SC", "STKaiti", "KaiTi", "BiauKai", "Noto Serif CJK SC", serif;
      --font-reading: "Kaiti SC", "STKaiti", "KaiTi", "BiauKai", "Noto Serif CJK SC", serif;
    }

    html[data-new-tab-font="rounded"] {
      --font-sans: ui-rounded, "Yuanti SC", "Hiragino Maru Gothic ProN", "PingFang SC", "Microsoft YaHei", sans-serif;
      --font-reading: ui-rounded, "Yuanti SC", "Hiragino Maru Gothic ProN", "PingFang SC", "Microsoft YaHei", sans-serif;
    }

    html[data-new-tab-font="mono"] {
      --font-sans: var(--font-mono);
      --font-reading: var(--font-mono);
    }

    /* 卡片模糊档：0/4/10/16px，「动态」随壁纸透明度变化（低透明度配轻模糊，高透明度配强模糊）。
       只在有壁纸时生效，规则见下方 data-new-tab-background 块。 */
    html[data-new-tab-blur="off"] {
      --ntab-item-blur: 0px;
    }

    html[data-new-tab-blur="soft"] {
      --ntab-item-blur: 4px;
    }

    html[data-new-tab-blur="medium"] {
      --ntab-item-blur: 10px;
    }

    html[data-new-tab-blur="strong"] {
      --ntab-item-blur: 16px;
    }

    [data-new-tab-page] {
      /* 跟全站同一套墨色，不引入组件库品牌色。 */
      --ntab-accent: var(--ink-1);
      --ntab-focus: var(--ink-1);
      --ntab-line-strong: color-mix(in srgb, var(--ink-1) 26%, transparent);
      --ntab-card-bg: color-mix(in srgb, var(--ink-1) 6%, var(--surface-1));
      --ntab-card-border: transparent;
      --ntab-card-ink: var(--ink-1);
      --ntab-card-ink-2: var(--ink-2);
      --ntab-card-label-shadow: none;
    }

    [data-theme="black"] [data-new-tab-page] {
      --ntab-accent: var(--ink-1);
      --ntab-focus: var(--ink-1);
    }

    /* ── 工具入口：所有管理动作收进一个「…」面板 ───────────────────── */
    .new-tab-tools {
      position: relative;
      flex: none;
      margin-left: auto;
    }

    .new-tab-tools__trigger {
      width: auto;
      list-style: none;
      cursor: pointer;
    }

    .new-tab-tools__label {
      font: 500 12px/20px var(--font-sans);
    }

    .new-tab-tools__trigger::-webkit-details-marker {
      display: none;
    }

    .new-tab-tools__trigger::marker {
      content: "";
    }

    .new-tab-tools__trigger:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    .new-tab-tools:not([open]) .new-tab-tools__panel {
      display: none;
    }

    .new-tab-tools__panel {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 60;
      width: 15rem;
      padding: 6px;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-panel);
      background: var(--surface-1);
      box-shadow: var(--shadow-pop);
    }

    .new-tab-tools__panel .new-tab-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      width: 100%;
      max-height: none;
      transition: none;
    }

    .new-tab-tools__panel .new-tab-btn,
    .new-tab-tools__panel .new-tab-actions .btn,
    .new-tab-tools__panel [data-home-link] {
      justify-content: flex-start;
      width: 100%;
      height: 34px;
      min-height: 34px;
      padding: 0 9px;
      border-color: transparent;
      text-align: left;
    }

    .new-tab-tools__panel .new-tab-layout,
    .new-tab-tools__panel .theme-switcher {
      grid-column: 1 / -1;
      justify-self: stretch;
      width: 100%;
    }

    .new-tab-tools__panel .new-tab-actions .btn:hover,
    .new-tab-tools__panel .new-tab-btn:hover,
    .new-tab-tools__panel [data-home-link]:hover {
      background: color-mix(in srgb, var(--ink-1) 6%, transparent);
    }

    @media (max-width: 767px) {
      .new-tab-tools {
        align-self: flex-end;
      }

      .new-tab-tools__trigger {
        width: 30px;
        padding: 0;
      }

      .new-tab-tools__label {
        display: none;
      }

      .new-tab-tools__panel {
        right: 0;
        width: min(15rem, calc(100vw - 32px));
      }
    }

    /* 页面骨架：问候、搜索、快捷区三段纵向排。首屏整页缩放上浮入场；
       弧形档在下方单独降级，避免固定坞被 transform 当成包含块。 */
    [data-new-tab-page].new-tab-shell {
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding: clamp(2rem, 9vh, 5.5rem) 24px 3rem;
      /* 宽度按未缩放像素算，除以缩放倍率后视觉宽度与设置值一致。 */
      width: min(100%, calc(var(--ntab-page-width) / var(--ntab-ui-scale)));
      zoom: var(--ntab-ui-scale);
    }

    /* 背景入场：600ms 淡入 + 1.02 → 1 的轻缩放，只影响壁纸宿主 */
    [data-new-tab-background-host] {
      animation: ntab-bg-in 600ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
      transform-origin: 50% 45%;
    }

    @keyframes ntab-bg-in {
      from {
        opacity: 0;
        transform: scale(1.02);
      }
    }

    @keyframes ntab-rise {
      from {
        opacity: 0;
        transform: translateY(0.7rem);
      }
    }

    @keyframes ntab-dock-in {
      from {
        opacity: 0;
        transform: translateY(1.4rem);
      }
    }

    /* ── 问候与工具行 ─────────────────────────────────────────────── */
    .new-tab-masthead {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      min-width: 0;
      max-height: 12rem;
      transition:
        opacity var(--ntab-duration-fast) ease,
        transform var(--ntab-duration-base) var(--ntab-ease-standard),
        max-height var(--ntab-duration-base) var(--ntab-ease-standard);
    }

    .new-tab-greeting-block {
      display: grid;
      min-width: 0;
      gap: 4px;
      max-height: 6rem;
      transition:
        opacity var(--ntab-duration-fast) ease,
        transform var(--ntab-duration-base) var(--ntab-ease-standard),
        max-height var(--ntab-duration-base) var(--ntab-ease-standard);
    }

    .new-tab-greeting {
      color: var(--ink-1);
      font: 400 clamp(1.45rem, 3vw, 1.9rem) / 1.18 var(--font-reading);
      letter-spacing: -0.015em;
      overflow-wrap: anywhere;
    }

    .new-tab-date {
      color: var(--ink-2);
      font: 500 0.82rem / 1.4 var(--font-sans);
      letter-spacing: 0.01em;
      font-variant-numeric: tabular-nums;
    }

    .new-tab-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      min-width: 0;
      max-height: 10rem;
      transition:
        opacity 300ms ease,
        transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
        max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0s;
    }

    /* 工具行沿用项目的低对比按钮：30px 高、2px 圆角、默认无描边。 */
    [data-new-tab-page] .new-tab-btn,
    [data-new-tab-page] .new-tab-actions .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      height: 30px;
      min-height: 30px;
      padding: 0 8px;
      border: 1px solid transparent;
      border-radius: var(--ntab-radius-control);
      background: transparent;
      color: color-mix(in srgb, var(--ink-1) 62%, transparent);
      font: 500 13px/20px var(--font-sans);
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition:
        background-color var(--ntab-duration-fast) var(--ntab-ease-standard),
        border-color var(--ntab-duration-fast) var(--ntab-ease-standard),
        color var(--ntab-duration-fast) var(--ntab-ease-standard);
    }

    [data-new-tab-page] .new-tab-btn svg,
    [data-new-tab-page] .new-tab-actions .btn svg {
      width: 16px;
      height: 16px;
      flex: none;
    }

    [data-new-tab-page] .new-tab-btn:hover,
    [data-new-tab-page] .new-tab-actions .btn:hover {
      background: color-mix(in srgb, var(--ink-1) 7%, transparent);
      color: var(--ink-1);
    }

    [data-new-tab-page] .new-tab-btn--outline {
      border-color: transparent;
      background: transparent;
    }

    [data-new-tab-page] .new-tab-btn--outline:hover {
      border-color: transparent;
      background: color-mix(in srgb, var(--ink-1) 6%, transparent);
    }

    [data-new-tab-page] .new-tab-btn--ghost {
      color: var(--ink-2);
    }

    [data-new-tab-page] .new-tab-btn--ghost:hover {
      color: var(--ink-1);
    }

    /* 工具入口与索引行同一套材质：磨砂 + 细描边，别用实心白块抢焦点 */
    [data-new-tab-page] .new-tab-tools__trigger {
      width: 32px;
      height: 32px;
      padding: 0;
      border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
      border-radius: var(--ntab-radius-control);
      background: color-mix(in srgb, currentColor 10%, transparent);
      backdrop-filter: blur(10px);
      color: var(--ink-1);
      transition:
        background-color var(--ntab-duration-fast) ease,
        border-color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .new-tab-tools__trigger:hover,
    [data-new-tab-page] .new-tab-tools__trigger:focus-visible {
      border-color: color-mix(in srgb, currentColor 40%, transparent);
      background: color-mix(in srgb, currentColor 16%, transparent);
    }

    [data-new-tab-page] .new-tab-tools__label {
      display: none;
    }

    [data-new-tab-page] .new-tab-tools__trigger svg {
      width: 16px;
      height: 16px;
    }

    [data-new-tab-page] .new-tab-btn--icon {
      width: 30px;
      padding: 0;
    }

    [data-new-tab-page] .new-tab-btn:focus-visible,
    [data-new-tab-page] .new-tab-actions .btn:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    /* ── 搜索 ─────────────────────────────────────────────────────── */
    .new-tab-search-row {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
      max-height: 7rem;
      transition:
        opacity var(--ntab-duration-fast) ease,
        transform var(--ntab-duration-base) var(--ntab-ease-standard),
        max-height var(--ntab-duration-base) var(--ntab-ease-standard);
    }

    [data-new-tab-page] .new-tab-search {
      display: flex;
      align-items: stretch;
      width: 100%;
      max-width: 22rem;
      height: 48px;
      min-width: 0;
      overflow: hidden;
      border: 1px solid var(--line-1);
      border-radius: 0;
      background: var(--surface-1);
      transition:
        max-width var(--ntab-duration-base) var(--ntab-ease-standard),
        border-color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .new-tab-search:focus-within {
      max-width: 100%;
      border-color: var(--ntab-line-strong);
    }

    .new-tab-search__icon {
      display: grid;
      width: 40px;
      flex: none;
      place-items: center;
      color: var(--ink-2);
    }

    .new-tab-search__icon svg {
      width: 18px;
      height: 18px;
    }

    [data-new-tab-page] .new-tab-search__input {
      flex: 1;
      min-width: 0;
      height: 100%;
      border: 0;
      background: transparent;
      padding: 0 4px;
      color: var(--ink-1);
      font: 400 16px/24px var(--font-sans);
      outline: none;
    }

    [data-new-tab-page] .new-tab-search__input::placeholder {
      color: var(--ink-2);
    }

    [data-new-tab-page] .new-tab-search__input::-webkit-search-cancel-button {
      margin-right: 8px;
    }

    [data-new-tab-page] .new-tab-search__submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      flex: none;
      height: 100%;
      padding: 0 20px;
      border: 0;
      border-radius: 0;
      background: var(--ink-1);
      color: var(--surface-1);
      font: 500 13px/20px var(--font-sans);
      cursor: pointer;
      transition: background-color var(--ntab-duration-fast) var(--ntab-ease-standard);
    }

    [data-new-tab-page] .new-tab-search__submit svg {
      width: 16px;
      height: 16px;
    }

    [data-new-tab-page] .new-tab-search__submit:hover {
      background: color-mix(in srgb, var(--ink-1) 86%, var(--surface-1));
    }

    [data-new-tab-page] .new-tab-search__submit:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: -4px;
    }

    .new-tab-search-hint {
      margin: 0;
      color: var(--ink-2);
      font: 400 12px/20px var(--font-sans);
      white-space: nowrap;
    }

    /* ── 快捷区 ───────────────────────────────────────────────────── */
    .new-tab-board {
      display: flex;
      flex-direction: column;
      gap: 24px;
      min-width: 0;
    }

    [data-new-tab-page] .new-tab-group-add {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      width: fit-content;
      min-height: 32px;
      padding: 6px 10px;
      border: 1px dashed var(--line-1);
      border-radius: var(--ntab-radius-control);
      background: transparent;
      color: var(--ink-2);
      font: 500 13px/20px var(--font-sans);
      cursor: pointer;
      transition:
        border-color var(--ntab-duration-fast) ease,
        color var(--ntab-duration-fast) ease,
        background-color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .new-tab-group-add svg {
      width: 14px;
      height: 14px;
    }

    [data-new-tab-page] .new-tab-group-add:hover {
      border-color: var(--ntab-line-strong);
      background: color-mix(in srgb, var(--ink-1) 4%, transparent);
      color: var(--ink-1);
    }

    [data-new-tab-page][data-has-groups="false"] .new-tab-group-add {
      display: none;
    }

    .new-tab-board__bar {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line-1);
    }

    .new-tab-board__heading {
      display: flex;
      align-items: baseline;
      gap: 12px;
      min-width: 0;
    }

    .new-tab-board__title {
      margin: 0;
      color: var(--ink-1);
      font: 600 16px/24px var(--font-sans);
    }

    .new-tab-board__summary {
      margin: 0;
      color: var(--ink-2);
      font: 400 12px/20px var(--font-sans);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .new-tab-board__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    [data-new-tab-page][data-has-groups="false"] .new-tab-board__bar {
      display: none;
    }

    [data-shortcut-stack] {
      display: flex;
      flex-direction: column;
      gap: 28px;
      min-width: 0;
    }

    .shortcut-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 0;
    }

    .shortcut-group__summary {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      cursor: grab;
    }

    [data-shortcut-stack] .shortcut-sortable-chosen .shortcut-group__summary,
    [data-shortcut-stack] .shortcut-sortable-drag .shortcut-group__summary {
      cursor: grabbing;
    }

    /* 拖分组时按钮不抢拖拽起点：把手行内的操作按钮照常可点 */
    .shortcut-group__summary button,
    .shortcut-group__summary .shortcut-drag-handle {
      cursor: pointer;
    }

    .shortcut-group__title {
      color: var(--ink-2);
      font: 600 14px/20px var(--font-sans);
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    .shortcut-group__count {
      color: var(--ink-2);
      font: 500 11px/18px var(--font-sans);
      font-variant-numeric: tabular-nums;
    }

    .shortcut-group__empty {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      width: fit-content;
      padding: 2px 0 4px;
      border: 0;
      background: transparent;
      color: var(--ink-3);
      font: 400 12px/18px var(--font-sans);
      cursor: pointer;
      transition: color var(--ntab-duration-fast) ease;
    }

    .shortcut-group__empty svg {
      width: 13px;
      height: 13px;
    }

    .shortcut-group__empty:hover {
      color: var(--ink-1);
    }

    .shortcut-group__rule {
      height: 1px;
      min-width: 24px;
      flex: 1;
      background: var(--line-1);
    }

    .shortcut-group__actions {
      display: flex;
      align-items: center;
      gap: 2px;
      flex: none;
    }

    [data-new-tab-page] .new-tab-group-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: var(--ntab-radius-control);
      background: transparent;
      color: var(--ink-2);
      font: 500 12px/20px var(--font-sans);
      opacity: 0;
      cursor: pointer;
      transition:
        opacity var(--ntab-duration-fast) ease,
        background-color var(--ntab-duration-fast) ease,
        color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .new-tab-group-action svg {
      width: 14px;
      height: 14px;
    }

    .shortcut-group__summary:hover .new-tab-group-action,
    .shortcut-group__summary:focus-within .new-tab-group-action,
    [data-new-tab-page] .new-tab-group-action:focus-visible {
      opacity: 1;
    }

    [data-new-tab-page] .new-tab-group-action:hover {
      background: color-mix(in srgb, var(--ink-1) 6%, transparent);
      color: var(--ink-1);
    }

    [data-new-tab-page] .new-tab-group-action:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    [data-new-tab-page] .shortcut-drag-handle {
      display: grid;
      width: 16px;
      height: 20px;
      place-items: center;
      flex: none;
      border: 0;
      background: transparent;
      color: var(--ink-3);
      opacity: 0;
      cursor: grab;
      transition: opacity var(--ntab-duration-fast) ease, color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .shortcut-drag-handle svg {
      width: 14px;
      height: 14px;
    }

    .shortcut-group__summary:hover .shortcut-drag-handle,
    .new-tab-group-action:focus-visible + .shortcut-drag-handle,
    [data-new-tab-page] .shortcut-drag-handle:focus-visible {
      opacity: 1;
    }

    [data-new-tab-page] .shortcut-drag-handle:hover {
      color: var(--ink-2);
    }

    [data-new-tab-page] .shortcut-group__menu {
      display: grid;
      width: 28px;
      height: 28px;
      min-height: 28px;
      place-items: center;
      padding: 0;
      border: 0;
      border-radius: var(--ntab-radius-control);
      background: transparent;
      color: var(--ink-2);
      opacity: 0;
      cursor: pointer;
      transition: opacity var(--ntab-duration-fast) ease, background-color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .shortcut-group__menu svg {
      width: 16px;
      height: 16px;
    }

    .shortcut-group__summary:hover .shortcut-group__menu,
    [data-new-tab-page] .shortcut-group__menu:focus-visible {
      opacity: 1;
    }

    [data-new-tab-page] .shortcut-group__menu:hover {
      background: color-mix(in srgb, var(--ink-1) 6%, transparent);
      color: var(--ink-1);
    }

    @media (max-width: 767px) {
      [data-new-tab-page] .shortcut-group__menu {
        opacity: 1;
      }

      [data-new-tab-page] .shortcut-group__actions .new-tab-group-action {
        width: 32px;
        height: 32px;
        justify-content: center;
        padding: 0;
        opacity: 1;
      }

      [data-new-tab-page] .shortcut-group__actions .new-tab-group-action span:last-child {
        display: none;
      }

      [data-new-tab-page] .shortcut-group__menu {
        width: 32px;
        height: 32px;
      }

      [data-new-tab-page] .shortcut-drag-handle {
        display: none;
      }
    }

    [data-shortcut-stack] .shortcut-group__items {
      position: relative;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 10px;
      width: 100%;
      min-width: 0;
    }

    /* 卡片：跟原页面一致，浅灰底、直角、无描边，悬停只提亮。 */
    [data-shortcut-stack] .shortcut-item-shell {
      position: relative;
      z-index: 0;
      width: 80px;
      height: 96px;
      flex: none;
      cursor: grab;
      transition:
        transform 550ms cubic-bezier(0.22, 1, 0.36, 1),
        z-index 0s;
    }

    /* 首帧画布直接落位，不补间；data-booting 在两帧后摘掉。 */
    [data-new-tab-page][data-booting="true"] [data-shortcut-stack] .shortcut-item-shell {
      transition: none;
    }

    [data-shortcut-stack] .shortcut-item-shell:hover,
    [data-shortcut-stack] .shortcut-item-shell:focus-within {
      z-index: 30;
    }

    [data-shortcut-stack] .shortcut-item-shell:active {
      cursor: grabbing;
    }

    /* 拖拽中（SortableJS，forceFallback）：跟随鼠标的拖影不透明（看得清拖的是什么），
       原位几乎只剩虚线占位框；分组与站点拖拽共用这套视觉 */
    [data-shortcut-stack] .shortcut-sortable-chosen {
      opacity: 0.25;
      cursor: grabbing;
    }

    [data-shortcut-stack] .shortcut-sortable-ghost {
      opacity: 1;
      background: color-mix(in srgb, var(--ntab-card-ink) 6%, transparent);
      border: 1.5px dashed color-mix(in srgb, var(--ntab-card-ink) 40%, transparent);
      border-radius: 0.55rem;
    }

    [data-shortcut-stack] .shortcut-sortable-ghost .shortcut-item {
      visibility: hidden;
    }

    [data-shortcut-stack] .shortcut-sortable-drag {
      opacity: 1;
      cursor: grabbing;
      filter: drop-shadow(0 8px 24px rgb(0 0 0 / 18%));
    }

    [data-shortcut-stack] .shortcut-item {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      overflow: hidden;
      border: 1px solid var(--ntab-card-border);
      border-radius: 0;
      background: var(--ntab-card-bg);
      color: var(--ntab-card-ink);
      padding: 10px 6px;
      font: inherit;
      text-align: center;
      text-decoration: none;
      transition:
        transform var(--ntab-duration-fast) var(--ntab-ease-standard),
        background-color var(--ntab-duration-fast) var(--ntab-ease-standard),
        border-color var(--ntab-duration-fast) var(--ntab-ease-standard);
    }

    [data-shortcut-stack] .shortcut-item:hover,
    [data-shortcut-stack] .shortcut-item:focus-visible {
      transform: translateY(-2px);
      border-color: transparent;
      background: color-mix(in srgb, var(--ink-1) 8%, var(--surface-1));
    }

    [data-shortcut-stack] .shortcut-item:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    [data-shortcut-stack] .shortcut-item:active {
      transform: translateY(0);
      transition-duration: 100ms;
    }

    [data-shortcut-stack] .shortcut-item__icon {
      display: grid;
      width: 40px;
      height: 40px;
      flex: none;
      place-items: center;
      overflow: hidden;
      background: transparent;
      transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-shortcut-stack] .shortcut-item:hover .shortcut-item__icon,
    [data-shortcut-stack] .shortcut-item:focus-visible .shortcut-item__icon {
      transform: scale(1.05);
    }

    [data-shortcut-stack] .shortcut-item__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 4px;
    }

    [data-shortcut-stack] .shortcut-item__initial {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      color: var(--ntab-card-ink-2);
      font: 600 16px/1 var(--font-sans);
      font-variant-numeric: tabular-nums;
    }

    [data-shortcut-stack] .shortcut-item__initial.hidden {
      display: none;
    }

    [data-shortcut-stack] .shortcut-item__label {
      display: grid;
      width: 100%;
      min-width: 0;
      gap: 1px;
      justify-items: center;
    }

    [data-shortcut-stack] .shortcut-item__label strong {
      display: block;
      width: 100%;
      overflow: hidden;
      color: var(--ntab-card-ink);
      font: 500 13px/18px var(--font-sans);
      text-overflow: ellipsis;
      white-space: nowrap;
      text-shadow: var(--ntab-card-label-shadow);
    }

    [data-shortcut-stack] .shortcut-item__label small {
      display: block;
      width: 100%;
      overflow: hidden;
      color: var(--ntab-card-ink-2);
      font: 400 11px/15px var(--font-sans);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* 深浅色文字模式：卡片跟着换底，保证真实 favicon 与文字都看得清。 */
    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: #0f1013;
      --ntab-card-border: rgba(255, 255, 255, 0.14);
      --ntab-card-ink: #f8fafc;
      --ntab-card-ink-2: rgba(248, 250, 252, 0.68);
    }

    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="dark"] [data-shortcut-stack] .shortcut-item:focus-visible {
      background: #1a1c21;
      border-color: rgba(255, 255, 255, 0.28);
    }

    html[data-item-tone="light"][data-theme="black"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: #f4f4f6;
      --ntab-card-border: rgba(0, 0, 0, 0.12);
      --ntab-card-ink: #111827;
      --ntab-card-ink-2: rgba(17, 24, 39, 0.66);
    }

    html[data-item-tone="light"][data-theme="black"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-item-tone="light"][data-theme="black"] [data-shortcut-stack] .shortcut-item:focus-visible {
      background: #ffffff;
      border-color: rgba(0, 0, 0, 0.22);
    }

    /* 有背景图时卡片改成半透明底，照片上文字补一道投影。 */
    html[data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-label-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(10px);
    }

    html[data-new-tab-background="true"][data-item-tone="dark"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(8, 10, 14, 0.66);
      --ntab-card-border: rgba(255, 255, 255, 0.2);
    }

    html[data-new-tab-background="true"][data-item-tone="light"] [data-shortcut-stack] .shortcut-item {
      --ntab-card-bg: rgba(255, 255, 255, 0.76);
      --ntab-card-border: rgba(0, 0, 0, 0.14);
    }

    [data-shortcut-stack] .shortcut-item__tooltip {
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      z-index: 40;
      display: grid;
      min-width: 9rem;
      max-width: 16rem;
      gap: 2px;
      padding: 8px 12px;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-control);
      background: var(--surface-1);
      color: var(--ink-1);
      box-shadow: var(--shadow-pop);
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) translateY(4px);
      transition:
        opacity 150ms ease,
        transform 150ms ease;
    }

    [data-shortcut-stack] .shortcut-item__tooltip::after {
      position: absolute;
      top: 100%;
      left: 50%;
      width: 8px;
      height: 8px;
      border-right: 1px solid var(--line-1);
      border-bottom: 1px solid var(--line-1);
      background: var(--surface-1);
      content: "";
      transform: translate(-50%, -50%) rotate(45deg);
    }

    [data-shortcut-stack] .shortcut-item__tooltip strong {
      overflow: hidden;
      color: var(--ink-1);
      font: 600 14px/20px var(--font-sans);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    [data-shortcut-stack] .shortcut-item__tooltip small {
      overflow: hidden;
      color: var(--ink-2);
      font: 400 12px/18px var(--font-sans);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .shortcut-item-shell:hover .shortcut-item__tooltip,
    .shortcut-item-shell:focus-within .shortcut-item__tooltip {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    @media (max-width: 639px) {
      [data-shortcut-stack] .shortcut-item__tooltip {
        display: none;
      }
    }

    /* ── 空态 ─────────────────────────────────────────────────────── */
    .shortcut-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 100%;
      max-width: 40rem;
      margin-inline: auto;
      padding: 40px 24px;
      border: 1px dashed var(--line-1);
      border-radius: 0;
      background: transparent;
      text-align: center;
    }

    .shortcut-empty__title {
      margin: 0;
      color: var(--ink-1);
      font: 400 24px/1.3 var(--font-reading);
      letter-spacing: -0.01em;
    }

    .shortcut-empty__hint {
      margin: 0;
      color: var(--ink-2);
      font: 400 14px/22px var(--font-sans);
      max-width: 34em;
    }

    [data-new-tab-page] .shortcut-empty__action {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 34px;
      padding: 0 12px;
      border: 1px solid var(--ink-1);
      border-radius: var(--ntab-radius-control);
      background: var(--ink-1);
      color: var(--surface-1);
      font: 500 13px/20px var(--font-sans);
      cursor: pointer;
      transition: background-color var(--ntab-duration-fast) ease;
    }

    [data-new-tab-page] .shortcut-empty__action:hover {
      background: color-mix(in srgb, var(--ink-1) 86%, var(--surface-1));
    }

    [data-new-tab-page] .shortcut-empty__action:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    /* ── 抽屉（配置 / 图标说明） ──────────────────────────────────── */
    [data-config-drawer],
    [data-notes-panel] {
      transition:
        opacity 200ms ease,
        display 240ms allow-discrete;
    }

    [data-config-drawer][data-open],
    [data-notes-panel][data-open] {
      opacity: 1;
    }

    [data-config-drawer] .new-tab-config__backdrop,
    [data-notes-panel] .new-tab-notes__backdrop {
      opacity: 0;
      background: color-mix(in srgb, var(--ink-1) 24%, transparent);
      backdrop-filter: blur(4px);
      transition: opacity 200ms ease;
    }

    [data-config-drawer][data-open] .new-tab-config__backdrop,
    [data-notes-panel][data-open] .new-tab-notes__backdrop {
      opacity: 1;
    }

    [data-config-drawer] .new-tab-config__sheet,
    [data-notes-panel] .new-tab-notes__sheet {
      border-left: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-panel) 0 0 var(--ntab-radius-panel);
      background: var(--surface-1);
      box-shadow: -8px 0 24px rgb(15 23 42 / 0.1);
      transform: translateX(100%);
      transition: transform 240ms var(--ntab-ease-standard);
    }

    [data-config-drawer][data-open] .new-tab-config__sheet,
    [data-notes-panel][data-open] .new-tab-notes__sheet {
      transform: translateX(0);
    }

    .new-tab-config__header,
    .new-tab-notes__header {
      padding: 16px;
      border-bottom: 1px solid var(--line-1);
    }

    .new-tab-config__body {
      display: grid;
      align-content: start;
      gap: 24px;
      padding: 16px;
      overflow-y: auto;
    }

    .new-tab-config__section {
      display: grid;
      gap: 12px;
    }

    .new-tab-config__section-title {
      color: var(--ink-1);
      font: 600 14px/22px var(--font-sans);
    }

    .new-tab-config__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .new-tab-config .form-control {
      display: grid;
      min-width: 0;
      gap: 6px;
    }

    .new-tab-config .label {
      padding: 0;
      min-height: 0;
    }

    .new-tab-config .label-text,
    .new-tab-config .label-text-alt,
    .new-tab-dialog .field-label {
      color: var(--ink-2);
      font: 400 12px/18px var(--font-sans);
    }

    .new-tab-config .input,
    .new-tab-config .select,
    .new-tab-dialog .input,
    .new-tab-dialog .select {
      height: 36px;
      min-height: 36px;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-control);
      background-color: var(--surface-1);
      color: var(--ink-1);
      font: 400 14px/20px var(--font-sans);
    }

    .new-tab-config .input:focus,
    .new-tab-config .select:focus,
    .new-tab-dialog .input:focus,
    .new-tab-dialog .select:focus {
      border-color: var(--ntab-focus);
      outline: 2px solid color-mix(in srgb, var(--ntab-focus) 22%, transparent);
      outline-offset: 0;
    }

    .new-tab-config__footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      padding: 16px;
      border-top: 1px solid var(--line-1);
    }

    .new-tab-config__notes-link {
      margin-left: auto;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink-2);
      font: 400 12px/20px var(--font-sans);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .new-tab-config__notes-link:hover {
      color: var(--ink-1);
    }

    .new-tab-config__notes-link:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    .new-tab-notes__body {
      display: grid;
      align-content: start;
      gap: 20px;
      padding: 16px;
      overflow-y: auto;
      color: var(--ink-2);
      font: 400 14px/22px var(--font-sans);
    }

    .new-tab-notes__body h3 {
      margin: 0;
      color: var(--ink-1);
      font: 600 14px/22px var(--font-sans);
    }

    .new-tab-notes__body p {
      margin: 0;
    }

    .new-tab-notes__code {
      margin: 0;
      overflow-x: auto;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-control);
      background: var(--surface-2);
      padding: 12px;
      color: var(--ink-1);
      font: 400 12px/20px var(--font-mono);
    }

    /* ── 站点 / 分组弹窗 ──────────────────────────────────────────── */
    dialog.new-tab-dialog {
      position: fixed;
      inset: 0;
      width: min(92vw, 26rem);
      height: fit-content;
      max-height: min(88dvh, 42rem);
      margin: auto;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink-1);
      overflow: visible;
      opacity: 0;
      transform: translateY(8px) scale(0.98);
      transition:
        opacity var(--ntab-duration-fast) var(--ntab-ease-exit),
        transform var(--ntab-duration-fast) var(--ntab-ease-exit),
        display var(--ntab-duration-fast) allow-discrete,
        overlay var(--ntab-duration-fast) allow-discrete;
    }

    dialog.new-tab-dialog[open] {
      opacity: 1;
      transform: none;
      transition-duration: var(--ntab-duration-base);
      transition-timing-function: var(--ntab-ease-enter);
    }

    @starting-style {
      dialog.new-tab-dialog[open] {
        opacity: 0;
        transform: translateY(8px) scale(0.98);
      }
    }

    dialog.new-tab-dialog::backdrop {
      background: color-mix(in srgb, var(--ink-1) 26%, transparent);
      backdrop-filter: blur(4px);
      opacity: 0;
      transition:
        opacity var(--ntab-duration-fast) var(--ntab-ease-exit),
        display var(--ntab-duration-fast) allow-discrete,
        overlay var(--ntab-duration-fast) allow-discrete;
    }

    dialog.new-tab-dialog[open]::backdrop {
      opacity: 1;
      transition-duration: var(--ntab-duration-base);
      transition-timing-function: var(--ntab-ease-enter);
    }

    @starting-style {
      dialog.new-tab-dialog[open]::backdrop {
        opacity: 0;
      }
    }

    .new-tab-dialog__panel {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      max-height: inherit;
      overflow: hidden;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-panel);
      background: var(--surface-1);
      box-shadow: var(--shadow-pop);
    }

    .new-tab-dialog__header {
      padding: 20px;
      border-bottom: 1px solid var(--line-1);
    }

    .new-tab-dialog__header h2 {
      margin: 0;
      color: var(--ink-1);
      font: 600 16px/24px var(--font-sans);
    }

    .new-tab-dialog__header p {
      margin: 4px 0 0;
      color: var(--ink-2);
      font: 400 12px/18px var(--font-sans);
    }

    .new-tab-dialog__body {
      display: grid;
      align-content: start;
      gap: 16px;
      padding: 20px;
      overflow-y: auto;
    }

    .new-tab-dialog__footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      padding: 16px 20px;
      border-top: 1px solid var(--line-1);
    }

    .new-tab-dialog .field-row {
      display: grid;
      min-width: 0;
      gap: 6px;
    }

    .new-tab-dialog .field-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .new-tab-dialog .inline-link {
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink-2);
      font: 500 12px/20px var(--font-sans);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .new-tab-dialog .inline-link:hover {
      color: var(--ink-1);
    }

    .new-tab-dialog .inline-link:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: 2px;
    }

    .new-tab-dialog .dialog-preview {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-control);
      background: var(--surface-2);
    }

    .new-tab-dialog .dialog-preview__icon {
      display: grid;
      width: 40px;
      height: 40px;
      flex: none;
      place-items: center;
      overflow: hidden;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-control);
      background: var(--surface-1);
    }

    .new-tab-dialog .dialog-preview__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 4px;
    }

    .new-tab-dialog .dialog-preview__title {
      margin: 0;
      color: var(--ink-1);
      font: 500 14px/20px var(--font-sans);
    }

    .new-tab-dialog .dialog-preview__hint {
      margin: 0;
      color: var(--ink-2);
      font: 400 12px/18px var(--font-sans);
    }

    .new-tab-dialog .form-error {
      margin: 0;
      color: #ad352f;
      font: 400 12px/18px var(--font-sans);
    }

    [data-theme="black"] .new-tab-dialog .form-error {
      color: #ff9285;
    }

    .new-tab-dialog .form-error.hidden {
      display: none;
    }

    .new-tab-dialog__footer .btn-primary {
      border: 1px solid var(--ink-1);
      background: var(--ink-1);
      color: var(--surface-1);
    }

    .new-tab-dialog__footer .btn-primary:hover {
      background: color-mix(in srgb, var(--ink-1) 86%, var(--surface-1));
    }

    .new-tab-dialog__footer .btn-ghost {
      color: var(--ink-2);
    }

    .new-tab-dialog__footer .btn-ghost:hover {
      color: var(--ink-1);
    }

    /* ── 提示条 ───────────────────────────────────────────────────── */
    .new-tab-toast {
      position: fixed;
      left: 50%;
      bottom: calc(1.5rem + env(safe-area-inset-bottom));
      z-index: 95;
      max-width: min(90vw, 26rem);
      padding: 8px 14px;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-card);
      background: var(--surface-1);
      color: var(--ink-1);
      box-shadow: var(--shadow-pop);
      font: 400 14px/20px var(--font-sans);
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) translateY(8px);
      transition:
        opacity var(--ntab-duration-fast) ease,
        transform var(--ntab-duration-base) var(--ntab-ease-standard);
    }

    .new-tab-toast[data-visible] {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ── 右键菜单 ─────────────────────────────────────────────────── */
    .shortcut-context-menu {
      animation: ntab-menu-in 160ms var(--ntab-ease-enter) both;
      transform-origin: top left;
    }

    .shortcut-context-menu.ntab-menu-vanish {
      animation: ntab-menu-out 130ms cubic-bezier(0.4, 0, 1, 1) forwards;
      pointer-events: none;
    }

    @keyframes ntab-menu-in {
      from {
        opacity: 0;
        transform: scale(0.97) translateY(-3px);
      }
    }

    @keyframes ntab-menu-out {
      to {
        opacity: 0;
        transform: scale(0.98);
      }
    }

    /* ── 收起 / 挂起 ─────────────────────────────────────────────── */
    [data-new-tab-page][data-header-state="collapsed"] .new-tab-greeting-block,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-greeting-block {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-6px);
      pointer-events: none;
    }

    [data-new-tab-page][data-header-state="collapsed"].new-tab-shell {
      padding-top: 24px;
    }

    [data-new-tab-page][data-header-state="suspended"].new-tab-shell {
      padding-top: 16px;
      gap: 0;
    }

    [data-new-tab-page][data-header-state="suspended"] .new-tab-masthead,
    [data-new-tab-page][data-header-state="suspended"] .new-tab-search-row {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-8px);
      pointer-events: none;
    }

    [data-new-tab-page][data-header-state="suspended"] .new-tab-actions {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      visibility: hidden;
      transition:
        opacity 300ms ease,
        transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
        max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 420ms;
    }

    [data-new-tab-page][data-header-state="suspended"] .new-tab-search {
      border-color: transparent;
    }

    [data-new-tab-page][data-header-state="collapsed"] [data-header-collapse] svg,
    [data-new-tab-page][data-header-state="suspended"] [data-header-collapse] svg {
      transform: rotate(180deg);
    }

    [data-header-collapse] svg {
      transition: transform 240ms var(--ntab-ease-standard);
    }

    html:has([data-new-tab-page]) .new-tab-restore {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition:
        opacity 200ms ease,
        transform 240ms var(--ntab-ease-standard),
        visibility 0s linear 240ms;
    }

    html:has([data-new-tab-page][data-header-state="suspended"]) .new-tab-restore {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 200ms ease 80ms,
        transform 240ms var(--ntab-ease-standard) 80ms,
        visibility 0s;
    }

    /* 刷新时条目按序浮入；只走一次，之后的增删改不重播 */
    [data-shortcut-stack] .shortcut-item-shell.ntab-pop > .shortcut-item {
      animation: ntab-pop-in 420ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
      animation-delay: var(--ntab-delay, 0ms);
    }

    @keyframes ntab-pop-in {
      from {
        opacity: 0;
        transform: translateY(0.5rem) scale(0.985);
      }
    }

    [data-shortcut-stack] .shortcut-item-shell.ntab-vanish > .shortcut-item {
      animation: ntab-pop-out 260ms cubic-bezier(0.4, 0, 1, 1) forwards;
      pointer-events: none;
    }

    @keyframes ntab-pop-out {
      to {
        opacity: 0;
        transform: scale(0.86);
      }
    }

    /* ── 响应式 ───────────────────────────────────────────────────── */
    @media (max-width: 991px) {
      [data-new-tab-page].new-tab-shell {
        gap: 28px;
      }

      .new-tab-search-hint {
        display: none;
      }
    }

    @media (max-width: 767px) {
      [data-new-tab-page].new-tab-shell {
        gap: 24px;
        padding-top: 32px;
        padding-bottom: 40px;
        padding-left: 16px;
        padding-right: 16px;
      }

      .new-tab-masthead {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
      }

      .new-tab-actions {
        justify-content: flex-start;
      }

      [data-home-link] {
        width: 36px;
        padding: 0;
        justify-content: center;
      }

      [data-home-link] span {
        display: none;
      }

      .new-tab-greeting {
        font-size: 24px;
        line-height: 32px;
      }

      [data-new-tab-page] .new-tab-search {
        max-width: 100%;
      }

      [data-new-tab-page] .new-tab-search__submit {
        width: 56px;
        padding: 0;
        border-radius: 0;
      }

      .new-tab-search__submit-label {
        display: none;
      }

      .new-tab-board__bar {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
      }

      .new-tab-board__actions {
        width: 100%;
      }

      .new-tab-board__actions .new-tab-btn {
        flex: 1;
      }

      .shortcut-empty {
        padding: 24px;
      }

      [data-shortcut-stack] {
        gap: 28px;
      }

      [data-shortcut-stack] .shortcut-item-shell {
        width: 80px;
        height: 88px;
      }

      [data-new-tab-page] .new-tab-config__grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 420px) {
      dialog.new-tab-dialog {
        width: calc(100vw - 2rem);
      }

      .new-tab-dialog__header,
      .new-tab-dialog__body,
      .new-tab-dialog__footer {
        padding-left: 16px;
        padding-right: 16px;
      }
    }

    /* Hallmark · macrostructure: Index-First · tone: utilitarian · theme: project tokens
     * page: new-tab · replaces the tile grid on the "grid" layout with two-column index rows
     * pre-emit critique: P4 H4 E4 S4 R4 V4
     */
    html[data-new-tab-layout="grid"] [data-new-tab-page].new-tab-shell {
      gap: 30px;
      max-width: calc(var(--ntab-page-width) / var(--ntab-ui-scale));
      padding-bottom: 4.5rem;
    }

    html[data-new-tab-layout="grid"] .new-tab-masthead {
      align-items: baseline;
      gap: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line-1);
    }

    html[data-new-tab-layout="grid"] .new-tab-greeting-block {
      gap: 2px;
    }

    html[data-new-tab-layout="grid"] .new-tab-greeting {
      font: 400 clamp(1.12rem, 2vw, 1.32rem) / 1.3 var(--font-reading);
      letter-spacing: -0.01em;
    }

    html[data-new-tab-layout="grid"] .new-tab-date {
      font: 500 0.76rem / 1.4 var(--font-sans);
    }

    /* 搜索是一行输入，不是一块大按钮：下细线、无高光底 */
    html[data-new-tab-layout="grid"] .new-tab-search-row {
      /* 与左列同宽，搜索下划线正好收在列边界上 */
      max-width: calc(50% - 22px);
      gap: 12px;
    }

    html[data-new-tab-layout="grid"] [data-new-tab-page] .new-tab-search {
      height: 38px;
      max-width: 100%;
      border: 0;
      border-bottom: 1px solid var(--ntab-line-strong);
      background: color-mix(in srgb, var(--surface-1) 90%, transparent);
    }

    html[data-new-tab-layout="grid"] [data-new-tab-page] .new-tab-search:focus-within {
      border-bottom-color: var(--ntab-accent);
    }

    html[data-new-tab-layout="grid"] [data-new-tab-page] .new-tab-search__icon {
      width: 34px;
    }

    html[data-new-tab-layout="grid"] [data-new-tab-page] .new-tab-search__input {
      font: 400 15px/22px var(--font-sans);
    }

    html[data-new-tab-layout="grid"] [data-new-tab-page] .new-tab-search__submit {
      height: 38px;
      padding: 0 14px;
      border-left: 1px solid color-mix(in srgb, var(--ink-1) 10%, transparent);
      background: transparent;
      color: var(--ink-1);
    }

    html[data-new-tab-layout="grid"] [data-new-tab-page] .new-tab-search__submit:hover {
      background: color-mix(in srgb, var(--ink-1) 6%, transparent);
    }

    html[data-new-tab-layout="grid"] .new-tab-search-hint {
      display: none;
    }

    /* 索引区：组标题当段落标题，条目当目录行，两栏排 */
    html[data-new-tab-layout="grid"] [data-shortcut-stack] {
      gap: 34px;
    }

    html[data-new-tab-layout="grid"] .shortcut-group {
      gap: 0;
    }

    html[data-new-tab-layout="grid"] .shortcut-group__summary {
      gap: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--line-1);
    }

    /* 组标题不再自己画线，统一用 summary 的下边线 */
    html[data-new-tab-layout="grid"] .shortcut-group__rule {
      display: none;
    }

    html[data-new-tab-layout="grid"] .shortcut-group__title {
      color: var(--ink-1);
      font: 600 13px / 20px var(--font-sans);
      letter-spacing: 0.06em;
    }

    html[data-new-tab-layout="grid"] .shortcut-group__count {
      font: 500 11px / 20px var(--font-sans);
      opacity: 0.55;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-group__items {
      display: grid;
      grid-template-columns: repeat(var(--ntab-group-columns, 3), minmax(0, 1fr));
      align-items: stretch;
      gap: 0 28px;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item-shell {
      width: auto;
      height: auto;
      min-width: 0;
      transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item {
      position: static;
      inset: auto;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      height: 52px;
      min-height: 52px;
      padding: 8px 10px 8px 14px;
      overflow: hidden;
      border: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--ntab-card-ink) 12%, transparent);
      border-radius: 0;
      background: transparent;
      text-align: left;
      transition: none;
    }

    /* 有壁纸时：每条都铺一层磨砂，强度由 data-new-tab-blur 决定（medium 档为原效果）；
       「动态」由 JS 按壁纸透明度算出 4 到 16px 写进 style。浅色文字配深底，深色文字配浅底，压住高光 */
    html[data-new-tab-layout="grid"][data-new-tab-background="true"]
      [data-shortcut-stack]
      .shortcut-item {
      backdrop-filter: blur(var(--ntab-item-blur, 10px));
      background: color-mix(in srgb, currentColor 7%, transparent);
    }

    html[data-new-tab-layout="grid"][data-new-tab-background="true"][data-new-tab-blur="off"]
      [data-shortcut-stack]
      .shortcut-item {
      backdrop-filter: none;
      background: transparent;
      border-bottom-color: color-mix(in srgb, var(--ntab-card-ink) 18%, transparent);
    }

    html[data-new-tab-layout="grid"][data-new-tab-background="true"][data-new-tab-blur="off"][data-new-tab-text-colors="light"]
      [data-shortcut-stack]
      .shortcut-item {
      background: rgb(8 10 14 / 38%);
      border-bottom-color: rgb(255 255 255 / 18%);
    }

    html[data-new-tab-layout="grid"][data-new-tab-background="true"][data-new-tab-blur="off"][data-new-tab-text-colors="dark"]
      [data-shortcut-stack]
      .shortcut-item {
      background: rgb(255 255 255 / 44%);
      border-bottom-color: rgb(0 0 0 / 14%);
    }

    html[data-new-tab-layout="grid"][data-new-tab-background="true"][data-new-tab-text-colors="light"]
      [data-shortcut-stack]
      .shortcut-item {
      background: rgb(8 10 14 / 38%);
    }

    html[data-new-tab-layout="grid"][data-new-tab-background="true"][data-new-tab-text-colors="dark"]
      [data-shortcut-stack]
      .shortcut-item {
      background: rgb(255 255 255 / 44%);
    }

    /* 索引行悬停反馈：底色轻微加深 + 标题变主墨色 + 图标微放大 + 行最左侧出现墨色竖线；
       竖线用 shell 上的 ::before（条目自身是 flex，::before 会挤占内容位），
       覆盖整列高度（上到组标题分隔线、下到最后一条分隔线）；悬停底色跟随文字颜色模式 */
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item {
      transition:
        background-color 160ms var(--ntab-ease-standard),
        border-bottom-color 160ms var(--ntab-ease-standard);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__label strong {
      transition: color 160ms var(--ntab-ease-standard);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__icon,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__initial {
      transition: transform 200ms var(--ntab-ease-standard);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:focus-visible {
      transform: none;
      background: color-mix(in srgb, var(--ntab-card-ink) 10%, transparent);
      border-color: color-mix(in srgb, var(--ntab-card-ink) 18%, transparent);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:hover .shortcut-item__label strong,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:focus-visible .shortcut-item__label strong {
      color: var(--ntab-card-ink);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:hover .shortcut-item__icon,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:hover .shortcut-item__initial,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:focus-visible .shortcut-item__icon,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:focus-visible .shortcut-item__initial {
      transform: scale(1.12);
    }

    /* 列竖线：挂在条目 shell 上（shell 是列内唯一全高的元素），占位列最左侧 3px。
       默认透明，本列任意条目悬停/聚焦时整列显示；有壁纸磨砂时 z-index 需压过 backdrop */
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item-shell::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 5;
      width: 3px;
      background: var(--ntab-card-ink);
      opacity: 0;
      content: "";
      transition: opacity 160ms var(--ntab-ease-standard);
      pointer-events: none;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-group__items {
      position: relative;
    }

    html[data-new-tab-layout="grid"][data-new-tab-background="true"] [data-shortcut-stack] .shortcut-item-shell::before {
      z-index: 60;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-group__items:has(.shortcut-item-shell:hover)::before,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-group__items:has(.shortcut-item:focus-visible)::before {
      opacity: 0.85;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item-shell:hover::before,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item-shell:focus-within::before {
      opacity: 0.85;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item-shell:has(.shortcut-item:active)::before {
      opacity: 1;
    }

    /* 浅色文字模式：悬停底色换成深底提亮，竖线与文字跟着浅色文字走 */
    html[data-new-tab-layout="grid"][data-new-tab-text-colors="light"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-new-tab-layout="grid"][data-new-tab-text-colors="light"] [data-shortcut-stack] .shortcut-item:focus-visible {
      background: rgb(8 10 14 / 52%);
    }

    html[data-new-tab-layout="grid"][data-new-tab-text-colors="dark"] [data-shortcut-stack] .shortcut-item:hover,
    html[data-new-tab-layout="grid"][data-new-tab-text-colors="dark"] [data-shortcut-stack] .shortcut-item:focus-visible {
      background: rgb(255 255 255 / 58%);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:focus-visible {
      outline: 2px solid var(--ntab-focus);
      outline-offset: -2px;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item:active {
      transform: none;
      background: color-mix(in srgb, var(--ntab-card-ink) 14%, transparent);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__icon,
    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__initial {
      width: 20px;
      height: 20px;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__icon img {
      padding: 0;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__initial {
      font: 600 11px / 1 var(--font-sans);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__label {
      display: block;
      min-width: 0;
      text-align: left;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__tooltip {
      display: none;
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__label strong {
      font: 500 14px / 20px var(--font-sans);
    }

    html[data-new-tab-layout="grid"] [data-shortcut-stack] .shortcut-item__label small {
      font: 400 12px / 16px var(--font-sans);
      opacity: 0.92;
    }

    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"] .shortcut-group__title,
    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"] .shortcut-group__count {
      text-shadow: none;
    }

    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"]
      .new-tab-greeting,
    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"] .new-tab-date,
    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"] .new-tab-group-add {
      text-shadow: none;
    }

    /* 浅色文字落在照片壁纸上，给行内文字一层极轻的影，别让高光吃掉 */
    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"]
      [data-shortcut-stack]
      .shortcut-item__label
      strong,
    html[data-new-tab-text-colors="light"][data-new-tab-layout="grid"]
      [data-shortcut-stack]
      .shortcut-item__label
      small {
      text-shadow: none;
    }

    /* 「更多」面板：一行一项、图标左对齐、右端留给指示符 */
    [data-new-tab-page] .new-tab-tools__panel {
      width: 13rem;
      padding: 6px;
      border: 1px solid var(--line-1);
      border-radius: var(--ntab-radius-panel);
      background: var(--surface-1);
      box-shadow: var(--shadow-pop);
    }

    [data-new-tab-page] .new-tab-tools__panel .new-tab-actions {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    [data-new-tab-page] .new-tab-tools__panel .new-tab-btn,
    [data-new-tab-page] .new-tab-tools__panel .btn,
    [data-new-tab-page] .new-tab-tools__panel [data-home-link] {
      justify-content: flex-start;
      gap: 10px;
      width: 100%;
      height: 34px;
      min-height: 34px;
