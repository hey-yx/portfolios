</style>

  <script>
    // @ts-nocheck
    import { buildMetaProxyUrl, META_PROXY_ORIGIN } from "../data/meta-proxy";
    import Sortable from "sortablejs";
    const defaultPayloadElement = document.getElementById("new-tab-defaults");
    const defaultPayload = defaultPayloadElement?.textContent
      ? JSON.parse(defaultPayloadElement.textContent)
      : {};

    const cloneValue = (value) => {
      if (typeof structuredClone === "function") {
        return structuredClone(value);
      }

      return JSON.parse(JSON.stringify(value));
    };

    const configVersion = 7;
    const defaultBackgroundOpacity = 60;
    const oldDefaultBackgroundOpacities = [34, 50];
    const storageQuotaErrorMessage = "配置过大，超出本地存储上限，无法保存；请压缩背景图或精简数据";
    const defaultTextColors = {
      mode: "default",
    };

    const defaultState = () => ({
      version: configVersion,
      userName: defaultPayload.config?.userName ?? "Ethanz888",
      backgroundImage: "",
      backgroundOpacity: defaultBackgroundOpacity,
      backgroundSource: "custom",
      wallpaperIndex: 0,
      groupColumns: 3,
      pageWidth: 992,
      uiScale: 100,
      fontFamily: "default",
      itemBlur: "medium",
      textColors: cloneValue(defaultTextColors),
      defaultSearchEngineId: defaultPayload.config?.search?.defaultEngineId ?? "google",
      homeLink: cloneValue(defaultPayload.config?.homeLink ?? { label: "资料卡首页", href: "/" }),
      shortcutOpenMode: "current",
      greetings: cloneValue(defaultPayload.config?.greetings ?? []),
      searchEngines: cloneValue(defaultPayload.searchEngines ?? []),
      shortcutGroups: cloneValue(defaultPayload.shortcutGroups ?? []),
      shortcutLayout: "grid",
      scatterSeed: Math.floor(Math.random() * 1000000000) + 1,
      headerCollapsed: false,
      headerSuspended: false,
    });

    const storageKey = defaultPayload.config?.storageKey ?? "ethanz-new-tab-config";
    const layoutLabels = {
      grid: "网格",
      stack: "堆叠",
      ring: "弧形",
      scatter: "随机",
    };
    const logoCacheStorageKey = `${storageKey}:logo-cache`;
    // v5→v6：缓存里的 logoUrl 存的是代理地址，读出来会被再套一层代理（522）；
    // 同时 canProxyUrl 补齐环回/链路本地拦截、候选链补 1Panel 与按目录探测，旧条目全部作废重建。
    // v6→v7：load 后的 content-type 复核把「fetch 被 CORS 挡掉」误判成「拿到 HTML 兜底页」，
    // 直连站点（localhost / 内网 / 裸 IP）的真实 favicon 被一路误杀到链尾；同时第三方
    // favicon 服务保留直连候选，导致 Google / DuckDuckGo 的占位图写进缓存。
    // 旧缓存里已存有假图标，全部作废重建。
    const logoResolverVersion = 7;
    const settingsLabels = defaultPayload.config?.settings ?? {};
    let newTabState = defaultState();
    let textColorSaveTimer = 0;
    let pageMetricsSaveTimer = 0;
    let shortcutLogoCache = {};
    let activeShortcutContextMenu = null;
    const shortcutLogoRequests = new Map();
    const onePanelLogoDataUrl = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 33 33" fill="#3370ff"><path d="M19.42 4.842 7.785 11.56v10.064l7.539 4.353-2.921 1.686-7.54-4.353V9.874L16.5 3.156z"/><path d="m20.598 5.522-2.921 1.686 7.539 4.352v10.064l2.92 1.686V9.874zM16.922 9.328l.892.532v13.666l-.892.515zM12.523 11.862l4.399-2.534-.002 14.714-2.848-1.644v-8.82h-1.549z"/><path fill-rule="evenodd" d="M3 8.796 16.5 1 30 8.796v15.592l-13.5 7.796L3 24.388zm26.64.208L16.5 1.417V1.41L3.357 8.997v15.182L16.5 31.772l13.141-7.587z" clip-rule="evenodd"/></svg>')}`;

    const isPlainObject = (value) =>
      value !== null && typeof value === "object" && !Array.isArray(value);

    const normalizeText = (value, fallback = "") =>
      typeof value === "string" && value.trim() ? value.trim() : fallback;

    const normalizeMaybeText = (value) =>
      typeof value === "string" && value.trim() ? value.trim() : undefined;

    const normalizeShortcutOpenMode = (value, fallback = "current") =>
      value === "newTab" || value === "current" ? value : fallback;

    const shortcutLayoutIds = ["grid", "stack", "ring", "scatter"];
    const fontFamilyIds = ["default", "serif", "kai", "rounded", "mono"];
    const blurIds = ["off", "soft", "medium", "strong", "dynamic"];

    const normalizeShortcutLayout = (value, fallback = "grid") =>
      shortcutLayoutIds.includes(value) ? value : fallback;

    const normalizeScatterSeed = (value, fallback = 1) => {
      const seed = Number(value);

      return Number.isFinite(seed) && seed > 0 ? Math.floor(seed) : fallback;
    };

    const normalizeTextColors = (value, fallback) => {
      const mode = isPlainObject(value) && ["default", "light", "dark"].includes(value.mode)
        ? value.mode
        : fallback.mode;

      return { mode };
    };

    const normalizeGreetings = (greetings, fallback) => {
      if (!Array.isArray(greetings)) {
        return cloneValue(fallback);
      }

      const normalized = greetings
        .map((item) => ({
          label: normalizeText(item?.label),
          from: Number(item?.from),
          to: Number(item?.to),
        }))
        .filter((item) =>
          item.label &&
          Number.isInteger(item.from) &&
          Number.isInteger(item.to) &&
          item.from >= 0 &&
          item.from <= 23 &&
          item.to >= 0 &&
          item.to <= 23
        );

      return normalized.length ? normalized : cloneValue(fallback);
    };

    const normalizeSearchEngines = (engines, fallback) => {
      if (!Array.isArray(engines)) {
        return cloneValue(fallback);
      }

      const ids = new Set();
      const normalized = engines
        .map((engine) => ({
          id: normalizeText(engine?.id),
          label: normalizeText(engine?.label),
          searchUrl: normalizeText(engine?.searchUrl),
        }))
        .filter((engine) => {
          if (!engine.id || !engine.label || !engine.searchUrl.includes("{query}") || ids.has(engine.id)) {
            return false;
          }

          ids.add(engine.id);
          return true;
        });

      return normalized.length ? normalized : cloneValue(fallback);
    };

    const normalizeShortcutGroups = (groups, fallback) => {
      if (!Array.isArray(groups)) {
        return cloneValue(fallback);
      }

      const normalized = groups
        .map((group) => ({
          title: normalizeText(group?.title),
          shortcuts: Array.isArray(group?.shortcuts)
            ? group.shortcuts
                .map((shortcut) => ({
                  title: normalizeText(shortcut?.title),
                  url: normalizeText(shortcut?.url),
                  description: normalizeMaybeText(shortcut?.description),
                  logo: normalizeMaybeText(shortcut?.logo),
                }))
                .filter((shortcut) => shortcut.title && shortcut.url)
            : [],
        }))
        .filter((group) => group.title);

      return normalized.length ? normalized : cloneValue(fallback);
    };

    // 同一份页面会挂在 hey-yx.com/portfolio 或本地预览下。
    // 首页链接按当前地址推算站点根，不写死域名和部署路径。
    const siteBase = (import.meta.env.BASE_URL || "/").replace(/\/+$/, "");
    const currentPath = window.location.pathname.replace(/\/+$/, "");
    const siteRoot = currentPath.endsWith("/new-tab")
      ? `${currentPath.slice(0, -"/new-tab".length)}/`.replace(/^\/\//, "/")
      : "/";
    // localStorage 里存过的旧根路径先退回站点内的相对路径，再挂到当前站点根
    const resolveBaseHref = (href) => {
      if (!href || !href.startsWith("/") || href.startsWith("//")) {
        return href;
      }

      let path = href;

      if (siteBase && (path === siteBase || path.startsWith(`${siteBase}/`))) {
        path = path.slice(siteBase.length) || "/";
      }

      if (path === "/") {
        return siteRoot;
      }

      return siteRoot === "/" ? path : `${siteRoot.replace(/\/$/, "")}${path}`;
    };

    const normalizeHomeLink = (homeLink, fallback) => {
      if (!isPlainObject(homeLink)) {
        return cloneValue(fallback);
      }

      return {
        label: normalizeText(homeLink.label, fallback.label),
        href: resolveBaseHref(normalizeText(homeLink.href, fallback.href)),
      };
    };

    const normalizeNewTabState = (value) => {
      const fallback = defaultState();

      if (!isPlainObject(value)) {
        return fallback;
      }

      const searchEngines = normalizeSearchEngines(value.searchEngines, fallback.searchEngines);
      const defaultSearchEngineId = normalizeText(
        value.defaultSearchEngineId ?? value.search?.defaultEngineId,
        fallback.defaultSearchEngineId,
      );

      return {
        version: configVersion,
        userName: normalizeText(value.userName, fallback.userName),
        backgroundImage: typeof value.backgroundImage === "string" ? value.backgroundImage.trim() : "",
        backgroundOpacity: Number.isFinite(Number(value.backgroundOpacity))
          ? Math.min(100, Math.max(0, Number(value.backgroundOpacity)))
          : fallback.backgroundOpacity,
        backgroundSource: value.backgroundSource === "bing" ? "bing" : "custom",
        wallpaperIndex: Number.isFinite(Number(value.wallpaperIndex))
          ? Math.min(7, Math.max(0, Math.floor(Number(value.wallpaperIndex))))
          : 0,
        groupColumns: [2, 3, 4].includes(Number(value.groupColumns)) ? Number(value.groupColumns) : 3,
        pageWidth: Number.isFinite(Number(value.pageWidth))
          ? Math.min(1920, Math.max(896, Math.round(Number(value.pageWidth))))
          : fallback.pageWidth,
        uiScale: Number.isFinite(Number(value.uiScale))
          ? Math.min(130, Math.max(85, Math.round(Number(value.uiScale))))
          : fallback.uiScale,
        fontFamily: fontFamilyIds.includes(value.fontFamily) ? value.fontFamily : "default",
        itemBlur: blurIds.includes(value.itemBlur) ? value.itemBlur : "medium",
        textColors: normalizeTextColors(value.textColors, fallback.textColors),
        defaultSearchEngineId: searchEngines.some((engine) => engine.id === defaultSearchEngineId)
          ? defaultSearchEngineId
          : searchEngines[0]?.id ?? fallback.defaultSearchEngineId,
        homeLink: normalizeHomeLink(value.homeLink, fallback.homeLink),
        shortcutOpenMode: normalizeShortcutOpenMode(value.shortcutOpenMode, fallback.shortcutOpenMode),
        greetings: normalizeGreetings(value.greetings, fallback.greetings),
        searchEngines,
        shortcutGroups: normalizeShortcutGroups(value.shortcutGroups, fallback.shortcutGroups),
        // 布局档位已下线，旧配置里的 ring/stack/scatter 一律归到索引
        shortcutLayout: "grid",
        scatterSeed: normalizeScatterSeed(value.scatterSeed),
        // 收起问候已下线，旧配置里残留的状态一律按展开处理
        headerCollapsed: false,
        headerSuspended: false,
      };
    };

    const readStoredState = () => {
      try {
        const storedConfig = window.localStorage.getItem(storageKey);

        if (!storedConfig) {
          return defaultState();
        }

        const parsedConfig = JSON.parse(storedConfig);
        const storedState = normalizeNewTabState(parsedConfig);

        if (Number(parsedConfig?.version ?? 1) < configVersion) {
          storedState.shortcutGroups = [];
          window.localStorage.setItem(storageKey, JSON.stringify(storedState));
        }

        if (
          Number(parsedConfig?.version ?? 1) < configVersion &&
          oldDefaultBackgroundOpacities.includes(storedState.backgroundOpacity)
        ) {
          storedState.backgroundOpacity = defaultBackgroundOpacity;
          window.localStorage.setItem(storageKey, JSON.stringify(storedState));
        }

        return storedState;
      } catch {
        return defaultState();
      }
    };

    const writeStoredState = () => {
      try {
        window.localStorage.setItem(storageKey, JSON.stringify(newTabState));
        return true;
      } catch (error) {
        if (error && error.name === "QuotaExceededError") {
          return false;
        }

        // The page still works with the in-memory config when storage is unavailable.
        return true;
      }
    };

    const readShortcutLogoCache = () => {
      try {
        const cache = JSON.parse(window.localStorage.getItem(logoCacheStorageKey) ?? "{}");

        return isPlainObject(cache) ? cache : {};
      } catch {
        return {};
      }
    };

    const writeShortcutLogoCache = () => {
      try {
        window.localStorage.setItem(logoCacheStorageKey, JSON.stringify(shortcutLogoCache));
      } catch {
        // Logo discovery is an enhancement; shortcuts still work without the cache.
      }
    };

    const getShortcutHostname = (url) => {
      try {
        return new URL(url).hostname.replace(/^www\./, "");
      } catch {
        return url;
      }
    };

    const getShortcutInitial = (title) => title.trim().slice(0, 1).toUpperCase();

    const normalizeShortcutUrlInput = (value) => {
      const url = normalizeText(value);

      if (!url) {
        return "";
      }

      if (/^(https?:|mailto:|tel:|\/|#)/i.test(url)) {
        return url;
      }

      return `https://${url}`;
    };

    const isValidShortcutUrl = (url) => {
      if (/^(\/|#)/.test(url)) {
        return true;
      }

      try {
        new URL(url);
        return true;
      } catch {
        return false;
      }
    };

    const focusFirstInput = (element) => {
      element.querySelector("input")?.focus();
    };

    const setInlineFormError = (target, message) => {
      target.textContent = message;
      target.classList.remove("hidden");
    };

    let inlineFormErrorSeq = 0;

    const createInlineFormError = () => {
      const error = document.createElement("p");
      error.id = `inline-form-error-${++inlineFormErrorSeq}`;
      error.className = "form-error hidden";
      error.setAttribute("role", "alert");
      return error;
    };

    // 报错时把字段标成 aria-invalid 并挂到错误文案上，读屏能念出「哪里错了」。
    const markFieldInvalid = (target, message, input) => {
      setInlineFormError(target, message);

      if (input instanceof HTMLElement) {
        input.setAttribute("aria-invalid", "true");
        input.setAttribute("aria-describedby", target.id);
      }
    };

    const clearInlineFormError = (target) => {
      target.textContent = "";
      target.classList.add("hidden");
    };

    // 轻提示：保存成功这类反馈不占布局，也不抢焦点。
    let newTabToastTimer = 0;

    const showNewTabToast = (message) => {
      const toast = document.querySelector("[data-new-tab-toast]");

      if (!(toast instanceof HTMLElement) || !message) {
        return;
      }

      toast.textContent = message;
      toast.hidden = false;
      window.clearTimeout(newTabToastTimer);
      window.requestAnimationFrame(() => {
        toast.setAttribute("data-visible", "");
      });
      newTabToastTimer = window.setTimeout(() => {
        toast.removeAttribute("data-visible");
        window.setTimeout(() => {
          if (!toast.hasAttribute("data-visible")) {
            toast.hidden = true;
          }
        }, 240);
      }, 2200);
    };

    const getIconMarkup = (name) => {
      const template = document.querySelector(`template[data-new-tab-icon="${name}"]`);

      return template instanceof HTMLTemplateElement ? template.innerHTML.trim() : "";
    };

    const createIconButton = (label, iconName, extraClasses = "") => {
      const button = document.createElement("button");
      button.className = `btn btn-square btn-ghost btn-xs h-8 min-h-8 w-8 p-0 text-ink-2 transition hover:text-base-content focus-visible:text-base-content [&_svg]:h-3.5 [&_svg]:w-3.5 ${extraClasses}`;
      button.type = "button";
      button.title = label;
      button.setAttribute("aria-label", label);
      button.innerHTML = getIconMarkup(iconName);
      return button;
    };

    const closeShortcutContextMenu = () => {
      const menu = activeShortcutContextMenu;

      if (!menu) {
        return;
      }

      // 先摘引用再播退场：二次调用直接跳过，避免连点触发多段动画。
      // remove 延后到动画结束，否则菜单会瞬间消失、没有收起的过程。
      activeShortcutContextMenu = null;

      if (menu.classList.contains("ntab-menu-vanish")) {
        menu.remove();
        return;
      }

      menu.classList.add("ntab-menu-vanish");
      window.setTimeout(() => menu.remove(), 140);
    };

    const getContextMenuPoint = (event, fallbackElement) => {
      if (event instanceof MouseEvent && Number.isFinite(event.clientX) && Number.isFinite(event.clientY)) {
        return {
          x: event.clientX,
          y: event.clientY,
        };
      }

      const rect = fallbackElement?.getBoundingClientRect();
      return {
        x: rect ? rect.left + rect.width / 2 : window.innerWidth / 2,
        y: rect ? rect.bottom + 8 : window.innerHeight / 2,
      };
    };

    const positionShortcutContextMenu = (menu, point) => {
      const margin = 12;
      const rect = menu.getBoundingClientRect();
      const maxLeft = Math.max(margin, window.innerWidth - rect.width - margin);
      const maxTop = Math.max(margin, window.innerHeight - rect.height - margin);

      menu.style.left = `${Math.min(Math.max(point.x, margin), maxLeft)}px`;
      menu.style.top = `${Math.min(Math.max(point.y, margin), maxTop)}px`;
    };

    const openShortcutContextMenu = ({ event, fallbackElement, title, subtitle, actions }) => {
      event?.preventDefault();
      event?.stopPropagation();
      closeShortcutContextMenu();

      const menu = document.createElement("div");
      menu.className = "shortcut-context-menu fixed z-[90] grid min-w-44 max-w-[18rem] gap-0.5 rounded-xl border border-base-content/10 bg-base-100/95 p-1.5 text-sm text-base-content shadow-[0_1px_2px_-1px_rgba(15,23,42,0.08),0_8px_16px_-8px_rgba(15,23,42,0.10),0_20px_40px_-20px_rgba(15,23,42,0.14)] outline-none backdrop-blur-sm";
      menu.setAttribute("role", "menu");
      menu.tabIndex = -1;

      const header = document.createElement("div");
      header.className = "grid border-b border-base-content/10 px-2 py-1.5";
      const headerText = document.createElement("span");
      headerText.className = "grid min-w-0 gap-0.5";
      const headerTitle = document.createElement("strong");
      headerTitle.className = "truncate text-xs font-bold leading-tight";
      headerTitle.textContent = title;
      headerText.append(headerTitle);

      if (subtitle) {
        const headerSubtitle = document.createElement("small");
        headerSubtitle.className = "truncate text-[0.68rem] font-semibold leading-tight text-ink-2";
        headerSubtitle.textContent = subtitle;
        headerText.append(headerSubtitle);
      }

      header.append(headerText);
      menu.append(header);

      actions.forEach((action) => {
        const button = document.createElement("button");
        button.className = action.danger
          ? "grid h-9 grid-cols-[1rem_minmax(0,1fr)] items-center gap-2 rounded-lg border-0 bg-transparent px-2 text-left text-error/85 transition-colors duration-150 hover:bg-error/10 focus-visible:bg-error/10 focus-visible:outline-none"
          : "grid h-9 grid-cols-[1rem_minmax(0,1fr)] items-center gap-2 rounded-lg border-0 bg-transparent px-2 text-left text-ink-2 transition-colors duration-150 hover:bg-base-200 focus-visible:bg-base-200 focus-visible:outline-none";
        button.type = "button";
        button.setAttribute("role", "menuitem");
        button.innerHTML = `<span class="grid h-4 w-4 place-items-center [&_svg]:h-3.5 [&_svg]:w-3.5">${getIconMarkup(action.icon)}</span><span class="truncate text-xs font-semibold">${action.label}</span>`;
        button.addEventListener("click", () => {
          closeShortcutContextMenu();
          action.onSelect();
        });
        menu.append(button);
      });

      document.body.append(menu);
      activeShortcutContextMenu = menu;
      positionShortcutContextMenu(menu, getContextMenuPoint(event, fallbackElement));
      menu.focus({ preventScroll: true });
    };

    const createShortcutEmptyState = () => {
      const empty = document.createElement("div");
      empty.className = "shortcut-empty";

      const title = document.createElement("p");
      title.className = "shortcut-empty__title";
      title.textContent = "还没有快捷入口";

      const hint = document.createElement("p");
      hint.className = "shortcut-empty__hint";
      hint.textContent = "先新建一个分组，再把常用的网站放进来。分组只用来归类，之后可以随时改名。";

      const action = document.createElement("button");
      action.className = "shortcut-empty__action";
      action.type = "button";
      action.innerHTML = `<span class="grid h-4 w-4 place-items-center [&_svg]:h-4 [&_svg]:w-4">${getIconMarkup("plus")}</span><span>${settingsLabels.addGroupLabel ?? "新建分组"}</span>`;
      action.addEventListener("click", () => {
        openGroupDialog({ mode: "create" });
      });

      empty.append(title, hint, action);
      return empty;
    };

    const bindShortcutContextMenuDismissal = () => {
      if (document.documentElement.dataset.newTabContextMenuBound === "true") {
        return;
      }

      document.addEventListener("pointerdown", (event) => {
        if (
          activeShortcutContextMenu &&
          event.target instanceof Node &&
          !activeShortcutContextMenu.contains(event.target)
        ) {
          closeShortcutContextMenu();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeShortcutContextMenu();
        }
      });

      window.addEventListener("resize", closeShortcutContextMenu);
      window.addEventListener("scroll", closeShortcutContextMenu, true);
      document.documentElement.dataset.newTabContextMenuBound = "true";
    };

    // 新建 / 修改分组走同一个弹窗。以前表单内联在空态和每组下方，既占标准流，
    // 又没有浮层的定位与焦点管理，看起来像「凭空多出一行」。
    let groupDialogApi = null;

    const createGroupDialog = () => {
      const dialog = document.createElement("dialog");
      dialog.className = "new-tab-dialog";
      dialog.id = "new-tab-group-dialog";
      dialog.setAttribute("aria-labelledby", "new-tab-group-dialog-title");

      const form = document.createElement("form");
      form.className = "new-tab-dialog__panel";
      form.noValidate = true;

      const header = document.createElement("div");
      header.className = "new-tab-dialog__header flex items-start justify-between gap-3";
      const headerText = document.createElement("div");
      headerText.className = "min-w-0";
      const heading = document.createElement("h2");
      heading.id = "new-tab-group-dialog-title";
      heading.textContent = settingsLabels.groupDialogCreateTitle ?? "新建分组";
      const subtitle = document.createElement("p");
      subtitle.textContent = settingsLabels.groupDialogHint ?? "分组只用来归类站点，创建后可以随时改名。";
      headerText.append(heading, subtitle);

      const dismissButton = document.createElement("button");
      dismissButton.className = "btn btn-square btn-ghost btn-sm h-8 min-h-8 w-8 shrink-0 p-0 text-ink-2 transition hover:text-base-content";
      dismissButton.type = "button";
      dismissButton.setAttribute("aria-label", settingsLabels.closeLabel ?? "关闭");
      dismissButton.title = settingsLabels.closeLabel ?? "关闭";
      dismissButton.innerHTML = getIconMarkup("close");
      header.append(headerText, dismissButton);

      const fields = document.createElement("div");
      fields.className = "new-tab-dialog__body";

      const field = document.createElement("label");
      field.className = "field-row";
      const fieldLabel = document.createElement("span");
      fieldLabel.className = "field-label";
      fieldLabel.textContent = settingsLabels.groupTitleLabel ?? "分组名";
      const input = document.createElement("input");
      input.className = "input input-bordered";
      input.type = "text";
      input.autocomplete = "off";
      input.placeholder = settingsLabels.groupNamePlaceholder ?? "例如：工作、工具、常看的站";
      input.setAttribute("aria-label", settingsLabels.groupTitleLabel ?? "分组名");
      const error = createInlineFormError();
      field.append(fieldLabel, input, error);
      fields.append(field);

      const footer = document.createElement("div");
      footer.className = "new-tab-dialog__footer";
      const cancelButton = document.createElement("button");
      cancelButton.className = "btn btn-ghost btn-sm";
      cancelButton.type = "button";
      cancelButton.textContent = "取消";
      const submitButton = document.createElement("button");
      submitButton.className = "btn btn-primary btn-sm";
      submitButton.type = "submit";
      submitButton.textContent = settingsLabels.groupCreateSubmitLabel ?? "创建";
      footer.append(cancelButton, submitButton);

      form.append(header, fields, footer);
      dialog.append(form);

      let editorMode = "create";
      let editingGroup = null;
      let createdCallback = null;
      let savedCallback = null;
      let returnFocus = null;

      const applyMode = ({ mode = "create", group = null, onCreated = null, onSaved = null } = {}) => {
        editorMode = mode;
        editingGroup = mode === "edit" ? group : null;
        createdCallback = onCreated;
        savedCallback = onSaved;

        const editing = editorMode === "edit" && editingGroup;
        heading.textContent = editing
          ? (settingsLabels.groupDialogEditTitle ?? "修改分组")
          : (settingsLabels.groupDialogCreateTitle ?? "新建分组");
        subtitle.textContent = settingsLabels.groupDialogHint ?? "分组只用来归类站点，创建后可以随时改名。";
        submitButton.textContent = editing
          ? (settingsLabels.groupSaveSubmitLabel ?? "保存")
          : (settingsLabels.groupCreateSubmitLabel ?? "创建");
        input.value = editing ? editingGroup.title : "";
        clearInlineFormError(error);
        input.removeAttribute("aria-invalid");
      };

      const restoreReturnFocus = () => {
        const target = returnFocus;
        returnFocus = null;

        if (target instanceof HTMLElement && target.isConnected) {
          window.requestAnimationFrame(() => {
            target.focus({ preventScroll: true });
          });
        }
      };

      const dismiss = () => {
        dialog.close();
        document.querySelector("[data-group-add]")?.setAttribute("aria-expanded", "false");
        restoreReturnFocus();
      };

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        dismiss();
      });

      dismissButton.addEventListener("click", dismiss);
      cancelButton.addEventListener("click", dismiss);

      let backdropPointerDown = false;

      dialog.addEventListener("pointerdown", (event) => {
        backdropPointerDown = event.target === dialog;
      });

      dialog.addEventListener("click", (event) => {
        if (backdropPointerDown && event.target === dialog) {
          backdropPointerDown = false;
          dismiss();
        }
      });

      input.addEventListener("input", () => {
        clearInlineFormError(error);
        input.removeAttribute("aria-invalid");
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const title = normalizeText(input.value);

        if (!title) {
          markFieldInvalid(error, "先输入分组名", input);
          input.focus();
          return;
        }

        const duplicate = newTabState.shortcutGroups.find((item) => item !== editingGroup && item.title === title);

        if (duplicate) {
          markFieldInvalid(error, settingsLabels.groupDuplicateError ?? "已有同名分组", input);
          input.focus();
          return;
        }

        if (editorMode === "edit" && editingGroup) {
          const previousTitle = editingGroup.title;
          editingGroup.title = title;
          if (lastShortcutAddGroupTitle === previousTitle) {
            lastShortcutAddGroupTitle = title;
          }
          persistConfigChange("已修改");
          returnFocus = null;
          dismiss();
          showNewTabToast("分组已改名");
          savedCallback?.(editingGroup);
          window.requestAnimationFrame(() => {
            const renamedSection = document.querySelector(`[data-group-title="${CSS.escape(title)}"]`);
            renamedSection?.querySelector(".shortcut-group__menu")?.focus({ preventScroll: true });
          });
          return;
        }

        const group = { title, shortcuts: [] };
        newTabState.shortcutGroups.push(group);
        persistConfigChange("已添加");
        returnFocus = null;
        dismiss();
        showNewTabToast(`已创建「${title}」`);

        if (createdCallback) {
          createdCallback(group);
        }
      });

      const open = (options = {}) => {
        applyMode(options);

        if (!dialog.isConnected) {
          document.body.append(dialog);
        }

        if (!dialog.open) {
          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          document.querySelector("[data-group-add]")?.setAttribute("aria-expanded", "true");
          dialog.showModal();
        }

        input.focus({ preventScroll: true });
        input.select();
      };

      return { dialog, open };
    };

    const openGroupDialog = (options = {}) => {
      if (!groupDialogApi) {
        groupDialogApi = createGroupDialog();
      }

      groupDialogApi.open(options);
    };

    // 记住上次加进哪个分组，下次从工具栏进来默认还是它
    let lastShortcutAddGroupTitle = "";

    // 添加站点弹窗：单实例原生 <dialog>，首次打开时挂到 body。
    // 以前这块表单插在快捷方式区顶部，占整整一行、把下面的分组顶开，看起来像浮层
    // 却没有浮层的定位（用户原话「还占用标准流位置」）。showModal() 进顶层后
    // 不参与页面布局，自带焦点陷阱与 Esc 关闭，背景滚动也不受影响。
    let shortcutAddDialogApi = null;

    const createShortcutAddForm = () => {
      const dialog = document.createElement("dialog");
      dialog.className = "new-tab-dialog";
      dialog.id = "new-tab-add-dialog";
      dialog.setAttribute("aria-labelledby", "new-tab-add-dialog-title");

      const form = document.createElement("form");
      form.className = "new-tab-dialog__panel";
      form.noValidate = true;

      const header = document.createElement("div");
      header.className = "new-tab-dialog__header flex items-start justify-between gap-3";
      const headerText = document.createElement("div");
      headerText.className = "min-w-0";
      const heading = document.createElement("h2");
      heading.className = "m-0 text-[0.95rem] font-bold leading-tight";
      heading.id = "new-tab-add-dialog-title";
      heading.textContent = settingsLabels.addShortcutLabel ?? "添加站点";
      const subtitle = document.createElement("p");
      subtitle.className = "mt-1 truncate text-xs leading-snug text-ink-2";
      headerText.append(heading, subtitle);
      const dismissButton = document.createElement("button");
      dismissButton.className = "btn btn-square btn-ghost btn-sm h-8 min-h-8 w-8 shrink-0 p-0 text-ink-2 transition hover:text-base-content";
      dismissButton.type = "button";
      dismissButton.setAttribute("aria-label", "关闭");
      dismissButton.title = "关闭";
      dismissButton.innerHTML = getIconMarkup("close");
      header.append(headerText, dismissButton);

      const fields = document.createElement("div");
      fields.className = "new-tab-dialog__body grid min-w-0 content-start gap-4";

      let targetGroup = null;
      let shortcutMetadataRequestId = 0;
      let shortcutMetadataTimer = 0;
      let shortcutMetadata = null;

      const syncAddTarget = () => {
        if (!targetGroup) {
          return;
        }

        subtitle.textContent = `加进「${targetGroup.title}」`;
        lastShortcutAddGroupTitle = targetGroup.title;
      };

      // 分组选择始终显示：它同时是「加进哪一组」和「现场新建一组」的入口
      const groupField = document.createElement("div");
      groupField.className = "field-row";
      const groupHead = document.createElement("div");
      groupHead.className = "field-head";
      const groupFieldLabel = document.createElement("span");
      groupFieldLabel.className = "field-label";
      groupFieldLabel.textContent = settingsLabels.addShortcutToGroupLabel ?? "所属分组";
      const groupCreateButton = document.createElement("button");
      groupCreateButton.className = "inline-link";
      groupCreateButton.type = "button";
      groupCreateButton.textContent = `+ ${settingsLabels.addShortcutNewGroupLabel ?? "新建分组"}`;
      groupHead.append(groupFieldLabel, groupCreateButton);
      const groupSelect = document.createElement("select");
      groupSelect.className = "select select-bordered";
      groupSelect.setAttribute("aria-label", settingsLabels.addShortcutToGroupLabel ?? "所属分组");
      groupField.append(groupHead, groupSelect);
      groupField.style.display = "none";
      groupSelect.addEventListener("change", () => {
        targetGroup = newTabState.shortcutGroups[Number(groupSelect.value)] ?? targetGroup;
        syncAddTarget();
      });

      const rebuildGroupOptions = (selectedTitle = targetGroup?.title ?? "") => {
        const groups = newTabState.shortcutGroups;
        const selected = targetGroup && groups.includes(targetGroup)
          ? targetGroup
          : groups.find((item) => item.title === selectedTitle) ?? groups[0];
        groupSelect.textContent = "";
        groups.forEach((item, index) => {
          const option = document.createElement("option");
          option.value = String(index);
          option.textContent = item.title;
          groupSelect.append(option);
        });
        groupSelect.value = String(Math.max(0, groups.indexOf(selected)));
        targetGroup = selected ?? null;
        groupField.style.display = groups.length ? "grid" : "none";
        syncAddTarget();
      };

      groupCreateButton.addEventListener("click", () => {
        openGroupDialog({
          mode: "create",
          onCreated: (group) => {
            targetGroup = group;
            lastShortcutAddGroupTitle = group.title;
            rebuildGroupOptions(group.title);
            groupSelect.focus();
          },
        });
      });

      // 图标预览：地址解析出 logo 前先显示站点首字母，拿到后真实透出 favicon
      const preview = document.createElement("div");
      preview.className = "flex items-center gap-2.5";
      const previewIcon = document.createElement("span");
      previewIcon.className = "shortcut-item__icon relative grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-md border border-base-content/10 bg-base-200/60";
      previewIcon.setAttribute("aria-hidden", "true");
      const previewImage = document.createElement("img");
      previewImage.className = "hidden h-full w-full object-contain p-[0.3rem]";
      previewImage.alt = "";
      previewImage.referrerPolicy = "no-referrer";
      const previewInitial = document.createElement("span");
      previewInitial.className = "text-[0.95rem] font-bold leading-none text-ink-2";
      previewInitial.textContent = "站";
      previewIcon.append(previewImage, previewInitial);
      const previewText = document.createElement("div");
      previewText.className = "grid min-w-0 gap-0.5";
      const previewTitle = document.createElement("p");
      previewTitle.className = "m-0 truncate text-[0.82rem] font-medium leading-tight";
      previewTitle.textContent = "新站点";
      const previewHint = document.createElement("p");
      previewHint.className = "m-0 truncate text-[0.72rem] leading-tight text-ink-2";
      previewHint.textContent = "填地址后自动识别名称与图标";
      previewText.append(previewTitle, previewHint);
      preview.append(previewIcon, previewText);
      fields.append(preview);

      const resetPreview = () => {
        previewImage.classList.add("hidden");
        previewImage.removeAttribute("src");
        previewInitial.classList.remove("hidden");
        previewInitial.textContent = "站";
        previewTitle.textContent = "新站点";
        previewHint.textContent = "填地址后自动识别名称与图标";
      };

      const fieldRow = (labelText, inputEl) => {
        const row = document.createElement("label");
        row.className = "grid min-w-0 gap-1.5";
        const rowLabel = document.createElement("span");
        rowLabel.className = "text-[0.72rem] font-medium text-ink-2";
        rowLabel.textContent = labelText;
        row.append(rowLabel, inputEl);
        return row;
      };

      const titleInput = document.createElement("input");
      titleInput.className = "input input-bordered input-sm h-9 min-h-9 w-full min-w-0 bg-base-100 text-xs";
      titleInput.type = "text";
      titleInput.autocomplete = "off";
      titleInput.setAttribute("aria-label", settingsLabels.shortcutTitleLabel ?? "名称");
      titleInput.placeholder = "留空自动识别";

      const urlInput = document.createElement("input");
      urlInput.className = "input input-bordered input-sm h-9 min-h-9 w-full min-w-0 bg-base-100 text-xs";
      urlInput.type = "text";
      urlInput.inputMode = "url";
      urlInput.autocomplete = "off";
      urlInput.setAttribute("aria-label", settingsLabels.shortcutUrlLabel ?? "地址");
      urlInput.placeholder = "example.com";

      const error = createInlineFormError();
      // 先地址后名称：贴地址进来的用户不用先跳过名称；解析出的标题会自动填回名称框
      fields.append(fieldRow(settingsLabels.shortcutUrlLabel ?? "地址", urlInput));
      fields.append(fieldRow(settingsLabels.shortcutTitleLabel ?? "名称", titleInput));
      fields.append(groupField, error);

      form.addEventListener("input", (event) => {
        if (event.target instanceof HTMLElement) {
          event.target.removeAttribute("aria-invalid");
        }
      });

      const footer = document.createElement("div");
      footer.className = "new-tab-dialog__footer flex items-center justify-end gap-1.5";
      const cancelButton = document.createElement("button");
      cancelButton.className = "btn btn-ghost btn-sm h-8 min-h-8 px-3 text-xs text-ink-2 transition hover:text-base-content";
      cancelButton.type = "button";
      cancelButton.textContent = "取消";
      const submitButton = document.createElement("button");
      submitButton.className = "btn btn-sm h-8 min-h-8 border-0 bg-base-content px-4 text-xs text-base-100 transition hover:bg-base-content/85 focus-visible:bg-base-content/85";
      submitButton.type = "submit";
      submitButton.textContent = "添加";
      footer.append(cancelButton, submitButton);

      const applyShortcutMetadata = (metadata) => {
        shortcutMetadata = metadata;

        // 图标预览跟随解析结果
        const logoUrl = metadata?.logoUrl ?? metadata?.candidates?.[0] ?? "";
        if (logoUrl) {
          previewImage.src = logoUrl;
          previewImage.classList.remove("hidden");
          previewInitial.classList.add("hidden");
        }

        // 预览标题同步（用户已填名称时不抢）
        if (!normalizeText(titleInput.value)) {
          const suggestedTitle = metadata?.title || getShortcutHostname(normalizeShortcutUrlInput(urlInput.value));

          if (suggestedTitle) {
            titleInput.value = suggestedTitle;
            previewTitle.textContent = suggestedTitle;
            clearInlineFormError(error);
          }
        } else {
          previewTitle.textContent = normalizeText(titleInput.value);
        }
      };

      const syncShortcutMetadata = () => {
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url || !isValidShortcutUrl(url) || !isRemoteUrl(url)) {
          return Promise.resolve(null);
        }

        const requestId = shortcutMetadataRequestId + 1;
        shortcutMetadataRequestId = requestId;

        return fetchShortcutMetadata({ url }).then((metadata) => {
          if (requestId !== shortcutMetadataRequestId || normalizeShortcutUrlInput(urlInput.value) !== url) {
            return null;
          }

          applyShortcutMetadata(metadata);
          return metadata;
        });
      };

      const scheduleShortcutMetadataSync = () => {
        window.clearTimeout(shortcutMetadataTimer);
        shortcutMetadataTimer = window.setTimeout(syncShortcutMetadata, 550);
      };

      // 弹窗自己就是关闭入口，不再需要重渲染列表来「收掉表单」
      const dismiss = () => {
        dialog.close();
      };

      dismissButton.addEventListener("click", dismiss);
      cancelButton.addEventListener("click", dismiss);

      // 点遮罩关闭：面板在 form 里，事件目标落在 dialog 本身才算点到外面。
      // 起点也必须在遮罩上：输入框里选中文字、拖到框外松手不该把弹窗关掉。
      let backdropPointerDown = false;

      dialog.addEventListener("pointerdown", (event) => {
        backdropPointerDown = event.target === dialog;
      });

      dialog.addEventListener("click", (event) => {
        if (backdropPointerDown && event.target === dialog) {
          backdropPointerDown = false;
          dismiss();
        }
      });

      titleInput.addEventListener("input", () => {
        previewTitle.textContent = normalizeText(titleInput.value) || "新站点";
        previewInitial.textContent = getShortcutInitial(titleInput.value) || "?";
        clearInlineFormError(error);
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url) {
          markFieldInvalid(error, "先输入地址", urlInput);
          urlInput.focus();
          return;
        }

        if (!isValidShortcutUrl(url)) {
          markFieldInvalid(error, "地址格式不对", urlInput);
          urlInput.focus();
          return;
        }

        let title = normalizeText(titleInput.value);
        let metadata = shortcutMetadata;

        if (isRemoteUrl(url) && !metadata) {
          submitButton.disabled = true;
          setInlineFormError(error, title ? "正在解析图标" : "正在解析标题");
          metadata = await syncShortcutMetadata();
          title = normalizeText(titleInput.value, metadata?.title ?? "");
          submitButton.disabled = false;
        }

        if (!title) {
          markFieldInvalid(error, "先输入名称", titleInput);
          titleInput.focus();
          return;
        }

        if (!targetGroup) {
          return;
        }

        const logo = metadata?.logoUrl;
        const description = metadata?.description;
        targetGroup.shortcuts.push({
          title,
          url,
          ...(description ? { description } : {}),
          ...(logo ? { logo } : {}),
        });
        dialog.close();
        persistConfigChange("已添加");
        showNewTabToast(`已添加「${title}」`);
      });

      // 地址框回车：先去补名称（元数据还没到就停在原地），别直接提交半成品
      urlInput.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") {
          return;
        }
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (url && isValidShortcutUrl(url) && !normalizeText(titleInput.value)) {
          event.preventDefault();
          titleInput.focus();
        }
      });

      urlInput.addEventListener("input", () => {
        shortcutMetadata = null;
        resetPreview();
        scheduleShortcutMetadataSync();
      });
      urlInput.addEventListener("blur", syncShortcutMetadata);
      urlInput.addEventListener("change", syncShortcutMetadata);

      form.append(header, fields, footer);
      dialog.append(form);

      const openFor = (group) => {
        const groups = newTabState.shortcutGroups;
        const target = group && groups.includes(group)
          ? group
          : groups.find((item) => item.title === lastShortcutAddGroupTitle) ?? groups[0];

        if (!target) {
          return;
        }

        targetGroup = target;

        // 已经开着就只切目标分组、送回焦点，不把用户填了一半的内容清掉
        if (dialog.open) {
          if (group) {
            groupSelect.value = String(Math.max(0, groups.indexOf(group)));
            syncAddTarget();
          }
          focusFirstInput(form);
          return;
        }

        // 每次打开都从干净状态开始：上次的输入、报错、图标解析结果都不带进来
        titleInput.value = "";
        urlInput.value = "";
        clearInlineFormError(error);
        shortcutMetadata = null;
        shortcutMetadataRequestId += 1;
        window.clearTimeout(shortcutMetadataTimer);
        resetPreview();

        // 分组可能在两次打开之间增删，选项和当前分组都按数据重算
        rebuildGroupOptions(target.title);

        if (!dialog.isConnected) {
          document.body.append(dialog);
        }

        dialog.showModal();
        urlInput.focus();
      };

      return { dialog, openFor };
    };

    // 添加入口只有工具栏一处（原先挂在每组末尾、悬停才浮现的「+」瓦片已去掉）。
    // 表单是弹窗，不再插进快捷方式区；重复点只切目标分组并送回焦点。
    const openShortcutAddForm = (group) => {
      if (!shortcutAddDialogApi) {
        shortcutAddDialogApi = createShortcutAddForm();
      }

      shortcutAddDialogApi.openFor(group);
    };

    // 修改站点同样走弹窗：内联表单会把 96px 的瓦片撑成一张大表单，
    // 周围卡片被迫重排，视觉上像页面坏了。
    let shortcutEditDialogApi = null;

    const createShortcutEditDialog = () => {
      const dialog = document.createElement("dialog");
      dialog.className = "new-tab-dialog";
      dialog.id = "new-tab-edit-dialog";
      dialog.setAttribute("aria-labelledby", "new-tab-edit-dialog-title");

      const form = document.createElement("form");
      form.className = "new-tab-dialog__panel";
      form.noValidate = true;

      const header = document.createElement("div");
      header.className = "new-tab-dialog__header flex items-start justify-between gap-3";
      const headerText = document.createElement("div");
      headerText.className = "min-w-0";
      const heading = document.createElement("h2");
      heading.id = "new-tab-edit-dialog-title";
      heading.textContent = "修改站点";
      const subtitle = document.createElement("p");
      subtitle.className = "truncate";
      headerText.append(heading, subtitle);

      const dismissButton = document.createElement("button");
      dismissButton.className = "btn btn-square btn-ghost btn-sm h-8 min-h-8 w-8 shrink-0 p-0 text-ink-2 transition hover:text-base-content";
      dismissButton.type = "button";
      dismissButton.setAttribute("aria-label", settingsLabels.closeLabel ?? "关闭");
      dismissButton.title = settingsLabels.closeLabel ?? "关闭";
      dismissButton.innerHTML = getIconMarkup("close");
      header.append(headerText, dismissButton);

      const fields = document.createElement("div");
      fields.className = "new-tab-dialog__body";

      const createField = (labelText, input) => {
        const field = document.createElement("label");
        field.className = "field-row";
        const label = document.createElement("span");
        label.className = "field-label";
        label.textContent = labelText;
        field.append(label, input);
        return field;
      };

      const titleInput = document.createElement("input");
      titleInput.className = "input input-bordered";
      titleInput.type = "text";
      titleInput.autocomplete = "off";
      titleInput.setAttribute("aria-label", settingsLabels.shortcutTitleLabel ?? "名称");

      const urlInput = document.createElement("input");
      urlInput.className = "input input-bordered";
      urlInput.type = "text";
      urlInput.inputMode = "url";
      urlInput.autocomplete = "off";
      urlInput.setAttribute("aria-label", settingsLabels.shortcutUrlLabel ?? "地址");

      const descriptionInput = document.createElement("input");
      descriptionInput.className = "input input-bordered";
      descriptionInput.type = "text";
      descriptionInput.autocomplete = "off";
      descriptionInput.setAttribute("aria-label", settingsLabels.shortcutDescriptionLabel ?? "说明");
      descriptionInput.placeholder = "可留空，默认显示域名";

      const logoInput = document.createElement("input");
      logoInput.className = "input input-bordered";
      logoInput.type = "text";
      logoInput.inputMode = "url";
      logoInput.autocomplete = "off";
      logoInput.setAttribute("aria-label", settingsLabels.shortcutLogoLabel ?? "图标 URL");
      logoInput.placeholder = "可留空，自动抓取";

      const error = createInlineFormError();

      fields.append(
        createField(settingsLabels.shortcutUrlLabel ?? "地址", urlInput),
        createField(settingsLabels.shortcutTitleLabel ?? "名称", titleInput),
        createField(settingsLabels.shortcutDescriptionLabel ?? "说明", descriptionInput),
        createField(settingsLabels.shortcutLogoLabel ?? "图标 URL", logoInput),
        error,
      );

      const footer = document.createElement("div");
      footer.className = "new-tab-dialog__footer";
      const cancelButton = document.createElement("button");
      cancelButton.className = "btn btn-ghost btn-sm";
      cancelButton.type = "button";
      cancelButton.textContent = "取消";
      const submitButton = document.createElement("button");
      submitButton.className = "btn btn-primary btn-sm";
      submitButton.type = "submit";
      submitButton.textContent = "保存";
      footer.append(cancelButton, submitButton);

      form.append(header, fields, footer);
      dialog.append(form);

      let editingGroup = null;
      let editingShortcut = null;
      let metadata = null;
      let metadataRequestId = 0;

      const syncMetadata = () => {
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url || !isValidShortcutUrl(url) || !isRemoteUrl(url)) {
          return Promise.resolve(null);
        }

        const requestId = metadataRequestId + 1;
        metadataRequestId = requestId;

        return fetchShortcutMetadata({ url }).then((result) => {
          if (requestId !== metadataRequestId || normalizeShortcutUrlInput(urlInput.value) !== url) {
            return null;
          }

          metadata = result;

          if (!normalizeText(titleInput.value) && result?.title) {
            titleInput.value = result.title;
          }

          if (!normalizeText(logoInput.value) && result?.logoUrl) {
            logoInput.value = result.logoUrl;
          }

          if (!normalizeText(descriptionInput.value) && result?.description) {
            descriptionInput.value = result.description;
          }

          return result;
        });
      };

      const dismiss = () => {
        dialog.close();
      };

      dismissButton.addEventListener("click", dismiss);
      cancelButton.addEventListener("click", dismiss);

      let backdropPointerDown = false;

      dialog.addEventListener("pointerdown", (event) => {
        backdropPointerDown = event.target === dialog;
      });

      dialog.addEventListener("click", (event) => {
        if (backdropPointerDown && event.target === dialog) {
          backdropPointerDown = false;
          dismiss();
        }
      });

      form.addEventListener("input", (event) => {
        if (event.target instanceof HTMLElement) {
          event.target.removeAttribute("aria-invalid");
        }
        clearInlineFormError(error);
      });

      urlInput.addEventListener("input", () => {
        metadata = null;
      });
      urlInput.addEventListener("blur", syncMetadata);

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const url = normalizeShortcutUrlInput(urlInput.value);

        if (!url) {
          markFieldInvalid(error, "先输入地址", urlInput);
          urlInput.focus();
          return;
        }

        if (!isValidShortcutUrl(url)) {
          markFieldInvalid(error, "地址格式不对", urlInput);
          urlInput.focus();
          return;
        }

        let title = normalizeText(titleInput.value);

        if (isRemoteUrl(url) && (!title || !normalizeText(logoInput.value))) {
          submitButton.disabled = true;
          setInlineFormError(error, title ? "正在解析图标" : "正在解析标题");
          await syncMetadata();
          title = normalizeText(titleInput.value, metadata?.title ?? "");
          submitButton.disabled = false;
        }

        if (!title) {
          markFieldInvalid(error, "先输入名称", titleInput);
          titleInput.focus();
          return;
        }

        if (!editingGroup || !editingShortcut) {
          dialog.close();
          return;
        }

        editingShortcut.title = title;
        editingShortcut.url = url;

        const description = normalizeText(descriptionInput.value, metadata?.description ?? "");
        const logo = normalizeText(logoInput.value, metadata?.logoUrl ?? "");

        if (description) {
          editingShortcut.description = description;
        } else {
          delete editingShortcut.description;
        }

        if (logo) {
          editingShortcut.logo = logo;
        } else {
          delete editingShortcut.logo;
        }

        const savedTitle = title;
        dialog.close();
        persistConfigChange("已修改");
        showNewTabToast(`已保存「${savedTitle}」`);
      });

      const openFor = (group, shortcut) => {
        editingGroup = group;
        editingShortcut = shortcut;
        metadata = null;
        metadataRequestId += 1;
        subtitle.textContent = `在「${group.title}」里`;
        titleInput.value = shortcut.title;
        urlInput.value = shortcut.url;
        descriptionInput.value = shortcut.description ?? "";
        logoInput.value = shortcut.logo ?? "";
        clearInlineFormError(error);
        [titleInput, urlInput, descriptionInput, logoInput].forEach((input) => {
          input.removeAttribute("aria-invalid");
        });

        if (!dialog.isConnected) {
          document.body.append(dialog);
        }

        if (!dialog.open) {
          dialog.showModal();
        }

        titleInput.focus({ preventScroll: true });
        titleInput.select();
      };

      return { dialog, openFor };
    };

    const openShortcutEditDialog = (group, shortcut) => {
      if (!shortcutEditDialogApi) {
        shortcutEditDialogApi = createShortcutEditDialog();
      }

      shortcutEditDialogApi.openFor(group, shortcut);
    };

    const dragHandleIcon = getIconMarkup("drag");

    // 代理地址固定带斜杠，与 unwrapProxyUrl 的 pathname === "/" 判定保持一致
    const getProxyUrl = (url) => buildMetaProxyUrl(url);

    // 旧版本把「当前成功加载的地址」原样写进了缓存，而候选链第一条本来就是代理地址，
    // 于是缓存里存的是代理地址；下次读出来再 pushLogoCandidate 就又套一层代理，
    // 代理请求代理自身域名，Worker 侧固定 522。这里统一剥掉代理前缀再进候选链。
    // 按 host + pathname 判定，字符串前缀比对会因带不带斜杠而漏。
    const unwrapProxyUrl = (url) => {
      if (!url) {
        return url;
      }

      let current = url;

      for (let round = 0; round < 4; round += 1) {
        let parsed;
        try {
          parsed = new URL(current);
        } catch {
          return current;
        }

        const isProxySelf = parsed.origin === META_PROXY_ORIGIN && parsed.pathname === "/";
        const inner = isProxySelf ? parsed.searchParams.get("url") : null;

        if (!inner) {
          return current;
        }

        current = inner;
      }

      return current;
    };

    const isRemoteUrl = (value) => /^https?:\/\//i.test(value);

    const getShortcutLogoCacheKey = (url) => {
      try {
        return new URL(url).origin;
      } catch {
        return url;
      }
    };

    // 与 cloudflare-worker/newtab-meta-proxy.js 的黑名单保持一致：
    // 环回（127./0.）、链路本地（169.254.）在客户端就要挡掉，
    // 否则内网站点会先发一次注定被 Worker 拒绝的请求，日志里平白多一条 400。
    //
    // 注意这里不再挡裸 IP：Cloudflare 会拦「Worker 去 fetch 的目标是 IP 字面量」的请求
    // （error 1003），但那是 Worker 发出去之后才发生的，客户端无法预判；
    // 而且确实存在能通的 IP（Cloudflare 自家的 1.1.1.1 实测 200），
    // 所以在客户端一律放行，让请求真正发出去，由实际结果决定成败。
    // 代价是 101.35.226.231:8090 这类面板每次会白发一次注定 403 的代理请求，
    // 但它本来就只能靠直连或域名代名取图（见 resolveIpLiteralFallbackUrls）。
    const canProxyUrl = (url) => {
      try {
        const { protocol, hostname } = new URL(url);

        // 非 http(s) 地址（如 data: 内置图标）不要往代理送
        if (protocol !== "http:" && protocol !== "https:") {
          return false;
        }

        const normalizedHost = hostname.toLowerCase().replace(/^\[|\]$/g, "");

        if (
          normalizedHost === "localhost" ||
          normalizedHost === "::1" ||
          normalizedHost === "0:0:0:0:0:0:0:1" ||
          normalizedHost.endsWith(".local") ||
          normalizedHost.endsWith(".lan") ||
          normalizedHost.startsWith("127.") ||
          normalizedHost.startsWith("0.") ||
          normalizedHost.startsWith("10.") ||
          normalizedHost.startsWith("192.168.") ||
          normalizedHost.startsWith("169.254.")
        ) {
          return false;
        }

        const private172Match = normalizedHost.match(/^172\.(\d+)\./);
        if (private172Match && Number(private172Match[1]) >= 16 && Number(private172Match[1]) <= 31) {
          return false;
        }

        return true;
      } catch {
        return false;
      }
    };

    const resolveShortcutAssetUrl = (assetUrl, baseUrl) => {
      if (!assetUrl) {
        return "";
      }

      if (/^[a-z]+:/i.test(assetUrl)) {
        return assetUrl;
      }

      try {
        return new URL(assetUrl, baseUrl).href;
      } catch {
        return assetUrl;
      }
    };

    const pushLogoCandidate = (candidates, url, withProxy = true, proxyOnly = false) => {
      if (!url || candidates.includes(url)) {
        return;
      }

      if (withProxy && canProxyUrl(url)) {
        const proxyUrl = getProxyUrl(url);
        if (!candidates.includes(proxyUrl)) {
          candidates.push(proxyUrl);
        }

        // proxyOnly 用于第三方 favicon 服务：它们的目标域名不带 CORS 头，
        // 直连版加载成功后无法复核 content-type，占位图会被误判成真实图标。
        if (proxyOnly) {
          return;
        }
      }

      candidates.push(url);
    };

    const pushLogoCandidates = (candidates, urls, withProxy = true) => {
      urls.forEach((url) => {
        pushLogoCandidate(candidates, url, withProxy);
      });
    };

    const getCachedShortcutLogo = (shortcut) => {
      const cached = shortcutLogoCache[getShortcutLogoCacheKey(shortcut.url)];

      return isPlainObject(cached) ? cached : undefined;
    };

    // 取站点地址所在的目录（保留协议、端口与路径前缀），用于按目录试 favicon。
    // 例：https://1panel.itcox.cn:15660/ccd1a10224/ → 同址；.../ccd1a10224 → 补尾斜杠的目录。
    const resolveShortcutDirectoryUrl = (url) => {
      try {
        const parsed = new URL(url);
        const path = parsed.pathname.replace(/\/[^/]*$/, "/");

        return `${parsed.origin}${path}`;
      } catch {
        return "";
      }
    };

    // 1Panel 的图标路径与守卫页特征是已知的，主机名带 panel 或安全入口样式时按 1Panel 处理；
    // 这里只做路径补充，最终能否取到仍由候选链逐条试。
    const isOnePanelHost = (hostname) =>
      /(^|\.)1?panel\./i.test(hostname) || /(^|\.)panel\./i.test(hostname);

    // 裸 IP 站点（http://101.35.226.231:8090/ 这类面板）有一条死结：
    // new-tab 自己是 https 页面，浏览器直接拦掉所有 http:// 直连候选，不发请求；
    // 而走 meta.itcox.cn 代理时，Cloudflare 又对「目标是 IP 字面量」一律回 1003。
    // 两条路都断了，只剩「换成域名再走代理」这一条——实测 http://itcox.cn:8090/public/favicon.png
    // 经代理返回 200 + image/png，能拿到 500×500 的真图。
    //
    // 域名从哪来：不硬编码任何 IP 映射，改用 new-tab 页面自己所在的域名（location.hostname）
    // 试同一个端口。理由是这类瓦片的现实用法——用户把自己机器上的服务（1Panel 面板、
    // 安全入口应用）加进来，而 new-tab 本身就部署在那台机器上，端口不同而已。
    // 取不到也不亏：代名候选排在通用路径之后，失败就走第三方服务与首字母兜底。
    const getIpLiteralAliasUrls = (shortcut, baseUrl) => {
      const aliasUrls = [];

      let parsed;
      try {
        parsed = new URL(baseUrl);
      } catch {
        return aliasUrls;
      }

      // 只处理裸 IPv4：IPv6 字面量在 URL 里带方括号，交给通用链路
      if (!/^\d{1,3}(\.\d{1,3}){3}$/.test(parsed.hostname)) {
        return aliasUrls;
      }

      const pageHost = window.location.hostname;
      // 页面自己也是 IP（本地/内网访问）、或是 localhost 时没有可用域名，跳过
      if (
        !pageHost ||
        /^\d{1,3}(\.\d{1,3}){3}$/.test(pageHost) ||
        pageHost === "localhost" ||
        pageHost.endsWith(".local") ||
        pageHost.endsWith(".lan")
      ) {
        return aliasUrls;
      }

      // 端口必须保留：面板与非默认端口的应用全靠它区分
      const aliasOrigin = `${parsed.protocol}//${pageHost}${parsed.port ? `:${parsed.port}` : ""}`;
      // 路径本身就是应用路径（/tencentcloud、/a/b），图标通常挂在它自己的目录下。
      // 带安全入口的 1Panel（/ccd1a10224/）同理。路径为空（站点根）时只试站点根。
      const appPath = parsed.pathname.replace(/\/$/, "");

      if (appPath) {
        aliasUrls.push(`${aliasOrigin}${appPath}/public/favicon.png`);
      }
      aliasUrls.push(`${aliasOrigin}/public/favicon.png`);
      aliasUrls.push(`${aliasOrigin}/favicon.png`);

      return aliasUrls;
    };

    const getShortcutLogoUrls = (shortcut) => {
      let originUrl = "";
      try {
        originUrl = new URL(shortcut.url).origin;
      } catch {
        originUrl = "";
      }

      const hostname = getShortcutHostname(shortcut.url);
      const candidates = [];
      const cachedLogo = getCachedShortcutLogo(shortcut);
      const canUseCachedLogo = cachedLogo?.resolverVersion === logoResolverVersion;

      // 用户指定过的图标排最前，但不再就此收尾：指定图标失效（站点改版、地址过期）时
      // 后面仍接完整探测链，避免瓦片直接掉回首字母。
      if (shortcut.logo) {
        const logoUrl = unwrapProxyUrl(resolveShortcutAssetUrl(shortcut.logo, shortcut.url));

        pushLogoCandidate(candidates, logoUrl);
      }

      if (canUseCachedLogo && cachedLogo?.logoUrl) {
        pushLogoCandidate(candidates, unwrapProxyUrl(cachedLogo.logoUrl), false);
      }

      // 页面自己声明的图标（<link rel="icon">、og:image 等）排在猜测路径之前：
      // 站点说了自己的图标在哪，就没有理由再拿 7 条通用路径去猜。SPA 兜底站点
      // （任何不存在路径都返 200 text/html）上这些猜测注定全败，声明是唯一可靠来源。
      // collectLogoUrlsFromHtml 已把页面声明的地址收进 candidates，这里只做排序前置。
      if (canUseCachedLogo && Array.isArray(cachedLogo?.candidates)) {
        pushLogoCandidates(candidates, cachedLogo.candidates.map(unwrapProxyUrl));
      }

      // 只留实测有命中可能的路径。用生产配置里四个真实站点逐条 curl 过：
      // /icon.*、/apple-touch-icon*、/assets/*、/images/* 这 12 条全部是 404 或 SPA 的
      // HTML 兜底（200 text/html），零命中，只会白烧请求——而每个路径经代理还会裂成
      // 代理+直连两条候选，等于 24 次注定失败的往返。apple-touch-icon 类的能力没有丢：
      // 页面真声明了 <link rel="apple-touch-icon"> 时，collectLogoUrlsFromHtml 会收进来。
      const commonPaths = [
        "/favicon.svg",
        "/favicon.png",
        "/favicon.ico",
        // webp 放前面：Vite 项目默认产出 favicon.webp，静态 HTML 里也常写这个格式，
        // 漏掉它时 SPA 的 HTML 兜底会把其余候选全扮成 200，白试一整轮
        "/favicon.webp",
        "/public/favicon.png",
        "/logo.svg",
        "/logo.png",
        "/logo.webp",
      ];

      // 1Panel v2 的图标固定在 /public/favicon.png：静态 HTML 里没有图标标签，
      // 且带安全入口时守卫页会把带路径的请求全返 HTML 兜底，只有站点根路径下取得到。
      // 实测确认这条是 1Panel 站点唯一能拿到图的候选，所以排在最前面。
      if (isOnePanelHost(hostname)) {
        pushLogoCandidate(candidates, `${originUrl}/public/favicon.png`);
      }

      commonPaths.forEach((path) => {
        if (!originUrl) {
          return;
        }

        pushLogoCandidate(candidates, new URL(path, originUrl).href);
      });

      // 裸 IP 站点改用页面所在域名 + 原端口再试一轮。直连候选在 https 页面里全被
      // 浏览器拦掉、代理候选又被 Cloudflare 对 IP 字面量的 1003 挡掉，不换域名就无解。
      // 排在通用路径之后：域名代名是猜出来的对应关系，能中最好，不中也不多花钱。
      getIpLiteralAliasUrls(shortcut, shortcut.url).forEach((aliasUrl) => {
        pushLogoCandidate(candidates, aliasUrl);
      });

      const googleFavicon = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(hostname)}&sz=64`;
      const duckDuckGoFavicon = `https://icons.duckduckgo.com/ip3/${hostname}.ico`;
      // hostname 不含端口：非默认端口站点（如面板 :15660）要补回协议与端口，否则会打到默认端口上
      const faviconOrigin = originUrl ? new URL(originUrl) : null;
      const directFavicon = faviconOrigin
        ? `${faviconOrigin.protocol}//${hostname}${faviconOrigin.port ? `:${faviconOrigin.port}` : ""}/favicon.ico`
        : "";

      // 第三方 favicon 服务只走代理：直连这些域名时浏览器不带 CORS 头，
      // load 后的 content-type 复核只能得到「无法判断」，于是它们对无图标站点返回的
      // 占位图（Google 的 16x16 默认图、DuckDuckGo 的 404 地球）会被当成真实图标写进缓存。
      // 代理域名自带 access-control-allow-origin: *，复核结论才可靠。
      pushLogoCandidate(candidates, googleFavicon, true, true);
      pushLogoCandidate(candidates, duckDuckGoFavicon, true, true);
      pushLogoCandidate(candidates, directFavicon, false);

      // 带路径的站点（安全入口 /ccd1a10224/、子目录应用）图标可能在应用目录下。
      // 放在最后：这类请求大多被守卫页挡下返回 HTML 兜底，提前只会白发一批请求。
      // 只有目录真的比 origin 深才探测：根路径站点（https://host/）算出来的目录与
      // origin 只差一个尾斜杠，不去掉就会让每块瓦片都多跑一整轮通用路径。
      const directoryUrl = resolveShortcutDirectoryUrl(shortcut.url);
      const isDeeperThanOrigin = (() => {
        if (!directoryUrl || !originUrl) {
          return false;
        }

        return new URL(directoryUrl).pathname.replace(/\/$/, "") !== "";
      })();

      if (directoryUrl && isDeeperThanOrigin) {
        commonPaths.forEach((path) => {
          pushLogoCandidate(candidates, new URL(path.slice(1), directoryUrl).href);
        });
      }

      return candidates;
    };

    const getShortcutSubtitle = (shortcut) =>
      shortcut.description ?? getCachedShortcutLogo(shortcut)?.description ?? getShortcutHostname(shortcut.url);

    const cleanShortcutTitle = (value) => {
      const title = normalizeText(value);

      if (!title) {
        return "";
      }

      const shortTitle = title.slice(0, 80);
      const match = shortTitle.match(/^(.*?)[\s]*[-–—·|:：][\s]*([^\-–—·|:：\n]{1,24})$/);

      if (match && match[1].trim() && match[2].trim()) {
        return match[1].trim();
      }

      return shortTitle;
    };

    const normalizePageTitle = (value) =>
      normalizeText(value).replace(/\u2026/g, "...").replace(/\s+/g, " ");

    // SPA 站点（如 1Panel）的静态 HTML 标题常是占位符，真实标题由前端渲染，服务端抓不到。
    const isLoadingPageTitle = (value) =>
      /^loading[.\s]*$/i.test(value) || /^(加载中|正在加载|请稍候)[.。\s]*$/.test(value);

    // 1Panel 的图标由前端运行时注入（默认 /public/favicon.png），静态 HTML 里没有图标标签；
    // 没带安全入口时会收到守卫页，页面里有固定命令文案（安全入口未配置或域名绑定不符两种变体），
    // 可据此认出 1Panel 并直接用内置图标。
    const isOnePanelGuardPage = (html) => html.includes("1pctl user-info") || html.includes("1pctl reset domain");

    const collectLogoUrlsFromHtml = (html, baseUrl) => {
      const candidates = [];
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, "text/html");
      const pageTitle = cleanShortcutTitle(normalizePageTitle(doc.querySelector("title")?.textContent));
      const fallbackTitle = cleanShortcutTitle(normalizePageTitle(
        doc.querySelector('meta[property="og:title"]')?.getAttribute("content") ??
        doc.querySelector('meta[name="application-name"]')?.getAttribute("content") ??
        "",
      ));
      const isGuardPage = isOnePanelGuardPage(html);
      const resolvedTitle = (isGuardPage ? [] : [pageTitle, fallbackTitle]).find(
        (value) => value && !isLoadingPageTitle(value),
      ) ?? "";
      const iconSelector = [
        'link[rel~="icon"][href]',
        'link[rel~="apple-touch-icon"][href]',
        'link[rel~="apple-touch-icon-precomposed"][href]',
        'link[rel~="mask-icon"][href]',
        'meta[property="og:logo"][content]',
      ].join(",");

      doc.querySelectorAll(iconSelector).forEach((element) => {
        const rawUrl = element.getAttribute("href") ?? element.getAttribute("content");
        const logoUrl = resolveShortcutAssetUrl(rawUrl, baseUrl);

        if (logoUrl && !candidates.includes(logoUrl)) {
          candidates.push(logoUrl);
        }
      });

      doc.querySelectorAll('script[type="application/ld+json"]').forEach((script) => {
        try {
          const data = JSON.parse(script.textContent ?? "null");
          const nodes = Array.isArray(data) ? data : [data];

          nodes.forEach((node) => {
            const logo = node?.logo?.url ?? node?.logo;
            const logoUrl = typeof logo === "string" ? resolveShortcutAssetUrl(logo, baseUrl) : "";

            if (logoUrl && !candidates.includes(logoUrl)) {
              candidates.push(logoUrl);
            }
          });
        } catch {
          // Ignore invalid structured data and keep other logo sources.
        }
      });

      doc.querySelectorAll('meta[property="og:image"][content], meta[name="twitter:image"][content]').forEach((element) => {
        const logoUrl = resolveShortcutAssetUrl(element.getAttribute("content") ?? "", baseUrl);

        if (logoUrl && !candidates.includes(logoUrl)) {
          candidates.push(logoUrl);
        }
      });

      return {
        candidates: isGuardPage ? [onePanelLogoDataUrl, ...candidates] : candidates,
        title: resolvedTitle,
        description: normalizeText(
          doc.querySelector('meta[name="description"]')?.getAttribute("content") ??
          doc.querySelector('meta[property="og:description"]')?.getAttribute("content"),
        ),
      };
    };

    const hasUsefulCachedLogoMetadata = (cached) =>
      Boolean(
        cached?.resolverVersion === logoResolverVersion &&
        (
          cached.metadataResolved ||
          (Array.isArray(cached.candidates) && cached.candidates.length) ||
          cached.description ||
          cached.failedAt
        ),
      );

    const mergeShortcutLogoCache = (cacheKey, payload) => {
      if (!cacheKey) {
        return;
      }

      const existing = shortcutLogoCache[cacheKey] ?? {};
      const candidates = [
        ...(Array.isArray(existing.candidates) ? existing.candidates : []),
        ...(Array.isArray(payload.candidates) ? payload.candidates : []),
      ].filter((url, index, items) => url && items.indexOf(url) === index);

      shortcutLogoCache = {
        ...shortcutLogoCache,
        [cacheKey]: {
          ...existing,
          ...payload,
          candidates,
          resolverVersion: logoResolverVersion,
          updatedAt: Date.now(),
        },
      };
      writeShortcutLogoCache();
    };

    const fetchShortcutMetadata = (shortcut) => {
      const cacheKey = getShortcutLogoCacheKey(shortcut.url);
      const cached = shortcutLogoCache[cacheKey];
      const cachedAt = Number(cached?.updatedAt ?? cached?.failedAt ?? 0);
      // 成功解析的缓存保鲜 7 天；失败记录只保鲜 1 天，避免一次抖动导致长期不重试。
      const hasResolvedLogoMetadata = Boolean(
        cached?.metadataResolved ||
        (Array.isArray(cached?.candidates) && cached.candidates.length > 0) ||
        cached?.description,
      );
      const isFresh = cachedAt
        && Date.now() - cachedAt < (hasResolvedLogoMetadata ? 7 : 1) * 24 * 60 * 60 * 1000;

      if (!isRemoteUrl(shortcut.url) || !canProxyUrl(shortcut.url)) {
        return Promise.resolve(cached);
      }

      if (isFresh && hasUsefulCachedLogoMetadata(cached)) {
        return Promise.resolve(cached);
      }

      if (shortcutLogoRequests.has(cacheKey)) {
        return shortcutLogoRequests.get(cacheKey);
      }

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 5000);
      const request = fetch(getProxyUrl(shortcut.url), {
        signal: controller.signal,
      })
        .then((response) => (response.ok ? response.text() : ""))
        .then(async (html) => {
          if (!html) {
            mergeShortcutLogoCache(cacheKey, {
              candidates: [],
              failedAt: Date.now(),
            });
            return shortcutLogoCache[cacheKey];
          }

          const discovered = collectLogoUrlsFromHtml(html, shortcut.url);
          discovered.logoUrl = unwrapProxyUrl(discovered.logoUrl ?? discovered.candidates[0] ?? "");

          if (!discovered.candidates.length && !discovered.title && !discovered.description) {
            mergeShortcutLogoCache(cacheKey, {
              candidates: [],
              failedAt: Date.now(),
            });
            return shortcutLogoCache[cacheKey];
          }

          mergeShortcutLogoCache(cacheKey, {
            ...discovered,
            metadataResolved: true,
          });
          return shortcutLogoCache[cacheKey];
        })
        .catch(() => {
          mergeShortcutLogoCache(cacheKey, {
            candidates: [],
            failedAt: Date.now(),
          });
          return shortcutLogoCache[cacheKey];
        })
        .finally(() => {
          window.clearTimeout(timeout);
          shortcutLogoRequests.delete(cacheKey);
        });

      shortcutLogoRequests.set(cacheKey, request);
      return request;
    };

    const refreshShortcutMetadataDisplay = (shortcut, image) => {
      const item = image.closest(".shortcut-item");
      const itemShell = image.closest(".shortcut-item-shell");

      if (!(item instanceof HTMLElement)) {
        return;
      }

      const subtitle = getShortcutSubtitle(shortcut);
      const itemLabelText = item.querySelector(".shortcut-item__label small");
      const tooltipText = itemShell?.querySelector(".shortcut-item__tooltip small");

      item.setAttribute("aria-label", `${shortcut.title}：${subtitle}`);

      if (itemLabelText instanceof HTMLElement) {
        itemLabelText.textContent = subtitle;
      }

      if (tooltipText instanceof HTMLElement) {
        tooltipText.textContent = subtitle;
      }
    };

    const discoverShortcutLogo = (shortcut, image) => {
      if (shortcut.logo || !isRemoteUrl(shortcut.url)) {
        return;
      }

      fetchShortcutMetadata(shortcut).then((metadata) => {
        refreshShortcutMetadataDisplay(shortcut, image);

        if (!image.isConnected || image.dataset.logoExhausted === "true") {
          return;
        }

        const nextUrls = getShortcutLogoUrls(shortcut);
        const nextLogoUrl = nextUrls[0] ?? "";
        const shouldReplaceLoadedLogo = Boolean(
          metadata?.logoUrl &&
          nextLogoUrl &&
          image.src !== nextLogoUrl &&
          image.currentSrc !== nextLogoUrl,
        );

        if (!shouldReplaceLoadedLogo && image.complete && image.naturalWidth > 0) {
          return;
        }

        image.hidden = false;
        image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.add("hidden");
        image.dataset.logoFallbacks = JSON.stringify(nextUrls.slice(1));
        image.src = nextLogoUrl;
      });
    };

    const getNextLogoFallback = (image) => {
      const fallbacks = image.dataset.logoFallbacks
        ? JSON.parse(image.dataset.logoFallbacks)
        : [];
      const nextFallback = fallbacks.shift() ?? "";
      image.dataset.logoFallbacks = JSON.stringify(fallbacks);
      return nextFallback;
    };

    // SPA 与部分面板站点对不存在的路径也返回 200 + text/html（前端路由兜底），
    // <img> 拿到 HTML 时表现不统一：多数触发 error，个别被当成可解码内容而触发 load。
    // 仅凭 naturalWidth > 0 就认为「图标找到了」会把兜底页当成功写进缓存，
    // 之后一直复用这个假图标。这里用 fetch 复核一次 content-type。
    // 状态码也要看：Google s2/favicons 对没有图标的站点回的是 404 + image/png
    // （726 字节通用地球占位图），只看 content-type 会把这张地球当站点 logo 缓存下来。
    //
    // 复核结论分三档，"没拿到 content-type" 不等于 "不是图片"：fetch 对非 CORS 源
    // （localhost、内网 IP、裸 IP 站点）会直接 TypeError，那是浏览器策略挡的，
    // 不是上游回了 HTML。这类请求一律判 unknown，由调用方按 <img> 的解码结果决定。
    const LOGO_VERIFY_IMAGE = "image";
    const LOGO_VERIFY_HTML = "html";
    const LOGO_VERIFY_UNKNOWN = "unknown";
    const verifyLogoResponse = async (url) => {
      try {
        const response = await fetch(url, { method: "GET" });
        const contentType = response.headers.get("content-type") ?? "";

        if (/text\/html/i.test(contentType)) {
          return LOGO_VERIFY_HTML;
        }

        return response.ok && /^image\//i.test(contentType) ? LOGO_VERIFY_IMAGE : LOGO_VERIFY_HTML;
      } catch {
        return LOGO_VERIFY_UNKNOWN;
      }
    };

    // Google s2 对「没有 favicon 的域名」返回一张内置默认图：请求 sz=64 却只给 16x16，
    // 而真实小图标（如 github.com 的 32x32）不会低于这个尺寸。把它当成功会拿一张
    // 白色地球盖住首字母，所以按「请求尺寸远大于实际尺寸」认出占位图并继续往下试。
    // 只对 Google s2 域名生效：站点自己的 favicon 再小也是它的真实标识。
    const isGoogleFaviconPlaceholder = (url, naturalWidth) => {
      let parsed;
      try {
        parsed = new URL(url);
      } catch {
        return false;
      }

      if (parsed.hostname !== "www.google.com" || !parsed.pathname.startsWith("/s2/favicons")) {
        return false;
      }

      const requestedSize = Number(parsed.searchParams.get("sz") ?? 0);

      return Number.isFinite(requestedSize) && requestedSize > 16 && naturalWidth <= 16;
    };

    const bindLogoFallback = (image) => {
      const advanceToNextFallback = () => {
        const fallback = getNextLogoFallback(image);

        if (fallback && image.src !== fallback) {
          image.src = fallback;
          return true;
        }

        image.hidden = true;
        // 候选链走完仍没图：标记为已放弃，阻止 discoverShortcutLogo 的迟到回调
        // 把这里重新显示出来并跳回链首（本地站点的 metadata 会立即 resolve，必然撞上）。
        image.dataset.logoExhausted = "true";
        image.closest(".shortcut-item__icon")?.querySelector(".shortcut-item__initial")?.classList.remove("hidden");
        return false;
      };

      image.addEventListener("load", () => {
        if (!image.currentSrc || image.naturalWidth <= 0) {
          return;
        }

        if (isGoogleFaviconPlaceholder(image.currentSrc, image.naturalWidth)) {
          advanceToNextFallback();
          return;
        }

        const verify = async () => {
          const loadedLogoUrl = unwrapProxyUrl(image.currentSrc);
          const verdict = await verifyLogoResponse(image.currentSrc);

          // 只有拿到确凿的 text/html 才认定是 SPA 兜底页；复核被 CORS 挡掉时
          // <img> 已经解码出像素（naturalWidth > 0 在上面拦过），按成功处理，
          // 否则 localhost / 内网 / 裸 IP 站点的真实 favicon 会被一路误判到链尾。
          if (verdict === LOGO_VERIFY_HTML) {
            advanceToNextFallback();
            return;
          }

          const existing = shortcutLogoCache[image.dataset.logoCacheKey];

          if (
            existing?.metadataResolved &&
            existing?.logoUrl &&
            existing.logoUrl !== loadedLogoUrl
          ) {
            return;
          }

          mergeShortcutLogoCache(image.dataset.logoCacheKey, {
            logoUrl: loadedLogoUrl,
          });
        };

        void verify();
      });

      image.addEventListener("error", () => {
        advanceToNextFallback();
      });
    };

    // —— 布局引擎：网格走原生流式，堆叠/环形/随机走画布绝对定位；切换与增删用 FLIP 补间 ——
    const shortcutPlacementMemory = new Map();

    const getShortcutCanvasKey = (element) =>
      element instanceof HTMLElement ? element.dataset.canvasKey ?? "" : "";

    const hashShortcutKey = (value) => {
      let hash = 5381;

      for (let index = 0; index < value.length; index += 1) {
        hash = ((hash << 5) + hash + value.charCodeAt(index)) | 0;
      }

      return Math.abs(hash);
    };

    const createScatterRandom = (seed) => {
      let state = seed % 2147483647;

      if (state <= 0) {
        state += 2147483646;
      }

      return () => {
        state = (state * 16807) % 2147483647;
        return (state - 1) / 2147483646;
      };
    };

    const layoutShortcutCanvas = (itemsEl, mode, placements) => {
      const children = Array.from(itemsEl.children).filter(
        (child) => child instanceof HTMLElement && !child.classList.contains("shortcut-group__empty"),
      );

      if (mode === "grid" || !children.length) {
        itemsEl.style.removeProperty("height");
        children.forEach((child) => {
          child.style.removeProperty("position");
          child.style.removeProperty("left");
          child.style.removeProperty("top");
          child.style.removeProperty("transform");
          child.style.removeProperty("z-index");
          delete child.dataset.canvasZ;
          placements.set(getShortcutCanvasKey(child), {
            x: child.offsetLeft,
            y: child.offsetTop,
            rot: 0,
          });
        });
        return;
      }

      const tileEl = children.find((child) => child.classList.contains("shortcut-item-shell")) ?? children[0];
      const tileWidth = tileEl.offsetWidth || 96;
      const tileHeight = tileEl.offsetHeight || 88;
      const width = itemsEl.clientWidth || tileWidth;
      const positions = [];

      if (mode === "stack") {
        // 横向手牌：卡片沿一行错开、轻微重叠，每张露出左侧一条；一行放不下自动换行。
        // dataset.fanTransform 存悬停时向右铺开成完整间距的位置。
        // 每行容量按铺开后的间距算，保证铺开时不会顶出容器。
        const rowGap = 10;
        const collapsedStepX = Math.max(tileWidth * 0.78, 1);
        const expandedStepX = Math.max(tileWidth + rowGap, collapsedStepX);
        const perRow = Math.max(1, Math.floor((width - tileWidth) / expandedStepX) + 1);
        const random = createScatterRandom(newTabState.scatterSeed + 17);

        children.forEach((child, index) => {
          const column = index % perRow;
          const row = Math.floor(index / perRow);

          positions.push({
            x: column * collapsedStepX,
            y: row * (tileHeight + rowGap),
            rot: random() * 3 - 1.5,
            z: index + 1,
          });

          child.dataset.fanTransform = `translate(${column * expandedStepX}px, ${row * (tileHeight + rowGap)}px) rotate(0deg)`;
          child.dataset.fanZ = String(40 + index);
        });
      } else if (mode === "ring") {
        // 弧形：一条开口向上的圆弧（中间低、两端高），瓦片随切线倾斜。
        // 瓦片多到单环按设计间距排不下时拆成多个环纵向叠放，免得一条弧挤成一团；
        // 叠起来高度超预算就把半径拉大、弧压平，优先保证瓦片都露在视口里。
        const tileMax = Math.max(tileWidth, tileHeight);
        // 相邻瓦片沿弧的间距，与单环原有观感一致
        const arcStep = tileMax * 0.95;
        const maxArcWidth = Math.max(0, width - tileWidth);
        const perRingCapacity = Math.max(1, Math.floor(maxArcWidth / arcStep) + 1);
        const ringCount = Math.max(1, Math.ceil(children.length / perRingCapacity));
        const perRing = Math.ceil(children.length / ringCount);
        const ringGap = 12;
        const apexPad = 6;
        const heightBudget = Math.max(tileHeight * 2, window.innerHeight * 0.58);
        const dropLimit = Math.max(
          0,
          (heightBudget - apexPad - ringCount * tileHeight - (ringCount - 1) * ringGap) / ringCount,
        );
        const baseRadius = Math.max(width * 0.72, tileMax * 1.4);
        const arcDrop = (r, len) => r * (1 - Math.cos(len / (2 * r)));
        const longestArc = Math.min(maxArcWidth, (perRing - 1) * arcStep);

        let radius = baseRadius;

        if (arcDrop(radius, longestArc) > dropLimit) {
          // 半径越大弧越平（弧深越小），二分找刚好把弧深压进预算的半径
          let low = baseRadius;
          let high = baseRadius * 64;

          for (let attempt = 0; attempt < 42; attempt += 1) {
            const mid = (low + high) / 2;

            if (arcDrop(mid, longestArc) > dropLimit) {
              low = mid;
            } else {
              high = mid;
            }
          }

          radius = high;
        }

        let ringTop = apexPad;
        let placed = 0;

        for (let ring = 0; ring < ringCount && placed < children.length; ring += 1) {
          const size = Math.min(perRing, children.length - placed);
          const arcLen = Math.min(maxArcWidth, (size - 1) * arcStep);
          const half = arcLen / (2 * radius);
          const step = size > 1 ? arcLen / radius / (size - 1) : 0;

          for (let offset = 0; offset < size; offset += 1) {
            const angle = (offset - (size - 1) / 2) * step;

            positions.push({
              x: width / 2 + Math.sin(angle) * radius - tileWidth / 2,
              y: ringTop + radius * (Math.cos(angle) - Math.cos(half)),
              rot: Math.max(-26, Math.min(26, (-angle * 180) / Math.PI)),
              z: placed + offset + 1,
            });
          }

          placed += size;
          ringTop += arcDrop(radius, arcLen) + tileHeight + ringGap;
        }
      } else {
        // 有机散布：最优采样挑离已放置瓦片最远的候选点，避免规则网格感
        const canvasHeight = Math.max(
          tileHeight * 1.9,
          Math.ceil((children.length * tileWidth * tileHeight * 2.6) / Math.max(width, 1)),
        );
        const placedCenters = [];

        children.forEach((child, index) => {
          const key = getShortcutCanvasKey(child) || String(index);
          const random = createScatterRandom((newTabState.scatterSeed ^ hashShortcutKey(key)) + 11);
          const maxX = Math.max(0, width - tileWidth);
          const maxY = Math.max(0, canvasHeight - tileHeight);
          let best = { x: 0, y: 0, rot: 0 };
          let bestScore = -1;

          for (let attempt = 0; attempt < 12; attempt += 1) {
            const x = random() * maxX;
            const y = random() * maxY;
            const cx = x + tileWidth / 2;
            const cy = y + tileHeight / 2;
            let nearest = Infinity;

            placedCenters.forEach((center) => {
              nearest = Math.min(nearest, Math.hypot(center.x - cx, center.y - cy));
            });

            const edgePull = Math.min(cx, width - cx, cy, canvasHeight - cy) * 0.35;
            const score = (Number.isFinite(nearest) ? nearest : 0) + edgePull;

            if (score > bestScore) {
              bestScore = score;
              best = { x, y, rot: random() * 32 - 16 };
            }
          }

          placedCenters.push({ x: best.x + tileWidth / 2, y: best.y + tileHeight / 2 });
          positions.push({ x: best.x, y: best.y, rot: best.rot, z: 0 });
        });
      }

      const canvasHeight = positions.reduce((max, position) => Math.max(max, position.y), 0) + tileHeight + 4;

      itemsEl.style.height = `${canvasHeight}px`;
      children.forEach((child, index) => {
        const position = positions[index];

        child.style.position = "absolute";
        child.style.left = "0";
        child.style.top = "0";
        child.style.transform = `translate(${position.x}px, ${position.y}px) rotate(${position.rot}deg)`;
        child.style.zIndex = position.z ? String(position.z) : "";

        if (position.z) {
          child.dataset.canvasZ = String(position.z);
        } else {
          delete child.dataset.canvasZ;
        }

        if (mode !== "stack") {
          delete child.dataset.fanTransform;
          delete child.dataset.fanZ;
        }

        placements.set(getShortcutCanvasKey(child), {
          x: position.x,
          y: position.y,
          rot: position.rot,
        });
      });
    };

    const applyShortcutLayouts = (previousPlacements, { animate = true } = {}) => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
        return;
      }

      const mode = newTabState.shortcutLayout;
      // 首屏让瓦片逐个弹出（序号 × 24ms，上限 360ms）；新增站点也播同样的弹入。
      const stagger = animate && previousPlacements.size === 0;
      let globalIndex = 0;

      stack.querySelectorAll(".shortcut-group__items").forEach((itemsEl) => {
        if (!(itemsEl instanceof HTMLElement)) {
          return;
        }

        const placements = new Map();

        layoutShortcutCanvas(itemsEl, mode, placements);

        Array.from(itemsEl.children).forEach((child) => {
          if (!(child instanceof HTMLElement) || child.classList.contains("shortcut-group__empty")) {
            return;
          }

          const key = getShortcutCanvasKey(child);
          const target = placements.get(key);

          if (!target) {
            return;
          }

          const delay = stagger ? Math.min(globalIndex * 24, 360) : 0;

          globalIndex += 1;
          child.style.setProperty("--ntab-delay", `${delay}ms`);

          const previous = animate ? previousPlacements.get(key) : undefined;

          if (previous) {
            const dx = previous.x - target.x;
            const dy = previous.y - target.y;
            const dr = (previous.rot ?? 0) - (target.rot ?? 0);

            if (dx || dy || dr) {
              // 全量重建后节点是新的，transition 不会触发；用 WAAPI 从旧位姿补间到新位姿，
              // composite: add 把位移叠加在静态定位上，stack 档自带 transform 也不被覆盖。
              child.style.transform =
                mode === "grid"
                  ? ""
                  : `translate(${target.x}px, ${target.y}px) rotate(${target.rot ?? 0}deg)`;
              child.getAnimations().forEach((animation) => animation.cancel());
              child.animate(
                [
                  { transform: `translate(${dx}px, ${dy}px) rotate(${dr}deg)`, composite: "add" },
                  { transform: "translate(0px, 0px) rotate(0deg)", composite: "add" },
                ],
                {
                  duration: 260,
                  easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                  composite: "add",
                },
              );
            } else if (mode === "grid") {
              child.style.transform = "";
            } else {
              child.style.transform = `translate(${target.x}px, ${target.y}px) rotate(${target.rot ?? 0}deg)`;
            }
          } else if (animate && !previousPlacements.has(key)) {
            child.classList.add("ntab-pop");
            window.setTimeout(() => child.classList.remove("ntab-pop"), delay + 620);
          }
        });

        placements.forEach((value, placementKey) => {
          shortcutPlacementMemory.set(placementKey, value);
        });
      });
    };

    let shortcutLayoutResizeTimer = 0;

    const scheduleShortcutRelayout = () => {
      window.clearTimeout(shortcutLayoutResizeTimer);
      shortcutLayoutResizeTimer = window.setTimeout(() => {
        applyShortcutLayouts(shortcutPlacementMemory, { animate: false });
      }, 140);
    };

    const renderSearchEngines = () => {
      const select = document.querySelector("[data-config-search-engine]");

      if (!(select instanceof HTMLSelectElement)) {
        return;
      }

      select.textContent = "";
      newTabState.searchEngines.forEach((engine) => {
        const option = document.createElement("option");
        option.value = engine.id;
        option.textContent = engine.label;
        select.append(option);
      });

      select.value = newTabState.defaultSearchEngineId;

      const engineLabel = document.querySelector("[data-search-engine-label]");
      const activeEngine = newTabState.searchEngines.find((engine) => engine.id === newTabState.defaultSearchEngineId);

      if (engineLabel instanceof HTMLElement && activeEngine) {
        engineLabel.textContent = activeEngine.label;
      }
    };

    const renderGreeting = () => {
      const greeting = document.querySelector("[data-new-tab-greeting]");

      if (!(greeting instanceof HTMLElement)) {
        return;
      }

      const hour = new Date().getHours();
      const greetingConfig = newTabState.greetings.find((item) => {
        if (item.from < item.to) {
          return hour >= item.from && hour < item.to;
        }

        return hour >= item.from || hour < item.to;
      });

      greeting.textContent = `${greetingConfig?.label ?? "你好"}，${newTabState.userName}`;

      const dateTarget = document.querySelector("[data-new-tab-date]");

      if (dateTarget instanceof HTMLElement) {
        const now = new Date();
        dateTarget.textContent = [
          new Intl.DateTimeFormat("zh-CN", { month: "long", day: "numeric" }).format(now),
          new Intl.DateTimeFormat("zh-CN", { weekday: "long" }).format(now),
        ].join(" · ");
      }
    };

    const renderHomeLink = () => {
      const homeLink = document.querySelector("[data-home-link]");

      if (!(homeLink instanceof HTMLAnchorElement)) {
        return;
      }

      homeLink.href = resolveBaseHref(newTabState.homeLink.href);
      const homeLinkLabel = homeLink.querySelector("[data-home-link-label]");

      if (homeLinkLabel instanceof HTMLElement) {
        homeLinkLabel.textContent = newTabState.homeLink.label;
        homeLinkLabel.classList.toggle("hidden", !newTabState.homeLink.label);
        return;
      }

      homeLink.textContent = newTabState.homeLink.label;
    };

    let hasRenderedShortcutGroups = false;

    /* 拖拽排序（SortableJS）：分组在 stack 上整列可拖（handle = 整个标题行），
       站点在各自 items 里自由排序、跨组拖入。拖完只改数据并持久化，
       画布位置由 renderShortcutGroups → applyShortcutLayouts 统一重建。
       stack/两个 items 容器每次渲染都重建，Sortable 实例跟着销毁重建（destroy 在这里做，
       element 引用旧节点时 Sortable.destroy 会抛错，直接忽略）。 */
    let groupSortable = null;
    const itemSortables = new Map();

    const destroyShortcutSortables = () => {
      if (groupSortable) {
        try {
          groupSortable.destroy();
        } catch {
          // element 已随上次渲染移除时 destroy 会抛错，无需处理
        }
        groupSortable = null;
      }
      itemSortables.forEach((sortable) => {
        try {
          sortable.destroy();
        } catch {
          // 同上
        }
      });
      itemSortables.clear();
    };

    const bindShortcutSortable = (stack, groupSections, previousPlacements) => {
      destroyShortcutSortables();

      // 分组排序：handle 是整行 summary（标题、计数、按钮整行都算拖拽起点），
      // 拖动时其它分组用 animation 平滑让位。swapThreshold 0.5 = 拖影与目标组重叠过半才换位，
      // 避免轻擦过就「名字先跑过去」；松手时 ghost 归位（revert) 的 250ms 补间让落点更清楚
      groupSortable = Sortable.create(stack, {
        handle: ".shortcut-group__summary",
        draggable: ".shortcut-group",
        forceFallback: true,
        fallbackTolerance: 3,
        swapThreshold: 0.5,
        animation: 240,
        easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        ghostClass: "shortcut-sortable-ghost",
        dragClass: "shortcut-sortable-drag",
        chosenClass: "shortcut-sortable-chosen",
        onStart() {
          stack.dataset.groupDragging = "true";
        },
        onEnd(event) {
          delete stack.dataset.groupDragging;
          const fromIndex = event.oldIndex ?? -1;
          const toIndex = event.newIndex ?? -1;

          if (
            fromIndex < 0 ||
            toIndex < 0 ||
            fromIndex === toIndex ||
            fromIndex >= newTabState.shortcutGroups.length ||
            toIndex > newTabState.shortcutGroups.length
          ) {
            return;
          }

          // Sortable 已把 DOM 挪好；这里把同样的顺序写回数据再全量重渲染
          const [moved] = newTabState.shortcutGroups.splice(fromIndex, 1);
          newTabState.shortcutGroups.splice(toIndex, 0, moved);
          persistConfigChange("已排序");
        },
      });

      // 站点排序 + 跨组移动：每个 items 一个 Sortable，group: "shortcut" 互通；
      // pull true = 可拖出，put true = 可拖入；空组也保留可放置区域
      groupSections.forEach((section, sectionIndex) => {
        const itemsEl = section.querySelector(".shortcut-group__items");

        if (!(itemsEl instanceof HTMLElement)) {
          return;
        }

        const itemSortable = Sortable.create(itemsEl, {
          group: "shortcut",
          sort: true,
          forceFallback: true,
          fallbackTolerance: 3,
          swapThreshold: 0.5,
          animation: 240,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          draggable: ".shortcut-item-shell",
          ghostClass: "shortcut-sortable-ghost",
          dragClass: "shortcut-sortable-drag",
          chosenClass: "shortcut-sortable-chosen",
          filter: ".shortcut-group__empty",
          preventOnFilter: false,
          onStart() {
            stack.dataset.itemDragging = "true";
          },
          onEnd(event) {
            delete stack.dataset.itemDragging;
            const fromGroupIndex = [...stack.querySelectorAll(".shortcut-group")].indexOf(
              event.from.closest(".shortcut-group"),
            );
            const toGroupIndex = [...stack.querySelectorAll(".shortcut-group")].indexOf(
              event.to.closest(".shortcut-group"),
            );

            if (fromGroupIndex < 0 || toGroupIndex < 0) {
              return;
            }

            // Sortable 把 DOM 节点从 from 挪到 to（跨组）或就地重排（组内）；
            // 数据以 DOM 结果为准重排，再全量重渲染恢复画布定位
            const fromGroup = newTabState.shortcutGroups[fromGroupIndex];
            const toGroup = newTabState.shortcutGroups[toGroupIndex];
            const toShortcutIndex = event.newIndex ?? 0;
            const movedTitle = event.item.dataset.canvasKey?.split("\n")[1] ?? "";

            if (!fromGroup || !toGroup) {
              return;
            }

            const fromShortcutIndex = fromGroup.shortcuts.findIndex(
              (shortcut) => shortcut.title === movedTitle,
            );

            if (fromShortcutIndex < 0) {
              return;
            }

            const [shortcut] = fromGroup.shortcuts.splice(fromShortcutIndex, 1);
            const adjustedIndex =
              fromGroupIndex === toGroupIndex && fromShortcutIndex < toShortcutIndex
                ? toShortcutIndex - 1
                : toShortcutIndex;
            toGroup.shortcuts.splice(Math.max(0, Math.min(adjustedIndex, toGroup.shortcuts.length)), 0, shortcut);
            persistConfigChange(fromGroupIndex === toGroupIndex ? "已排序" : "已移动");
          },
        });

        itemSortables.set(sectionIndex, itemSortable);
      });
    };

    const renderShortcutGroups = () => {
      const stack = document.querySelector("[data-shortcut-stack]");

      if (!(stack instanceof HTMLElement)) {
        return;
      }

      const shell = document.querySelector("[data-new-tab-page]");

      if (shell instanceof HTMLElement) {
        // 没有分组时工具栏的添加入口无处分派，交给空态引导（见 [data-has-groups] 样式）
        shell.dataset.hasGroups = newTabState.shortcutGroups.length ? "true" : "false";
      }

      // 入场动画的弧形降级判据挂在 html 上（首帧前由内联脚本写入），切换布局后同步保持一致
      document.documentElement.dataset.newTabLayout = newTabState.shortcutLayout;
      destroyShortcutSortables();

      const previousPlacements = new Map(shortcutPlacementMemory);

      shortcutPlacementMemory.clear();
      stack.textContent = "";
      closeShortcutContextMenu();

      const board = document.querySelector("[data-shortcut-board]");
      const boardSummary = document.querySelector("[data-shortcut-summary]");
      const page = document.querySelector("[data-new-tab-page]");
      const groupCount = newTabState.shortcutGroups.length;
      const siteCount = newTabState.shortcutGroups.reduce((total, group) => total + group.shortcuts.length, 0);

      page?.setAttribute("data-has-groups", String(groupCount > 0));
      board?.toggleAttribute("data-empty", groupCount === 0);

      if (boardSummary instanceof HTMLElement) {
        boardSummary.textContent = groupCount
          ? `${groupCount} ${settingsLabels.boardSummaryGroupsLabel ?? "个分组"} · ${siteCount} ${settingsLabels.boardSummarySitesLabel ?? "个站点"}`
          : (settingsLabels.boardSummaryEmptyLabel ?? "还没有分组");
      }

      if (!newTabState.shortcutGroups.length) {
        stack.append(createShortcutEmptyState());
        applyTextColors();
        return;
      }

      const groupSections = [];
      const animateEnter = !hasRenderedShortcutGroups;
      let enterIndex = 0;

      hasRenderedShortcutGroups = true;

      newTabState.shortcutGroups.forEach((group, groupIndex) => {
        const section = document.createElement("section");
        section.className = "shortcut-group";
        section.dataset.groupTitle = group.title;
        section.setAttribute("aria-label", `${group.title}快捷方式`);

        const summary = document.createElement("div");
        summary.className = "shortcut-group__summary";

        const title = document.createElement("span");
        title.className = "shortcut-group__title";
        title.dataset.newTabColorTarget = "itemLabel";
        title.textContent = group.title;

        const openGroupEditForm = () => {
          openGroupDialog({
            mode: "edit",
            group,
            onSaved: (savedGroup) => {
              const target = stack.querySelector(`[data-group-title="${CSS.escape(savedGroup.title)}"]`);
              target?.scrollIntoView({ block: "nearest" });
            },
          });
        };
        const removeGroup = () => {
          const currentGroupIndex = newTabState.shortcutGroups.indexOf(group);

          if (currentGroupIndex < 0) {
            return;
          }

          newTabState.shortcutGroups.splice(currentGroupIndex, 1);
          persistConfigChange("已删除");
          showNewTabToast(`已删除「${group.title}」`);
        };
        const openGroupMenu = (event) => {
          openShortcutContextMenu({
            event,
            fallbackElement: section,
            title: group.title,
            subtitle: "分组操作",
            actions: [
              {
                label: settingsLabels.addShortcutLabel ?? "添加站点",
                icon: "plus",
                onSelect: () => {
                  openShortcutAddForm(group);
                },
              },
              {
                label: "修改分组",
                icon: "edit",
                onSelect: openGroupEditForm,
              },
              {
                label: settingsLabels.removeGroupLabel ?? "删除分组",
                icon: "trash",
                danger: true,
                onSelect: removeGroup,
              },
            ],
          });
        };

        const titleWrap = document.createElement("span");
        titleWrap.className = "flex min-w-0 items-center gap-2";

        const groupDragHandle = document.createElement("span");
        groupDragHandle.className = "shortcut-drag-handle";
        groupDragHandle.title = "拖拽排序";
        groupDragHandle.setAttribute("aria-label", `拖拽排序：${group.title}`);
        // getIconMarkup 返回站点内置的静态图标字符串，不含用户输入，无 XSS 风险
        groupDragHandle.innerHTML = dragHandleIcon;
        // 拖拽由 stack 级 Sortable 实例统一管理（整个标题行可拖），把手只作视觉提示
        titleWrap.append(title);

        const groupMenuButton = document.createElement("button");
        groupMenuButton.className = "shortcut-group__menu";
        groupMenuButton.type = "button";
        groupMenuButton.title = "分组操作";
        groupMenuButton.setAttribute("aria-label", `分组操作：${group.title}`);
        groupMenuButton.setAttribute("aria-haspopup", "menu");
        groupMenuButton.innerHTML = getIconMarkup("more");
        groupMenuButton.addEventListener("click", openGroupMenu);

        titleWrap.addEventListener("contextmenu", openGroupMenu);

        const count = document.createElement("span");
        count.className = "shortcut-group__count";
        count.textContent = String(group.shortcuts.length);
        count.setAttribute("aria-label", `${group.shortcuts.length} 个站点`);

        const rule = document.createElement("span");
        rule.className = "shortcut-group__rule";
        rule.setAttribute("aria-hidden", "true");

        const groupAddButton = document.createElement("button");
        groupAddButton.className = "new-tab-group-action";
        groupAddButton.type = "button";
        groupAddButton.innerHTML = `<span class="grid h-3.5 w-3.5 place-items-center">${getIconMarkup("plus")}</span>`;
        groupAddButton.setAttribute("aria-label", `向${group.title}添加站点`);
        groupAddButton.addEventListener("click", () => {
          openShortcutAddForm(group);
        });

        const groupActions = document.createElement("span");
        groupActions.className = "shortcut-group__actions";
        groupActions.append(groupDragHandle, groupAddButton, groupMenuButton);

        summary.append(titleWrap, count, rule, groupActions);

        // summary 整行是分组拖拽把手（SortableJS），行内的操作按钮不能当拖拽起点：
        // 按钮的 pointerdown 不冒泡到 summary，点添加/菜单不会拖着整组走，click 照常触发
        summary.querySelectorAll("button").forEach((button) => {
          button.addEventListener("pointerdown", (event) => {
            event.stopPropagation();
          });
        });

        const items = document.createElement("div");
        items.className = "shortcut-group__items relative flex w-full min-w-0 flex-wrap items-start justify-start gap-2 sm:gap-2.5";
        items.addEventListener("contextmenu", (event) => {
          if (event.target !== items) {
            return;
          }

          event.preventDefault();
          openShortcutAddForm(group);
        });
        // 堆叠模式：悬停整组向右铺开成完整间距，移开复位（牌堆位来自布局内存）
        items.addEventListener("pointerenter", () => {
          if (newTabState.shortcutLayout !== "stack") {
            return;
          }

          Array.from(items.children).forEach((child) => {
            if (!(child instanceof HTMLElement) || !child.dataset.fanTransform) {
              return;
            }

            child.style.transitionDelay = `${Math.min(Number(child.dataset.canvasIndex ?? 0) * 26, 320)}ms`;
            child.style.transform = child.dataset.fanTransform;
            child.style.zIndex = child.dataset.fanZ ?? "";
          });
        });
        items.addEventListener("pointerleave", () => {
          if (newTabState.shortcutLayout !== "stack") {
            return;
          }

          Array.from(items.children).forEach((child) => {
            if (!(child instanceof HTMLElement) || !child.dataset.fanTransform) {
              return;
            }

            child.style.transitionDelay = "";
            const placement = shortcutPlacementMemory.get(getShortcutCanvasKey(child));

            child.style.transform = placement
              ? `translate(${placement.x}px, ${placement.y}px) rotate(${placement.rot}deg)`
              : "";
            child.style.zIndex = child.dataset.canvasZ ?? "";
          });
        });

        group.shortcuts.forEach((shortcut, shortcutIndex) => {
          const itemShell = document.createElement("div");
          itemShell.className = "shortcut-item-shell group select-none";
          itemShell.dataset.canvasKey = `${shortcut.url}\n${shortcut.title}`;
          itemShell.dataset.canvasIndex = String(shortcutIndex);

          if (animateEnter) {
            itemShell.style.setProperty("--ntab-delay", `${Math.min(enterIndex * 24, 360)}ms`);
            itemShell.classList.add("ntab-pop");
            enterIndex += 1;
          }

          const openShortcutEditForm = () => {
            openShortcutEditDialog(group, shortcut);
          };
          const removeShortcut = () => {
            const currentShortcutIndex = group.shortcuts.indexOf(shortcut);

            if (currentShortcutIndex < 0) {
              return;
            }

            // 先播退场动画再从数据里删：renderShortcutGroups 是 textContent = "" 全量重建，
            // 同步 splice 会让瓦片瞬间消失，用户看不到自己删了什么、旁边瓦片为何突然挪位。
            // 动画期间遮罩点击，避免连点触发两次删除。
            if (itemShell instanceof HTMLElement && !itemShell.classList.contains("ntab-vanish")) {
              itemShell.classList.add("ntab-vanish");
              window.setTimeout(() => {
                group.shortcuts.splice(currentShortcutIndex, 1);
                persistConfigChange("已删除");
              }, 260);
              return;
            }

            group.shortcuts.splice(currentShortcutIndex, 1);
            persistConfigChange("已删除");
          };
          const openShortcutMenu = (event) => {
            openShortcutContextMenu({
              event,
              fallbackElement: itemShell,
              title: shortcut.title,
              subtitle: getShortcutSubtitle(shortcut),
              actions: [
                {
                  label: settingsLabels.editShortcutLabel ?? "修改站点",
                  icon: "edit",
                  onSelect: openShortcutEditForm,
                },
                {
                  label: settingsLabels.removeShortcutLabel ?? "删除站点",
                  icon: "trash",
                  danger: true,
                  onSelect: removeShortcut,
                },
              ],
            });
          };

          itemShell.classList.add("select-none");
          itemShell.style.webkitTouchCallout = "none";
          itemShell.addEventListener("pointerenter", () => {
            if (newTabState.shortcutLayout === "stack") {
              itemShell.style.zIndex = "60";
            }
          });
          itemShell.addEventListener("pointerleave", () => {
            if (newTabState.shortcutLayout === "stack") {
              itemShell.style.zIndex = itemShell.dataset.canvasZ ?? "";
            }
          });
          itemShell.addEventListener("contextmenu", openShortcutMenu);
          // macOS 触摸板双指/Ctrl+单击：部分场景只派发 click（ctrlKey/metaKey=true）不派发
          // contextmenu，若不拦住会直接跳转链接。捕获阶段兜底打开右键菜单。
          itemShell.addEventListener(
            "click",
            (event) => {
              if (!suppressNextClick && (event.ctrlKey || event.metaKey)) {
                event.preventDefault();
                event.stopPropagation();
                openShortcutMenu(event);
              }
            },
            true,
          );
          let longPressTimer = 0;
          let suppressNextClick = false;

          itemShell.addEventListener("touchstart", (event) => {
            if (event.touches.length !== 1 || activeShortcutContextMenu) {
              return;
            }

            const touch = event.touches[0];
            longPressTimer = window.setTimeout(() => {
              longPressTimer = 0;
              suppressNextClick = true;
              openShortcutMenu({
                clientX: touch.clientX,
                clientY: touch.clientY,
                preventDefault: () => {},
                stopPropagation: () => {},
              });
            }, 500);
          }, { passive: true });

          itemShell.addEventListener("touchmove", () => {
            window.clearTimeout(longPressTimer);
          }, { passive: true });
          itemShell.addEventListener("touchend", () => {
            window.clearTimeout(longPressTimer);
          });
          itemShell.addEventListener("touchcancel", () => {
            window.clearTimeout(longPressTimer);
          });
          itemShell.addEventListener(
            "click",
            (event) => {
              if (!suppressNextClick) {
                return;
              }

              event.preventDefault();
              event.stopPropagation();
              suppressNextClick = false;
            },
            true,
          );

          const item = document.createElement("a");
          item.className = "shortcut-item";
          item.href = shortcut.url;
          if (newTabState.shortcutOpenMode === "newTab") {
            item.target = "_blank";
            item.rel = "noopener noreferrer";
          }
          item.setAttribute(
            "aria-label",
            `${shortcut.title}：${getShortcutSubtitle(shortcut)}`,
          );

          const icon = document.createElement("span");
          icon.className = "shortcut-item__icon";
          icon.setAttribute("aria-hidden", "true");

          const image = document.createElement("img");
          const logoUrls = getShortcutLogoUrls(shortcut);
          image.className = "";
          image.src = logoUrls[0] ?? "";
          image.alt = "";
          image.loading = "lazy";
          image.decoding = "async";
          image.referrerPolicy = "no-referrer";
          image.dataset.logoCacheKey = getShortcutLogoCacheKey(shortcut.url);
          image.dataset.logoFallbacks = JSON.stringify(logoUrls.slice(1));
          bindLogoFallback(image);
          discoverShortcutLogo(shortcut, image);

          const initial = document.createElement("span");
          initial.className = "shortcut-item__initial hidden";
          initial.textContent = getShortcutInitial(shortcut.title);

          icon.append(image, initial);

          const itemLabel = document.createElement("span");
          itemLabel.className = "shortcut-item__label";
          itemLabel.setAttribute("aria-hidden", "true");

          const itemLabelTitle = document.createElement("strong");
          itemLabelTitle.className = "";
          itemLabelTitle.dataset.newTabColorTarget = "itemLabel";
          itemLabelTitle.textContent = shortcut.title;

          const itemLabelText = document.createElement("small");
          itemLabelText.className = "";
          itemLabelText.textContent = getShortcutSubtitle(shortcut);

          itemLabel.append(itemLabelTitle, itemLabelText);

          const tooltip = document.createElement("span");
          tooltip.className = "shortcut-item__tooltip";
          tooltip.role = "tooltip";

          const tooltipTitle = document.createElement("strong");
          tooltipTitle.className = "";
          tooltipTitle.dataset.newTabColorTarget = "itemLabel";
          tooltipTitle.textContent = shortcut.title;

          const tooltipText = document.createElement("small");
          tooltipText.className = "";
          tooltipText.textContent = getShortcutSubtitle(shortcut);

          tooltip.append(tooltipTitle, tooltipText);
          item.append(icon, itemLabel);

          itemShell.append(item, tooltip);
          items.append(itemShell);
        });

        if (!group.shortcuts.length) {
          const empty = document.createElement("button");
          empty.type = "button";
          empty.className = "shortcut-group__empty";
          empty.setAttribute("aria-label", `在${group.title}添加站点`);
          empty.innerHTML = `<span>还没有站点</span>${getIconMarkup("plus")}<span>添加站点</span>`;
          empty.addEventListener("click", () => openShortcutAddForm(group));
          items.append(empty);
        }

        section.append(summary, items);
        groupSections.push(section);
      });

      groupSections.forEach((section) => {
        stack.append(section);
      });

      bindShortcutSortable(stack, groupSections, previousPlacements);

      applyShortcutLayouts(previousPlacements);
      applyTextColors();
    };

    const setStatus = (message) => {
      const status = document.querySelector("[data-config-status]");

      if (status instanceof HTMLElement) {
        status.textContent = message;
      }
    };

    const compressBackgroundImage = (file) =>
      new Promise((resolve) => {
        const reader = new FileReader();

        reader.addEventListener("load", () => {
          if (typeof reader.result !== "string") {
            resolve("");
            return;
          }

          const originalUrl = reader.result;

          if (file.type === "image/svg+xml" || file.type === "image/gif") {
            resolve(originalUrl);
            return;
          }

          const image = new Image();
          image.addEventListener("load", () => {
            const width = image.naturalWidth || 0;
            const height = image.naturalHeight || 0;

            if (!width || !height) {
              resolve(originalUrl);
              return;
            }

            const maxDimension = 1920;
            const scale = Math.max(width, height) > maxDimension
              ? maxDimension / Math.max(width, height)
              : 1;
            const canvas = document.createElement("canvas");
            canvas.width = Math.max(1, Math.round(width * scale));
            canvas.height = Math.max(1, Math.round(height * scale));
            const context = canvas.getContext("2d");

            if (!context) {
              resolve(originalUrl);
              return;
            }

            context.drawImage(image, 0, 0, canvas.width, canvas.height);

            let compressedUrl = "";

            try {
              compressedUrl = canvas.toDataURL("image/webp", 0.8);
            } catch {
              compressedUrl = "";
            }

            resolve(
              compressedUrl && compressedUrl.length < originalUrl.length
                ? compressedUrl
                : originalUrl,
            );
          });
          image.addEventListener("error", () => {
            resolve(originalUrl);
          });
          image.src = originalUrl;
        });

        reader.readAsDataURL(file);
      });

    const syncSettingsControls = () => {
      const nameInput = document.querySelector("[data-config-name]");
      const homeLabelInput = document.querySelector("[data-config-home-label]");
      const homeHrefInput = document.querySelector("[data-config-home-href]");
      const shortcutOpenModeInput = document.querySelector("[data-config-shortcut-open-mode]");
      const backgroundInput = document.querySelector("[data-config-background]");
      const groupColumnsInput = document.querySelector("[data-config-group-columns]");
      const backgroundSourceInput = document.querySelector("[data-config-background-source]");
      const wallpaperShuffleButton = document.querySelector("[data-wallpaper-shuffle]");
      const backgroundOpacityInput = document.querySelector("[data-config-background-opacity]");
      const backgroundOpacityValue = document.querySelector("[data-config-background-opacity-value]");
      const backgroundStatus = document.querySelector("[data-config-background-status]");
      const textColorModeInput = document.querySelector("[data-config-text-color-mode]");
      const pageWidthInput = document.querySelector("[data-config-page-width]");
      const pageWidthValue = document.querySelector("[data-config-page-width-value]");
      const uiScaleInput = document.querySelector("[data-config-ui-scale]");
      const uiScaleValue = document.querySelector("[data-config-ui-scale-value]");
      const fontFamilyInput = document.querySelector("[data-config-font-family]");
      const blurInput = document.querySelector("[data-config-blur]");

      if (nameInput instanceof HTMLInputElement) {
        nameInput.value = newTabState.userName;
      }

      if (homeLabelInput instanceof HTMLInputElement) {
        homeLabelInput.value = newTabState.homeLink.label;
      }

      if (homeHrefInput instanceof HTMLInputElement) {
        homeHrefInput.value = newTabState.homeLink.href;
      }

      if (shortcutOpenModeInput instanceof HTMLSelectElement) {
        shortcutOpenModeInput.value = newTabState.shortcutOpenMode;
      }

      if (groupColumnsInput instanceof HTMLSelectElement) {
        groupColumnsInput.value = String(newTabState.groupColumns);
      }

      if (backgroundSourceInput instanceof HTMLSelectElement) {
        backgroundSourceInput.value = newTabState.backgroundSource;
      }

      if (wallpaperShuffleButton instanceof HTMLButtonElement) {
        wallpaperShuffleButton.disabled = newTabState.backgroundSource !== "bing";
      }

      if (backgroundInput instanceof HTMLInputElement) {
        backgroundInput.value = newTabState.backgroundImage.startsWith("data:")
          ? ""
          : newTabState.backgroundImage;
      }

      if (backgroundOpacityInput instanceof HTMLInputElement) {
        backgroundOpacityInput.value = String(Math.round(newTabState.backgroundOpacity));
      }

      if (backgroundOpacityValue instanceof HTMLElement) {
        backgroundOpacityValue.textContent = `${Math.round(newTabState.backgroundOpacity)}%`;
      }

      if (textColorModeInput instanceof HTMLSelectElement) {
        textColorModeInput.value = newTabState.textColors.mode;
      }

      if (pageWidthInput instanceof HTMLInputElement) {
        pageWidthInput.value = String(newTabState.pageWidth);
      }

      if (pageWidthValue instanceof HTMLElement) {
        const shell = document.querySelector("[data-new-tab-page]");
        const targetWidth = Math.round(newTabState.pageWidth);
        const actualWidth = shell instanceof HTMLElement
          ? Math.round(shell.getBoundingClientRect().width)
          : 0;

        // 窗口比设定值窄时宽度会被 100% 收住，标签同时给出实际值，避免看着 1920 实际只有 1530。
        pageWidthValue.textContent = actualWidth && actualWidth < targetWidth - 1
          ? `${targetWidth}px（窗口 ${actualWidth}px）`
          : `${targetWidth}px`;
      }

      if (uiScaleInput instanceof HTMLInputElement) {
        uiScaleInput.value = String(newTabState.uiScale);
      }

      if (uiScaleValue instanceof HTMLElement) {
        uiScaleValue.textContent = `${Math.round(newTabState.uiScale)}%`;
      }

      if (fontFamilyInput instanceof HTMLSelectElement) {
        fontFamilyInput.value = newTabState.fontFamily;
      }

      if (blurInput instanceof HTMLSelectElement) {
        blurInput.value = newTabState.itemBlur;
      }

      if (backgroundStatus instanceof HTMLElement) {
        backgroundStatus.textContent = newTabState.backgroundImage.startsWith("data:")
          ? (settingsLabels.backgroundUploadedLabel ?? "已上传本地背景")
          : newTabState.backgroundImage
            ? (settingsLabels.backgroundUrlStatusLabel ?? "使用背景 URL")
            : (settingsLabels.backgroundEmptyLabel ?? "未设置背景");
      }

      syncWallpaperControls();
    };

    const persistConfigChange = (message = "已保存") => {
      const saved = writeStoredState();
      renderGreeting();
      renderHomeLink();
      renderSearchEngines();
      renderShortcutGroups();
      applyBackground();
      applyTextColors();
      applyGroupColumns();
      applyPageMetrics();
      applyFontFamily();
      applyItemBlur();
      syncWallpaperControls();
      setStatus(saved ? message : storageQuotaErrorMessage);
    };

    const scheduleTextColorSave = () => {
      window.clearTimeout(textColorSaveTimer);
      applyTextColors();
      textColorSaveTimer = window.setTimeout(() => {
        setStatus(writeStoredState() ? "已保存" : storageQuotaErrorMessage);
      }, 500);
    };

    const wallpaperResolution = 1920;
    const wallpaperCacheName = "ntab-wallpaper-cache";
    const wallpaperCacheStore = "images";
    const wallpaperCacheMaxAge = 7 * 24 * 60 * 60 * 1000;
    let wallpaperCacheDbPromise = null;
    let activeWallpaperObjectUrl = "";
    let activeWallpaperKey = "";
    let wallpaperRequestToken = 0;

    const getWallpaperUrl = () => {
      if (newTabState.backgroundSource === "bing") {
        return `https://bing.biturl.top/?resolution=${wallpaperResolution}&format=image&index=${newTabState.wallpaperIndex}&mkt=zh-CN`;
      }

      return newTabState.backgroundImage;
    };

    const getWallpaperDayKey = () => {
      const now = new Date();

      return `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, "0")}${String(now.getDate()).padStart(2, "0")}`;
    };

    const getWallpaperCacheDb = () => {
      if (wallpaperCacheDbPromise) {
        return wallpaperCacheDbPromise;
      }

      wallpaperCacheDbPromise = new Promise((resolve) => {
        try {
          const request = window.indexedDB.open(wallpaperCacheName, 1);

          request.onupgradeneeded = () => {
            const db = request.result;

            if (!db.objectStoreNames.contains(wallpaperCacheStore)) {
              db.createObjectStore(wallpaperCacheStore);
            }
          };
          request.onsuccess = () => resolve(request.result);
          request.onerror = () => resolve(null);
        } catch {
          resolve(null);
        }
      });

      return wallpaperCacheDbPromise;
    };

    const readWallpaperCache = (db, key) =>
      new Promise((resolve) => {
        try {
          const request = db
            .transaction(wallpaperCacheStore, "readonly")
            .objectStore(wallpaperCacheStore)
            .get(key);

          request.onsuccess = () => resolve(request.result ?? null);
          request.onerror = () => resolve(null);
        } catch {
          resolve(null);
        }
      });

    const writeWallpaperCache = (db, key, entry) =>
      new Promise((resolve) => {
        try {
          const tx = db.transaction(wallpaperCacheStore, "readwrite");

          tx.objectStore(wallpaperCacheStore).put(entry, key);
          tx.oncomplete = () => resolve(true);
          tx.onerror = () => resolve(false);
        } catch {
          resolve(false);
        }
      });

    // 必应每天 8 个 index 都会换图，缓存 key 带日期；超过 7 天的旧图顺手删掉。
    const pruneWallpaperCache = (db) => {
      try {
        const cutoff = Date.now() - wallpaperCacheMaxAge;
        const store = db.transaction(wallpaperCacheStore, "readwrite").objectStore(wallpaperCacheStore);
        const request = store.openCursor();

        request.onsuccess = () => {
          const cursor = request.result;

          if (!cursor) {
            return;
          }

          if (!cursor.value || Number(cursor.value.savedAt) < cutoff) {
            cursor.delete();
          }

          cursor.continue();
        };
      } catch {
        // 清理失败不影响本次使用
      }
    };

    const loadBingWallpaper = async (index) => {
      const cacheKey = `${getWallpaperDayKey()}:${wallpaperResolution}:${index}`;
      const db = await getWallpaperCacheDb();

      if (db) {
        const cached = await readWallpaperCache(db, cacheKey);

        if (cached?.blob instanceof Blob) {
          return URL.createObjectURL(cached.blob);
        }
      }

      const sourceUrl = `https://bing.biturl.top/?resolution=${wallpaperResolution}&format=image&index=${index}&mkt=zh-CN`;
      const response = await fetch(sourceUrl, { mode: "cors", credentials: "omit" });

      if (!response.ok) {
        throw new Error(`wallpaper ${response.status}`);
      }

      const blob = await response.blob();

      if (!blob.type.startsWith("image/")) {
        throw new Error("wallpaper is not an image");
      }

      if (db) {
        await writeWallpaperCache(db, cacheKey, { blob, savedAt: Date.now() });
        pruneWallpaperCache(db);
      }

      return URL.createObjectURL(blob);
    };

    const releaseWallpaperObjectUrl = () => {
      if (activeWallpaperObjectUrl) {
        URL.revokeObjectURL(activeWallpaperObjectUrl);
        activeWallpaperObjectUrl = "";
      }

      activeWallpaperKey = "";
    };

    const applyGroupColumns = () => {
      document.documentElement.style.setProperty("--ntab-group-columns", String(newTabState.groupColumns));
    };

    // 宽度与缩放走 html 上的自定义属性：shell 在页面里，配置抽屉在它外面，
    // 变量挂在根上两边都能读到；首帧由顶部内联脚本先落一次同样的值。
    const applyPageMetrics = () => {
      document.documentElement.style.setProperty(
        "--ntab-page-width",
        `${Math.round(newTabState.pageWidth)}px`,
      );
      document.documentElement.style.setProperty(
        "--ntab-ui-scale",
        String(newTabState.uiScale / 100),
      );
    };

    const applyFontFamily = () => {
      if (newTabState.fontFamily === "default") {
        delete document.documentElement.dataset.newTabFont;
        return;
      }

      document.documentElement.dataset.newTabFont = newTabState.fontFamily;
    };

    // 「动态」模糊：低透明度（壁纸抢眼）配轻模糊，高透明度（壁纸雾化）配强模糊。
    // 其余档位直接用 CSS 变量；动态档把具体值写进变量，同一套规则生效。
    const applyItemBlur = () => {
      const mode = newTabState.itemBlur;
      document.documentElement.dataset.newTabBlur = mode;

      if (mode === "dynamic") {
        const opacity = Math.min(100, Math.max(0, newTabState.backgroundOpacity)) / 100;
        const blur = Math.round(4 + opacity * 12);
        document.documentElement.style.setProperty("--ntab-item-blur", `${blur}px`);
        return;
      }

      if (mode === "off" || mode === "soft" || mode === "medium" || mode === "strong") {
        document.documentElement.style.removeProperty("--ntab-item-blur");
      }
    };

    const paintBackground = (cssUrl) => {
      const backgroundBase = document.querySelector("[data-new-tab-background-base]");
      const backgroundLayer = document.querySelector("[data-new-tab-background-layer]");

      if (!(backgroundBase instanceof HTMLElement) || !(backgroundLayer instanceof HTMLElement)) {
        return;
      }

      if (!cssUrl) {
        backgroundBase.hidden = true;
        backgroundBase.classList.add("hidden");
        backgroundLayer.hidden = true;
        backgroundLayer.classList.add("hidden");
        backgroundLayer.style.removeProperty("background-image");
        backgroundLayer.style.opacity = "0";
        delete document.documentElement.dataset.newTabBackground;
        return;
      }

      const escapedUrl = cssUrl
        .replace(/\\/g, "\\\\")
        .replace(/"/g, '\\"')
        .replace(/\n/g, "");

      backgroundLayer.hidden = false;
      backgroundBase.hidden = false;
      backgroundBase.classList.remove("hidden");
      backgroundLayer.classList.remove("hidden");
      backgroundLayer.style.backgroundImage = `url("${escapedUrl}")`;
      backgroundLayer.style.opacity = String(newTabState.backgroundOpacity / 100);
      document.documentElement.dataset.newTabBackground = "true";
    };

    // 必应壁纸先走 IndexedDB 缓存，命中就直接用 blob URL；没命中才请求并写回。
    // 自定义图片保持同步直挂，不占缓存空间。
    const applyBackground = () => {
      const wallpaperUrl = getWallpaperUrl();

      if (!wallpaperUrl) {
        wallpaperRequestToken += 1;
        releaseWallpaperObjectUrl();
        paintBackground("");
        return;
      }

      if (newTabState.backgroundSource !== "bing") {
        wallpaperRequestToken += 1;
        releaseWallpaperObjectUrl();
        paintBackground(wallpaperUrl);
        return;
      }

      const wallpaperKey = String(newTabState.wallpaperIndex);

      if (activeWallpaperObjectUrl && activeWallpaperKey === wallpaperKey) {
        paintBackground(activeWallpaperObjectUrl);
        return;
      }

      const token = ++wallpaperRequestToken;

      loadBingWallpaper(newTabState.wallpaperIndex)
        .then((objectUrl) => {
          if (token !== wallpaperRequestToken) {
            URL.revokeObjectURL(objectUrl);
            return;
          }

          releaseWallpaperObjectUrl();
          activeWallpaperObjectUrl = objectUrl;
          activeWallpaperKey = wallpaperKey;
          paintBackground(objectUrl);
        })
        .catch(() => {
          if (token !== wallpaperRequestToken) {
            return;
          }

          // 取不到就退回直接挂 URL，浏览器可能还能自己加载出来。
          paintBackground(wallpaperUrl);
        });
    };

    const getResolvedTextColors = () => {
      if (newTabState.textColors.mode === "default") {
        return null;
      }

      const color = newTabState.textColors.mode === "dark" ? "#111827" : "#f8fafc";

      return { navigationColor: color, itemLabelColor: color };
    };

    const applyTextColors = () => {
      const colors = getResolvedTextColors();
      const colorTargets = document.querySelectorAll("[data-new-tab-color-target]");

      // item 卡片深浅跟随颜色模式：浅色文字配黑卡，深色文字配浅卡，默认跟随主题
      const itemTone = colors
        ? (newTabState.textColors.mode === "light" ? "dark" : "light")
        : (document.documentElement.dataset.theme === "black" ? "dark" : "light");
      document.documentElement.dataset.itemTone = itemTone;

      if (!colors) {
        delete document.documentElement.dataset.newTabTextColors;
        colorTargets.forEach((target) => {
          if (target instanceof HTMLElement) {
            target.style.removeProperty("color");
          }
        });
        return;
      }

      document.documentElement.dataset.newTabTextColors = newTabState.textColors.mode;
      colorTargets.forEach((target) => {
        if (!(target instanceof HTMLElement)) {
          return;
        }

        // 工具面板是不透明浮层，文字用面板自己的主题墨色；跟着页面文字色走会变成
        // 浅色文字落在浅色面板上（浅色文字模式下整列配置项看不见）。
        if (target.closest(".new-tab-tools__panel")) {
          target.style.removeProperty("color");
          return;
        }

        target.style.color = colors.navigationColor;
      });
    };

    const syncWallpaperControls = () => {
      document.querySelectorAll("[data-wallpaper-source]").forEach((button) => {
        if (button instanceof HTMLElement) {
          button.setAttribute(
            "aria-checked",
            button.dataset.wallpaperSource === newTabState.backgroundSource ? "true" : "false",
          );
        }
      });

      const shuffleItem = document.querySelector("[data-wallpaper-shuffle-menu]");

      if (shuffleItem instanceof HTMLElement) {
        shuffleItem.hidden = newTabState.backgroundSource !== "bing";
      }

      document.querySelectorAll("[data-wallpaper-custom]").forEach((field) => {
        if (field instanceof HTMLElement) {
          field.classList.toggle("is-collapsed", newTabState.backgroundSource === "bing");
        }
      });
    };

    const renderAll = () => {
      renderSearchEngines();
      renderGreeting();
      renderHomeLink();
      renderShortcutGroups();
      applyBackground();
      applyTextColors();
      applyHeaderState();
      syncLayoutSwitcher();
      applyGroupColumns();
      applyPageMetrics();
      applyFontFamily();
      applyItemBlur();
      syncSettingsControls();
      syncWallpaperControls();
    };

    const getHeaderState = () =>
      newTabState.headerSuspended ? "suspended" : newTabState.headerCollapsed ? "collapsed" : "normal";

    const setHeaderState = (state) => {
      newTabState.headerSuspended = state === "suspended";
      newTabState.headerCollapsed = state === "collapsed";
    };

    const applyHeaderState = () => {
      const page = document.querySelector("[data-new-tab-page]");
      const toggle = document.querySelector("[data-header-collapse]");
      const restore = document.querySelector("[data-header-restore]");
      const state = getHeaderState();

      if (page instanceof HTMLElement) {
        if (state === "normal") {
          delete page.dataset.headerState;
        } else {
          page.dataset.headerState = state;
        }
      }

      if (toggle instanceof HTMLElement) {
        const label = state === "normal"
          ? "收起问候"
          : state === "collapsed"
            ? "挂起：只显示快捷入口"
            : "展开问候与搜索";

        toggle.title = label;
        toggle.setAttribute("aria-label", label);
        toggle.setAttribute("aria-expanded", state === "suspended" ? "false" : "true");
      }

      if (restore instanceof HTMLElement) {
        restore.setAttribute("aria-hidden", state === "suspended" ? "false" : "true");
      }
    };

    // 收起/展开会改变搜索框所在格的列宽（fit-content(28rem) ↔ 22rem），搜索框宽度随之
    // 收放。列宽补间本身是连续的，这里只兜住"位置也动了"的情况（聚焦撑满时搜索框换行），
    // 用 FLIP 把位移补成动画。窄屏没有网格化，两条都为 0，直接跳过。
    const applyHeaderStateWithSearchFlip = () => {
      const search = document.querySelector("[data-new-tab-search]");
      const beforeRect = search instanceof HTMLElement ? search.getBoundingClientRect() : null;
      const beforeState = getHeaderState();

      applyHeaderState();

      if (
        !(search instanceof HTMLElement) ||
        !beforeRect ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        return;
      }

      const afterState = getHeaderState();
      const crossingCollapsed = (beforeState === "collapsed") !== (afterState === "collapsed");

      if (!crossingCollapsed) {
        return;
      }

      const afterRect = search.getBoundingClientRect();
      const dx = beforeRect.left - afterRect.left;
      const dy = beforeRect.top - afterRect.top;

      if (Math.abs(dx) < 1 && Math.abs(dy) < 1) {
        return;
      }

      search.style.transition = "none";
      search.style.transform = `translate(${dx}px, ${dy}px)`;
      search.getBoundingClientRect();
      search.style.transition = "";
      search.style.transform = "";
    };

    const expandHeaderAndFocusSearch = () => {
      setHeaderState("normal");
      writeStoredState();
      applyHeaderStateWithSearchFlip();
      document.querySelector("[data-search-query]")?.focus();
    };

    const syncLayoutSwitcher = () => {
      const label = layoutLabels[newTabState.shortcutLayout] ?? "网格";

      document.querySelectorAll("[data-layout-option]").forEach((button) => {
        if (!(button instanceof HTMLElement)) {
          return;
        }

        // 四选一的单选菜单：状态只放 aria-checked，选中样式由 CSS 跟它走
        button.setAttribute(
          "aria-checked",
          button.dataset.layoutOption === newTabState.shortcutLayout ? "true" : "false",
        );
      });

      document.querySelectorAll("[data-layout-trigger-icon]").forEach((icon) => {
        if (!(icon instanceof HTMLElement)) {
          return;
        }

        icon.classList.toggle("hidden", icon.dataset.layoutTriggerIcon !== newTabState.shortcutLayout);
      });

      const triggerLabel = document.querySelector("[data-layout-trigger-label]");

      if (triggerLabel instanceof HTMLElement) {
        triggerLabel.textContent = `布局：${label}`;
      }

      const trigger = document.querySelector("[data-layout-trigger]");

      if (trigger instanceof HTMLElement) {
        trigger.title = `布局：${label}`;
        trigger.setAttribute("aria-label", `切换布局，当前${label}`);
      }
    };

    // 菜单开关只有一个入口：宿主上的 data-open。打开时把 inert 摘掉并把焦点送进菜单，
    // 关闭时挂回 inert，菜单项立刻退出 Tab 顺序与无障碍树。规则见 APG menu 模式。
    const setLayoutMenuOpen = (open, { focusItem = null, focusTrigger = false, deferInert = false } = {}) => {
      const switcher = document.querySelector("[data-layout-switcher]");
      const trigger = document.querySelector("[data-layout-trigger]");
      const menu = document.querySelector("[data-layout-menu]");

      if (!(switcher instanceof HTMLElement) || !(trigger instanceof HTMLElement) || !(menu instanceof HTMLElement)) {
        return;
      }

      if (open) {
        const items = Array.from(menu.querySelectorAll("[data-layout-option]")).filter(
          (item) => item instanceof HTMLElement,
        );
        const triggerRect = trigger.getBoundingClientRect();
        const menuWidth = menu.offsetWidth || 240;

        // 默认与触发器右缘对齐；右侧放不下（窄屏触发器贴左）就改成从左缘展开
        menu.dataset.align = triggerRect.right - menuWidth < 8 ? "start" : "end";
        switcher.dataset.open = "true";
        trigger.setAttribute("aria-expanded", "true");
        menu.removeAttribute("inert");
        (focusItem ?? items[0])?.focus();
        return;
      }

      delete switcher.dataset.open;
      trigger.setAttribute("aria-expanded", "false");

      if (focusTrigger) {
        trigger.focus();
      }

      // Tab 关闭时先让浏览器把焦点挪到下一个控件，再挂 inert；同步挂会把当前焦点
      // 直接炸回 body，Tab 就从页面开头重新走。
      if (deferInert) {
        window.setTimeout(() => {
          if (switcher.dataset.open !== "true") {
            menu.setAttribute("inert", "");
          }
        }, 0);
        return;
      }

      menu.setAttribute("inert", "");
    };

    const bindLayoutSwitcher = () => {
      const switcher = document.querySelector("[data-layout-switcher]");

      if (!(switcher instanceof HTMLElement) || switcher.dataset.layoutBound === "true") {
        return;
      }

      const trigger = switcher.querySelector("[data-layout-trigger]");
      const menu = switcher.querySelector("[data-layout-menu]");

      if (!(trigger instanceof HTMLElement) || !(menu instanceof HTMLElement)) {
        return;
      }

      const getLayoutItems = () =>
        Array.from(menu.querySelectorAll("[data-layout-option]")).filter((item) => item instanceof HTMLElement);

      trigger.addEventListener("click", () => {
        setLayoutMenuOpen(switcher.dataset.open !== "true");
      });

      trigger.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && switcher.dataset.open === "true") {
          event.preventDefault();
          setLayoutMenuOpen(false);
          return;
        }

        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") {
          return;
        }

        event.preventDefault();

        const items = getLayoutItems();
        setLayoutMenuOpen(true, { focusItem: event.key === "ArrowUp" ? items[items.length - 1] : items[0] });
      });

      menu.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          setLayoutMenuOpen(false, { focusTrigger: true });
          return;
        }

        // Tab 不在菜单里循环：关掉菜单，焦点照常走到下一个工具栏按钮
        if (event.key === "Tab") {
          setLayoutMenuOpen(false, { deferInert: true });
          return;
        }

        if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
          return;
        }

        event.preventDefault();

        const items = getLayoutItems();
        const lastIndex = items.length - 1;
        const currentIndex = items.indexOf(document.activeElement);
        let nextIndex = currentIndex;

        if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = lastIndex;
        } else if (event.key === "ArrowDown") {
          nextIndex = currentIndex >= lastIndex ? 0 : currentIndex + 1;
        } else {
          nextIndex = currentIndex <= 0 ? lastIndex : currentIndex - 1;
        }

        items[nextIndex]?.focus();
      });

      switcher.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-layout-option]") : null;

        if (!(button instanceof HTMLElement)) {
          return;
        }

        const mode = normalizeShortcutLayout(button.dataset.layoutOption);
        const isScatter = mode === "scatter";

        // 每次点「随机」都重掷 seed，包括从其他模式切进来时
        if (isScatter) {
          newTabState.scatterSeed = Math.floor(Math.random() * 1000000000) + 1;
        }

        if (mode === newTabState.shortcutLayout) {
          if (isScatter) {
            writeStoredState();
            renderShortcutGroups();
            setStatus("已重新随机");
          }
          setLayoutMenuOpen(false, { focusTrigger: true });
          return;
        }

        newTabState.shortcutLayout = mode;
        writeStoredState();
        syncLayoutSwitcher();
        renderShortcutGroups();
        setLayoutMenuOpen(false, { focusTrigger: true });
      });

      document.addEventListener("pointerdown", (event) => {
        if (switcher.dataset.open !== "true") {
          return;
        }

        if (event.target instanceof Node && switcher.contains(event.target)) {
          return;
        }

        setLayoutMenuOpen(false);
      });

      switcher.dataset.layoutBound = "true";
    };

    const bindShortcutAdd = () => {
      const trigger = document.querySelector("[data-shortcut-add]");

      if (!(trigger instanceof HTMLElement) || trigger.dataset.addBound === "true") {
        return;
      }

      trigger.addEventListener("click", () => {
        openShortcutAddForm();
      });

      trigger.dataset.addBound = "true";
    };

    const bindGroupAdd = () => {
      const trigger = document.querySelector("[data-group-add]");

      if (!(trigger instanceof HTMLElement) || trigger.dataset.groupAddBound === "true") {
        return;
      }

      trigger.addEventListener("click", () => {
        openGroupDialog({ mode: "create" });
      });

      trigger.dataset.groupAddBound = "true";
    };

    const bindWallpaperMenu = () => {
      const group = document.querySelector("[data-wallpaper-group]");
      const trigger = group?.querySelector("[data-wallpaper-trigger]");
      const menu = group?.querySelector("[data-wallpaper-menu]");

      if (!(group instanceof HTMLElement) || !(trigger instanceof HTMLElement) || !(menu instanceof HTMLElement)) {
        return;
      }

      if (trigger.dataset.wallpaperBound === "true") {
        return;
      }

      const setOpen = (open) => {
        group.toggleAttribute("data-open", open);
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
        menu.hidden = !open;
      };

      trigger.addEventListener("click", () => {
        setOpen(!group.hasAttribute("data-open"));
      });

      group.querySelectorAll("[data-wallpaper-source]").forEach((button) => {
        button.addEventListener("click", () => {
          newTabState.backgroundSource = button.dataset.wallpaperSource === "bing" ? "bing" : "custom";
          persistConfigChange("已保存");
          syncSettingsControls();
          syncWallpaperControls();
          setOpen(false);
        });
      });

      group.querySelector("[data-wallpaper-shuffle-menu]")?.addEventListener("click", () => {
        newTabState.wallpaperIndex = (newTabState.wallpaperIndex + 1) % 8;
        persistConfigChange("已换一张");
        syncSettingsControls();
        syncWallpaperControls();
        syncWallpaperControls();
        setOpen(false);
      });

      trigger.dataset.wallpaperBound = "true";
    };

    const bindHeaderCollapse = () => {
      const toggle = document.querySelector("[data-header-collapse]");

      if (!(toggle instanceof HTMLElement) || toggle.dataset.collapseBound === "true") {
        return;
      }

      toggle.addEventListener("click", () => {
        const state = getHeaderState();

        // 展开 → 收起（搜索并入功能栏）→ 挂起（只剩 item）→ 展开
        setHeaderState(state === "normal" ? "collapsed" : state === "collapsed" ? "suspended" : "normal");
        writeStoredState();
        applyHeaderStateWithSearchFlip();
      });

      toggle.dataset.collapseBound = "true";
    };

    const bindHeaderRestore = () => {
      const restore = document.querySelector("[data-header-restore]");

      if (!(restore instanceof HTMLElement) || restore.dataset.restoreBound === "true") {
        return;
      }

      restore.addEventListener("click", expandHeaderAndFocusSearch);
      restore.dataset.restoreBound = "true";
    };

    const downloadConfig = () => {
      const blob = new Blob([JSON.stringify(newTabState, null, 2)], {
        type: "application/json;charset=utf-8",
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = "new-tab-config.json";
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus("已导出");
    };

    const importConfigFromText = (text) => {
      newTabState = normalizeNewTabState(JSON.parse(text));
      const saved = writeStoredState();
      renderAll();
      setStatus(saved ? "已导入" : storageQuotaErrorMessage);
    };

    const bindSearch = () => {
      const form = document.querySelector("[data-new-tab-search]");
      const input = document.querySelector("[data-search-query]");

      if (
        !(form instanceof HTMLFormElement) ||
        !(input instanceof HTMLInputElement) ||
        form.dataset.searchBound === "true"
      ) {
        return;
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const query = input.value.trim();
        const searchUrl = newTabState.searchEngines.find(
          (engine) => engine.id === newTabState.defaultSearchEngineId,
        )?.searchUrl;

        if (!query) {
          input.focus();
          return;
        }

        if (!searchUrl) {
          return;
        }

        window.location.assign(searchUrl.replace("{query}", encodeURIComponent(query)));
      });

      form.dataset.searchBound = "true";
    };

    // 图标说明抽屉的开合：配置抽屉也要能关它（两个抽屉同时只开一个），
    // 所以 open/close 提到这里共享，绑定只做一次。
    const getNotesPanel = () => {
      const panel = document.querySelector("[data-notes-panel]");

      return panel instanceof HTMLElement ? panel : null;
    };

    // 出场动画结束后补落 hidden：opacity 过渡完只是看不见，hidden 才真正把它
    // 移出可访问性树、也不再占布局。transitionend 只认 opacity（display 那一项
    // 由 allow-discrete 静默收尾，不会派发事件）。
    const hideDrawerAfterExit = (panel) => {
      if (panel.hidden) {
        return;
      }

      const finish = () => {
        if (!panel.dataset.open) {
          panel.hidden = true;
          panel.classList.add("hidden");
        }

        panel.removeEventListener("transitionend", finish);
      };

      panel.addEventListener("transitionend", finish);
    };

    const openNotesPanel = () => {
      const panel = getNotesPanel();

      if (!panel) {
        return;
      }

      closeSettingsPanel();
      // 先摘 hidden 让元素回到过渡起点，强制一帧后再置 data-open 触发滑入
      panel.hidden = false;
      panel.classList.remove("hidden");
      document.querySelector("[data-notes-open]")?.setAttribute("aria-expanded", "true");
      void panel.offsetWidth;
      panel.dataset.open = "true";
    };

    const closeNotesPanel = () => {
      const panel = getNotesPanel();

      if (!panel) {
        return;
      }

      delete panel.dataset.open;
      document.querySelector("[data-notes-open]")?.setAttribute("aria-expanded", "false");
      hideDrawerAfterExit(panel);
    };

    const bindNotes = () => {
      const panel = getNotesPanel();
      const openButton = document.querySelector("[data-notes-open]");
      const command = panel?.querySelector("[data-notes-command]");

      if (!panel || panel.dataset.notesBound === "true") {
        return;
      }

      // 指令写成单行、可整段复制：键名跟着当前配置走，别让人手打
      if (command instanceof HTMLElement) {
        command.textContent = `localStorage.removeItem(${JSON.stringify(logoCacheStorageKey)})`;
      }

      openButton?.addEventListener("click", openNotesPanel);
      panel.querySelectorAll("[data-notes-close]").forEach((button) => {
        button.addEventListener("click", closeNotesPanel);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && panel.dataset.open === "true") {
          closeNotesPanel();
        }
      });

      panel.dataset.notesBound = "true";
    };

    // 配置抽屉的开合同理提到这里：图标说明抽屉开时要能关它
    let settingsReturnFocus = null;

    const closeSettingsPanel = () => {
      const settings = document.querySelector("[data-config-drawer]");

      if (!(settings instanceof HTMLElement)) {
        return;
      }

      delete settings.dataset.open;
      hideDrawerAfterExit(settings);
      document.querySelector("[data-config-open]")?.setAttribute("aria-expanded", "false");

      if (settingsReturnFocus instanceof HTMLElement && settingsReturnFocus.isConnected) {
        settingsReturnFocus.focus();
      }

      settingsReturnFocus = null;
    };

    const bindSettings = () => {
      const settings = document.querySelector("[data-config-drawer]");
      const openButton = document.querySelector("[data-config-open]");

      if (!(settings instanceof HTMLElement) || settings.dataset.settingsBound === "true") {
        return;
      }

      const nameInput = settings.querySelector("[data-config-name]");
      const homeLabelInput = settings.querySelector("[data-config-home-label]");
      const homeHrefInput = settings.querySelector("[data-config-home-href]");
      const shortcutOpenModeInput = settings.querySelector("[data-config-shortcut-open-mode]");
      const searchEngineInput = settings.querySelector("[data-config-search-engine]");
      const backgroundInput = settings.querySelector("[data-config-background]");
      const groupColumnsInput = settings.querySelector("[data-config-group-columns]");
      const backgroundSourceInput = settings.querySelector("[data-config-background-source]");
      const wallpaperShuffleButton = settings.querySelector("[data-wallpaper-shuffle]");
      const backgroundOpacityInput = settings.querySelector("[data-config-background-opacity]");
      const textColorModeInput = settings.querySelector("[data-config-text-color-mode]");
      const pageWidthInput = settings.querySelector("[data-config-page-width]");
      const uiScaleInput = settings.querySelector("[data-config-ui-scale]");
      const fontFamilyInput = settings.querySelector("[data-config-font-family]");
      const blurInput = settings.querySelector("[data-config-blur]");
      const backgroundFileInput = settings.querySelector("[data-config-background-file]");
      const backgroundFileTrigger = settings.querySelector("[data-config-background-file-trigger]");
      const fileInput = settings.querySelector("[data-config-file]");
      const importButton = settings.querySelector("[data-config-import]");
      const exportButton = settings.querySelector("[data-config-export]");
      const clearBackgroundButton = settings.querySelector("[data-config-clear-background]");
      const resetButton = settings.querySelector("[data-config-reset]");

      const openSettings = () => {
        closeNotesPanel();
        settingsReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : openButton;
        openButton?.setAttribute("aria-expanded", "true");
        settings.hidden = false;
        settings.classList.remove("hidden");
        // 先把 translateX(100%) 落成一帧再开，Safari 里单靠 rAF 不会提交起点，滑入会变成瞬移。
        void settings.offsetWidth;
        settings.dataset.open = "true";
        const closeButton = settings.querySelector(".new-tab-config__header [data-config-close]");

        if (closeButton instanceof HTMLElement) {
          closeButton.focus();
        }
      };

      openButton?.addEventListener("click", openSettings);
      settings.querySelectorAll("[data-config-close]").forEach((button) => {
        button.addEventListener("click", closeSettingsPanel);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && settings.dataset.open === "true") {
          closeSettingsPanel();
        }
      });

      // 抽屉是 aria-modal 对话框：Tab 在面板内循环，别让焦点跑到背后的页面上。
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Tab" || settings.dataset.open !== "true") {
          return;
        }

        const sheet = settings.querySelector(".new-tab-config__sheet");

        if (!(sheet instanceof HTMLElement)) {
          return;
        }

        const focusables = Array.from(
          sheet.querySelectorAll(
            'a[href], button:not([disabled]):not([tabindex="-1"]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        ).filter((element) => element instanceof HTMLElement && element.getClientRects().length > 0);

        if (!focusables.length) {
          return;
        }

        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;

        if (!(active instanceof Node) || !sheet.contains(active)) {
          event.preventDefault();
          first.focus();
          return;
        }

        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      });

      nameInput?.addEventListener("input", () => {
        if (!(nameInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.userName = normalizeText(nameInput.value, defaultPayload.config?.userName ?? "Ethanz888");
        persistConfigChange();
      });

      homeLabelInput?.addEventListener("input", () => {
        if (!(homeLabelInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.homeLink.label = normalizeText(homeLabelInput.value, defaultPayload.config?.homeLink?.label ?? "资料卡首页");
        persistConfigChange();
      });

      homeHrefInput?.addEventListener("input", () => {
        if (!(homeHrefInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.homeLink.href = normalizeText(homeHrefInput.value, defaultPayload.config?.homeLink?.href ?? "/");
        persistConfigChange();
      });

      shortcutOpenModeInput?.addEventListener("change", () => {
        if (!(shortcutOpenModeInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.shortcutOpenMode = normalizeShortcutOpenMode(shortcutOpenModeInput.value);
        persistConfigChange();
        syncSettingsControls();
      });

      searchEngineInput?.addEventListener("change", () => {
        if (!(searchEngineInput instanceof HTMLSelectElement)) {
          return;
        }

        if (newTabState.searchEngines.some((engine) => engine.id === searchEngineInput.value)) {
          newTabState.defaultSearchEngineId = searchEngineInput.value;
        }
        persistConfigChange();
        syncSettingsControls();
      });

      groupColumnsInput?.addEventListener("change", () => {
        if (!(groupColumnsInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.groupColumns = [2, 3, 4].includes(Number(groupColumnsInput.value)) ? Number(groupColumnsInput.value) : 3;
        persistConfigChange("已保存");
        syncSettingsControls();
      });

      backgroundSourceInput?.addEventListener("change", () => {
        if (!(backgroundSourceInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.backgroundSource = backgroundSourceInput.value === "bing" ? "bing" : "custom";
        persistConfigChange("已保存");
        syncSettingsControls();
        syncWallpaperControls();
      });

      wallpaperShuffleButton?.addEventListener("click", () => {
        newTabState.wallpaperIndex = (newTabState.wallpaperIndex + 1) % 8;
        persistConfigChange("已换一张");
        syncSettingsControls();
      });

      backgroundInput?.addEventListener("input", () => {
        if (!(backgroundInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.backgroundImage = backgroundInput.value.trim();
        if (newTabState.backgroundImage) {
          newTabState.backgroundSource = "custom";
        }
        persistConfigChange();
      });

      backgroundOpacityInput?.addEventListener("input", () => {
        if (!(backgroundOpacityInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.backgroundOpacity = Math.min(100, Math.max(0, Number(backgroundOpacityInput.value)));
        persistConfigChange();
        syncSettingsControls();
      });

      // 宽度与缩放只改 CSS 变量，不重建快捷区 DOM：拖动时不闪，松手 400ms 后落盘。
      const schedulePageMetricsSave = () => {
        applyPageMetrics();
        syncSettingsControls();
        window.clearTimeout(pageMetricsSaveTimer);
        pageMetricsSaveTimer = window.setTimeout(() => {
          setStatus(writeStoredState() ? "已保存" : storageQuotaErrorMessage);
        }, 400);
      };

      pageWidthInput?.addEventListener("input", () => {
        if (!(pageWidthInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.pageWidth = Math.min(1920, Math.max(896, Number(pageWidthInput.value)));
        schedulePageMetricsSave();
      });

      uiScaleInput?.addEventListener("input", () => {
        if (!(uiScaleInput instanceof HTMLInputElement)) {
          return;
        }

        newTabState.uiScale = Math.min(130, Math.max(85, Number(uiScaleInput.value)));
        schedulePageMetricsSave();
      });

      fontFamilyInput?.addEventListener("change", () => {
        if (!(fontFamilyInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.fontFamily = fontFamilyIds.includes(fontFamilyInput.value)
          ? fontFamilyInput.value
          : "default";
        applyFontFamily();
        setStatus(writeStoredState() ? "已保存" : storageQuotaErrorMessage);
        syncSettingsControls();
      });

      blurInput?.addEventListener("change", () => {
        if (!(blurInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.itemBlur = blurIds.includes(blurInput.value) ? blurInput.value : "medium";
        applyItemBlur();
        setStatus(writeStoredState() ? "已保存" : storageQuotaErrorMessage);
        syncSettingsControls();
      });

      const handleTextColorModeChange = () => {
        if (!(textColorModeInput instanceof HTMLSelectElement)) {
          return;
        }

        newTabState.textColors.mode = ["default", "light", "dark"].includes(textColorModeInput.value)
          ? textColorModeInput.value
          : "default";
        persistConfigChange();
        syncSettingsControls();
      };

      textColorModeInput?.addEventListener("input", handleTextColorModeChange);
      textColorModeInput?.addEventListener("change", handleTextColorModeChange);

      backgroundFileTrigger?.addEventListener("click", () => {
        if (backgroundFileInput instanceof HTMLInputElement) {
          backgroundFileInput.click();
        }
      });

      backgroundFileInput?.addEventListener("change", () => {
        if (!(backgroundFileInput instanceof HTMLInputElement)) {
          return;
        }

        const file = backgroundFileInput.files?.[0];

        if (!file) {
          return;
        }

        compressBackgroundImage(file).then((backgroundImage) => {
          if (!backgroundImage) {
            return;
          }

          newTabState.backgroundImage = backgroundImage;
          newTabState.backgroundSource = "custom";
          const saved = writeStoredState();
          renderAll();
          backgroundFileInput.value = "";
          setStatus(saved ? "背景已保存" : storageQuotaErrorMessage);
        });
      });

      importButton?.addEventListener("click", () => {
        if (fileInput instanceof HTMLInputElement) {
          fileInput.click();
        }
      });

      fileInput?.addEventListener("change", () => {
        if (!(fileInput instanceof HTMLInputElement)) {
          return;
        }

        const file = fileInput.files?.[0];

        if (!file) {
          return;
        }

        const reader = new FileReader();
        reader.addEventListener("load", () => {
          if (typeof reader.result !== "string") {
            return;
          }

          try {
            importConfigFromText(reader.result);
          } catch {
            setStatus("JSON 格式不对");
          }

          fileInput.value = "";
        });
        reader.readAsText(file);
      });

      exportButton?.addEventListener("click", downloadConfig);

      clearBackgroundButton?.addEventListener("click", () => {
        newTabState.backgroundImage = "";
        writeStoredState();
        renderAll();
        setStatus("背景已清除");
      });

      resetButton?.addEventListener("click", () => {
        newTabState = defaultState();

        try {
          window.localStorage.removeItem(storageKey);
        } catch {
          // Ignore storage write failures and keep the reset state in memory.
        }

        renderAll();
        setStatus("已恢复默认");
      });
      settings.dataset.settingsBound = "true";
    };

    let shortcutResizeBound = false;
    let shortcutKeysBound = false;
    let themeToneObserverBound = false;

    const bindToolsMenu = () => {
      const tools = document.querySelector("[data-tools-menu]");

      if (!(tools instanceof HTMLDetailsElement) || tools.dataset.toolsBound === "true") {
        return;
      }

      tools.dataset.toolsBound = "true";

      document.addEventListener("click", (event) => {
        if (!tools.open || !(event.target instanceof Node) || tools.contains(event.target)) {
          return;
        }

        tools.open = false;
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !tools.open) {
          return;
        }

        tools.open = false;
        tools.querySelector("summary")?.focus();
      });

      tools.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;

        if (
          !target ||
          target.closest("[data-layout-trigger]") ||
          target.closest("[data-layout-menu]") ||
          target.closest("[data-wallpaper-trigger]") ||
          target.closest("[data-theme-trigger]")
        ) {
          return;
        }

        if (target.closest("button, a")) {
          tools.open = false;
        }
      });
    };

    const bindNewTab = () => {
      newTabState = readStoredState();
      shortcutLogoCache = readShortcutLogoCache();
      renderAll();
      bindSearch();
      bindSettings();
      bindNotes();
      bindShortcutAdd();
      bindGroupAdd();
      bindLayoutSwitcher();
      bindToolsMenu();
      bindWallpaperMenu();
      bindHeaderCollapse();
      bindHeaderRestore();
      bindShortcutContextMenuDismissal();

      // 首屏布局已落定，放行 padding 补间（之后的收起/挂起切换照常有动画）
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.querySelectorAll("[data-booting]").forEach((el) => el.removeAttribute("data-booting"));
        });
      });

      if (!shortcutResizeBound) {
        window.addEventListener("resize", scheduleShortcutRelayout);
        shortcutResizeBound = true;
      }

      // 默认颜色模式下 item 深浅跟随主题，主题切换时重算
      if (!themeToneObserverBound) {
        new MutationObserver(() => applyTextColors()).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
        themeToneObserverBound = true;
      }

      if (!shortcutKeysBound) {
        // 挂起状态下按 / 唤回搜索
        document.addEventListener("keydown", (event) => {
          if (event.key !== "/" || !newTabState.headerSuspended) {
            return;
          }

          const target = event.target;

          if (
            target instanceof HTMLElement &&
            (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT" || target.isContentEditable)
          ) {
            return;
          }

          event.preventDefault();
          expandHeaderAndFocusSearch();
        });
        shortcutKeysBound = true;
      }
    };

    const clearNewTabBackground = () => {
      const backgroundBase = document.querySelector("[data-new-tab-background-base]");
      const backgroundLayer = document.querySelector("[data-new-tab-background-layer]");

      // 换页时把在途请求作废，避免旧的 blob URL 在新页面上落地。
      wallpaperRequestToken += 1;
      releaseWallpaperObjectUrl();

      delete document.documentElement.dataset.newTabBackground;
      delete document.documentElement.dataset.newTabTextColors;
      delete document.documentElement.dataset.itemTone;
      closeShortcutContextMenu();

      if (backgroundBase instanceof HTMLElement) {
        backgroundBase.hidden = true;
        backgroundBase.classList.add("hidden");
      }

      if (backgroundLayer instanceof HTMLElement) {
        backgroundLayer.hidden = true;
        backgroundLayer.classList.add("hidden");
        backgroundLayer.style.removeProperty("background-image");
        backgroundLayer.style.opacity = "0";
      }
    };

    bindNewTab();
    document.addEventListener("astro:after-swap", bindNewTab);
    document.addEventListener("astro:before-swap", clearNewTabBackground);
  </script>

</BaseLayout>
