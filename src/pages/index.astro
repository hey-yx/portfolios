---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ContributionChart from "../components/ContributionChart.astro";
import TechStackMarquee from "../components/TechStackMarquee.astro";
import { getContentEntryPath } from "../lib/content-routes";
import { withBase } from "../lib/base";
import { type CollectionEntry, getCollection } from "astro:content";

type ProjectEntry = CollectionEntry<"projects">;

const projects = await getCollection("projects");
const homeProjects: ProjectEntry[] = projects
  .filter((project) => project.data.category === "featured")
  .sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf())
  .slice(0, 2);

const getProjectUrl = (project: ProjectEntry): string => {
  if (project.data.detailPage) {
    return getContentEntryPath("projects", project);
  }

  if (project.data.externalUrl) {
    return project.data.externalUrl;
  }

  throw new Error(`Project "${project.id}" is missing externalUrl while detailPage is false.`);
};


---

<BaseLayout
  description="张永鑫的个人作品集，展示 AI 开发、项目交付、成熟模型接入和可持续维护能力。"
  sideBarActiveItemID="home"
>
  <div class="mt-2 pb-12 sm:mt-4 sm:pb-14 lg:mt-6 lg:pb-16">
    <p class="py-1 text-lg sm:text-xl">你好 👋</p>
    <h1 class="type-display">我是 张永鑫</h1>
    <p class="type-lead py-3 text-ink-2">AI 开发工程师</p>
    <div class="mt-8 flex flex-col gap-3 sm:mt-10 sm:flex-row sm:flex-wrap sm:gap-4 lg:mt-12">
      <a class="btn min-h-11 w-full border-base-content bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 sm:w-auto sm:min-w-[12rem]" href={withBase("/contact")}>联系我</a>
      <a href="https://cdn.itcox.cn/baseInfo/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-outline min-h-11 w-full sm:w-auto sm:min-w-[12rem]">查看简历</a>
    </div>
  </div>

  <TechStackMarquee />

  <ContributionChart />

  <section class="mb-16" data-reveal>
    <h2 class="type-heading mb-4">最近在做的 <span aria-hidden="true">{"</>"}</span></h2>
    <div class="w-full min-w-0 max-w-3xl" data-reveal-group="home-projects">
      {
        homeProjects.map((project, index) => (
          <div data-reveal>
            <HorizontalCard
              title={project.data.title}
              imgLight={project.data.heroImageLight ?? project.data.heroImage}
              imgDark={project.data.heroImageDark ?? project.data.heroImage}
              desc={project.data.description}
              url={getProjectUrl(project)}
              target={project.data.detailPage ? "_self" : "_blank"}
            />
            {index < homeProjects.length - 1 && <div class="divider my-0" />}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
