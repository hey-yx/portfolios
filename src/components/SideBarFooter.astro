---
import { Github, ScrollText, Globe } from "lucide-astro";

const socialLinks = [
  { href: "https://space.bilibili.com/483711690?spm_id_from=333.1007.0.0", label: "哔哩哔哩", icon: null },
  { href: "https://github.com/hey-yx", label: "GitHub", icon: Github },
  { href: "https://cdn.itcox.cn/baseInfo/resume.pdf", label: "简历", icon: ScrollText },
  { href: "https://hey-yx.com", label: "官网", icon: Globe },
];
---

<div
  class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
></div>

<div class="sticky bottom-0 bg-base-200 px-4 pb-5 pt-1 text-sm">
  <div class="flex items-center justify-center gap-1">
    {socialLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        title={link.label}
        class:list={["btn btn-ghost btn-sm btn-square rounded-none", { "relative after:absolute after:-top-0.5 after:-right-0.5 after:h-1.5 after:w-1.5 after:rounded-full after:bg-primary": link.label === "简历" }]}
      >
        {link.icon ? (
          <link.icon size={16} />
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.813 4.653h.854q2.266.08 3.773 1.574Q23.946 7.72 24 9.987v7.36q-.054 2.266-1.56 3.773c-1.506 1.507-2.262 1.524-3.773 1.56H5.333q-2.266-.054-3.773-1.56C.053 19.614.036 18.858 0 17.347v-7.36q.054-2.267 1.56-3.76t3.773-1.574h.774l-1.174-1.12a1.23 1.23 0 0 1-.373-.906q0-.534.373-.907l.027-.027q.4-.373.92-.373t.92.373L9.653 4.44q.107.106.187.213h4.267a.8.8 0 0 1 .16-.213l2.853-2.747q.4-.373.92-.373c.347 0 .662.151.929.4s.391.551.391.907q0 .532-.373.906zM5.333 7.24q-1.12.027-1.88.773q-.76.748-.786 1.894v7.52q.026 1.146.786 1.893t1.88.773h13.334q1.12-.026 1.88-.773t.786-1.893v-7.52q-.026-1.147-.786-1.894t-1.88-.773zM8 11.107q.56 0 .933.373q.375.374.4.96v1.173q-.025.586-.4.96q-.373.375-.933.374c-.56-.001-.684-.125-.933-.374q-.375-.373-.4-.96V12.44q0-.56.386-.947q.387-.386.947-.386m8 0q.56 0 .933.373q.375.374.4.96v1.173q-.025.586-.4.96q-.373.375-.933.374c-.56-.001-.684-.125-.933-.374q-.375-.373-.4-.96V12.44q.025-.586.4-.96q.373-.373.933-.373" />
          </svg>
        )}
      </a>
    ))}
  </div>
</div>
