---
import * as si from "simple-icons";

interface TechItem {
  name: string;
  icon: { path: string; fill: string };
}

const iconMap: Record<string, string> = {
  "HTML5": "siHtml5",
  "CSS3": "siCss",
  "JavaScript": "siJavascript",
  "TypeScript": "siTypescript",
  "Vue.js": "siVuedotjs",
  "React": "siReact",
  "NestJS": "siNestjs",
  "Astro": "siAstro",
  "Tailwind CSS": "siTailwindcss",
  "Vite": "siVite",
  "Bun": "siBun",
  "Node.js": "siNodedotjs",
  "PostgreSQL": "siPostgresql",
  "Prisma": "siPrisma",
  "Docker": "siDocker",
  "Git": "siGit",
  "Cloudflare": "siCloudflare",
};

const BLACK = new Set(["000000", "000", "000000ff"]);

const techStack: TechItem[] = Object.entries(iconMap)
  .map(([name, key]) => {
    const icon = (si as Record<string, { path: string; hex: string }>)[key];
    if (!icon) return null;
    const fill = BLACK.has(icon.hex.toLowerCase()) ? "currentColor" : `#${icon.hex}`;
    return { name, icon: { path: icon.path, fill } };
  })
  .filter((item): item is TechItem => item !== null);
---

<section class="mb-14">
  <h2 class="type-heading mb-4">技术栈</h2>
  <div class="tech-marquee">
    <div class="tech-marquee-track">
      {techStack.map((tech) => (
        <span class="tech-marquee-item">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill={tech.icon.fill}
            aria-hidden="true"
          >
            <path d={tech.icon.path} />
          </svg>
          {tech.name}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-marquee {
    padding: 0.375rem 0;
  }

  .tech-marquee-track {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tech-marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--bc, currentColor) 15%, transparent);
    border-radius: 9999px;
    font-size: 0.875rem;
    line-height: 1.25rem;
    white-space: nowrap;
    transition: border-color 0.2s ease;
    user-select: none;
  }

  .tech-marquee-item:hover {
    border-color: color-mix(in srgb, var(--bc, currentColor) 35%, transparent);
  }

  .tech-marquee-item svg {
    flex-shrink: 0;
  }
</style>
